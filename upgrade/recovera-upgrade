class UpgradeError(RuntimeError):
    pass


class NoReleaseError(UpgradeError):
    pass


def run(args, *, check=True, input_bytes=None, capture=False):
    return subprocess.run(
        [str(value) for value in args], check=check, input=input_bytes,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )


def sha256(path):
    digest = hashlib.sha256()
    with Path(path).open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def atomic_json(path, value, mode=0o600):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    temporary.chmod(mode)
    os.replace(temporary, path)


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except FileNotFoundError:
        return {} if default is None else default
    except json.JSONDecodeError as exc:
        raise UpgradeError(f"invalid JSON in {path}: {exc}") from exc


def read_config(path):
    config = {}
    for raw in Path(path).read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise UpgradeError(f"invalid configuration line: {raw}")
        key, value = line.split("=", 1)
        config[key.strip()] = value.strip()
    for required in ("REPOSITORY", "CHANNEL", "CHANNEL_BRANCH", "HOST_ROOT"):
        if not config.get(required):
            raise UpgradeError(f"missing {required} in {path}")
    return config


def local_os():
    """Identify the running OS from os-release (ID, VERSION_ID, VERSION_CODENAME)."""
    path = Path(os.environ.get("RECOVERA_OS_RELEASE", DEFAULT_OS_RELEASE))
    values = {}
    try:
        lines = path.read_text().splitlines()
    except OSError as exc:
        raise UpgradeError(f"cannot identify the operating system from {path}: {exc}") from exc
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return {
        "id": values.get("ID", ""),
        "version_id": values.get("VERSION_ID", ""),
        "codename": values.get("VERSION_CODENAME", ""),
    }


def effective_channel(channel, os_info):
    """Map the administrator's channel (e.g. stable) to this OS release's channel."""
    if (os_info.get("id"), os_info.get("version_id")) == LEGACY_OS:
        return channel
    codename = str(os_info.get("codename", ""))
    if not re.fullmatch(r"[a-z][a-z0-9]{1,15}", codename):
        raise UpgradeError("cannot determine this operating system's release codename")
    prefix = codename + "-"
    return channel if channel.startswith(prefix) else prefix + channel


def check_manifest_os(manifest, os_info=None):
    """Refuse a package release built for a different OS release."""
    os_info = os_info or local_os()
    target = manifest.get("os")
    if target is None:
        # Releases before 0.6.36 carry no OS and were all built for 22.04.
        if (os_info.get("id"), os_info.get("version_id")) == LEGACY_OS:
            return
        raise UpgradeError("package release does not declare its operating system")
    if not isinstance(target, dict) or set(target) != {"id", "version_id"}:
        raise UpgradeError("package release contains an invalid operating system")
    if (str(target["id"]), str(target["version_id"])) != (os_info.get("id"), os_info.get("version_id")):
        raise UpgradeError(
            f"package release is for {target['id']} {target['version_id']}; this appliance runs "
            f"{os_info.get('id') or 'unknown'} {os_info.get('version_id') or 'unknown'}"
        )


def config_path(config, name, default):
    return Path(os.environ.get(name, config.get(name, str(default))))


class UpgradeLock:
    def __init__(self):
        self.stream = None

    def __enter__(self):
        if fcntl is None:
            raise UpgradeError("upgrade locking is unavailable on this operating system")
        path = Path(os.environ.get("RECOVERA_UPGRADE_LOCK", DEFAULT_LOCK))
        path.parent.mkdir(parents=True, exist_ok=True)
        self.stream = path.open("a+")
        try:
            fcntl.flock(self.stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise UpgradeError("another Recovera upgrade operation is already running") from exc
        return self

    def __exit__(self, *_):
        if self.stream:
            self.stream.close()


def credential_file(config, environment_name, config_name, default):
    value = os.environ.get(environment_name)
    token_file = Path(config.get(config_name, default))
    if not value and token_file.exists():
        if token_file.stat().st_mode & 0o077:
            raise UpgradeError(f"credential file must have mode 0600: {token_file}")
        value = token_file.read_text().strip()
    return value


def token(config):
    return (os.environ.get("RECOVERA_GITHUB_TOKEN") or os.environ.get("GH_TOKEN") or
            credential_file(config, "RECOVERA_GITHUB_TOKEN", "TOKEN_FILE",
                            "/etc/recovera/github-token"))


def gateway_token(config):
    return credential_file(
        config, "RECOVERA_GATEWAY_TOKEN", "GATEWAY_TOKEN_FILE",
        "/etc/recovera/gateway-token",
    )


def gateway_origins(config):
    raw = os.environ.get("RECOVERA_UPDATE_ORIGINS", config.get("UPDATE_ORIGINS", ""))
    values = [item.strip().rstrip("/") for item in re.split(r"[,\s]+", raw) if item.strip()]
    origins = []
    for value in values:
        parsed = urllib.parse.urlsplit(value)
        if (parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password
                or parsed.query or parsed.fragment or parsed.path not in ("", "/")):
            raise UpgradeError(f"invalid Recovera update gateway origin: {value}")
        normalized = f"https://{parsed.netloc}"
        if normalized not in origins:
            origins.append(normalized)
    return origins


def credential_for_url(url, config):
    target = urllib.parse.urlsplit(url)
    for origin in gateway_origins(config):
        candidate = urllib.parse.urlsplit(origin)
        if target.scheme == candidate.scheme and target.netloc == candidate.netloc:
            credential = gateway_token(config)
            if not credential:
                raise UpgradeError(
                    "Recovera update gateway requires an appliance credential; place it in "
                    f"{config.get('GATEWAY_TOKEN_FILE', '/etc/recovera/gateway-token')} with mode 0600"
                )
            return credential
    if target.hostname in ("api.github.com", "github.com", "raw.githubusercontent.com"):
        return token(config)
    return None


class SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Never forward a GitHub API bearer token to an asset-storage host."""

    def redirect_request(self, request_value, fp, code, message, headers, new_url):
        redirected = super().redirect_request(request_value, fp, code, message, headers, new_url)
        old_host = urllib.parse.urlsplit(request_value.full_url).hostname
        new_host = urllib.parse.urlsplit(new_url).hostname
        if redirected is not None and old_host != new_host:
            redirected.remove_header("Authorization")
        return redirected


def request(url, config, *, accept="application/vnd.github+json"):
    headers = {
        "Accept": accept,
        "User-Agent": f"recovera-upgrade/{UPDATER_VERSION}",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    credential = credential_for_url(url, config)
    if credential:
        headers["Authorization"] = f"Bearer {credential}"
    try:
        opener = urllib.request.build_opener(SafeRedirectHandler())
        return opener.open(urllib.request.Request(url, headers=headers), timeout=60)
    except urllib.error.HTTPError as exc:
        detail = exc.read(512).decode("utf-8", "replace")
        if exc.code in (401, 404) and not credential:
            token_file = config.get("TOKEN_FILE", "/etc/recovera/github-token")
            raise UpgradeError(
                f"GitHub update channel requires authentication; place a read-only token in "
                f"{token_file} with mode 0600"
            ) from exc
        raise UpgradeError(f"GitHub request failed ({exc.code}): {detail}") from exc
    except urllib.error.URLError as exc:
        raise UpgradeError(f"GitHub is unreachable: {exc.reason}") from exc


def github_json(path, config):
    with request("https://api.github.com" + path, config) as response:
        return json.load(response)


def use_github_api(config):
    return bool(token(config)) or config.get("USE_GITHUB_API", "no").lower() in ("1", "yes", "true")


def validated_repository(config):
    repository = config["REPOSITORY"]
    if not re.fullmatch(r"[0-9A-Za-z_.-]+/[0-9A-Za-z_.-]+", repository):
        raise UpgradeError("invalid GitHub repository in upgrade configuration")
    return repository


def download(url, target, config, *, api_asset=False):
    accept = "application/octet-stream" if api_asset else "application/vnd.github+json"
    target = Path(target)
    temporary = target.with_name(target.name + ".partial")
    with request(url, config, accept=accept) as response, temporary.open("wb") as output:
        shutil.copyfileobj(response, output, 1024 * 1024)
    os.replace(temporary, target)


def fetch_channel(config, local_channel=None):
    if local_channel:
        pointer = read_json(local_channel)
    else:
        origins = gateway_origins(config)
        if origins:
            channel_name = urllib.parse.quote(config["CHANNEL"], safe="")
            failures = []
            for origin in origins:
                url = f"{origin}/v1/channels/{channel_name}.json"
                try:
                    with request(url, config, accept="application/json") as response:
                        pointer = json.load(response)
                    config["_ACTIVE_GATEWAY_ORIGIN"] = origin
                    break
                except (UpgradeError, ValueError, json.JSONDecodeError) as exc:
                    failures.append(f"{origin}: {exc}")
            else:
                raise UpgradeError("all Recovera update gateways failed: " + "; ".join(failures))
        else:
            pointer = None
        repo = validated_repository(config)
        channel = config["CHANNEL"]
        branch = config["CHANNEL_BRANCH"]
        if pointer is not None:
            pass
        elif use_github_api(config):
            path = f"/repos/{repo}/contents/upgrade/channels/{channel}.json?ref={branch}"
            result = github_json(path, config)
            try:
                pointer = json.loads(base64.b64decode(result["content"]))
            except (KeyError, ValueError, json.JSONDecodeError) as exc:
                raise UpgradeError("invalid GitHub channel response") from exc
        else:
            branch_path = urllib.parse.quote(branch, safe="/")
            channel_name = urllib.parse.quote(channel, safe="")
            url = (config.get("CHANNEL_URL") or
                   f"https://raw.githubusercontent.com/{repo}/{branch_path}/upgrade/channels/{channel_name}.json")
            try:
                with request(url, config, accept="application/json") as response:
                    pointer = json.load(response)
            except (ValueError, json.JSONDecodeError) as exc:
                raise UpgradeError("invalid GitHub channel response") from exc
    if pointer.get("schema") != 1 or pointer.get("channel") != config["CHANNEL"]:
        raise UpgradeError("channel pointer has an unsupported schema or channel")
    if not pointer.get("release_tag"):
        raise NoReleaseError(f"the {config['CHANNEL']} channel has no published release")
    if not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._-]{0,127}", str(pointer["release_tag"])):
        raise UpgradeError("channel pointer contains an invalid release tag")
    return pointer


def release_assets(pointer, config, source_dir=None):
    if source_dir:
        root = Path(source_dir)
        return {item.name: item for item in root.iterdir() if item.is_file()}
    repo = validated_repository(config)
    tag = pointer["release_tag"]
    tag_path = urllib.parse.quote(tag, safe="")
    origins = gateway_origins(config)
    if origins:
        active = config.get("_ACTIVE_GATEWAY_ORIGIN")
        ordered = ([active] if active in origins else []) + [item for item in origins if item != active]
        return {"__release_base_urls__": [
            f"{origin}/v1/releases/{tag_path}" for origin in ordered
        ]}
    if use_github_api(config):
        release = github_json(f"/repos/{repo}/releases/tags/{tag_path}", config)
        return {asset["name"]: asset["url"] for asset in release.get("assets", [])}
    return {"__release_base_url__": f"https://github.com/{repo}/releases/download/{tag_path}"}


def obtain_asset(name, assets, target, config):
    if name in assets:
        source = assets[name]
    elif "__release_base_urls__" in assets and safe_asset_name(name):
        source = [base + "/" + urllib.parse.quote(name, safe="")
                  for base in assets["__release_base_urls__"]]
    elif "__release_base_url__" in assets and safe_asset_name(name):
        source = assets["__release_base_url__"] + "/" + urllib.parse.quote(name, safe="")
    else:
        raise UpgradeError(f"release asset is missing: {name}")
    if isinstance(source, Path):
        shutil.copyfile(source, target)
    elif isinstance(source, list):
        failures = []
        for candidate in source:
            try:
                download(candidate, target, config, api_asset=True)
                return
            except UpgradeError as exc:
                failures.append(f"{urllib.parse.urlsplit(candidate).netloc}: {exc}")
        raise UpgradeError("all Recovera update gateways failed while downloading "
                           f"{name}: " + "; ".join(failures))
    else:
        download(source, target, config, api_asset=True)


def verify_signature(manifest_path, signature_path, signers):
    command = [
        "ssh-keygen", "-Y", "verify", "-f", str(signers),
        "-I", "recovera-release", "-n", "recovera-upgrade",
        "-s", str(signature_path),
    ]
    result = run(command, check=False, input_bytes=Path(manifest_path).read_bytes(), capture=True)
    if result.returncode:
        raise UpgradeError("release manifest signature verification failed")


def validate_release_identity(manifest, pointer, config):
    required = ("schema", "sequence", "version", "channel", "architecture")
    if any(key not in manifest for key in required) or manifest["schema"] not in (1, 2):
        raise UpgradeError("unsupported or incomplete release manifest")
    if manifest["channel"] != config["CHANNEL"]:
        raise UpgradeError("release manifest channel does not match appliance channel")
    if not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._-]{0,63}", str(manifest["version"])):
        raise UpgradeError("release manifest contains an invalid version")
    try:
        sequence = int(manifest["sequence"])
    except (TypeError, ValueError) as exc:
        raise UpgradeError("release manifest contains an invalid sequence") from exc
    if sequence < 1:
        raise UpgradeError("release sequence must be positive")
    if manifest["architecture"] != platform.machine() and not (
        manifest["architecture"] == "amd64" and platform.machine() == "x86_64"
    ):
        raise UpgradeError("release image architecture does not match this appliance")
    if int(manifest.get("minimum_updater", 1)) > UPDATER_VERSION:
        raise UpgradeError("this release requires a newer Recovera updater")
    try:
        pointer_sequence = int(pointer.get("sequence", -1))
    except (TypeError, ValueError) as exc:
        raise UpgradeError("channel pointer contains an invalid sequence") from exc
    if pointer.get("version") != manifest["version"] or pointer_sequence != sequence:
        raise UpgradeError("signed manifest does not match the channel pointer")
    return sequence


def validate_image_manifest(manifest):
    if manifest.get("schema") != 1 or "image" not in manifest:
        raise UpgradeError("unsupported or incomplete image manifest")
    image = manifest["image"]
    if image.get("compression") != "xz" or not image.get("parts"):
        raise UpgradeError("unsupported image encoding")
    for part in image["parts"]:
        if set(part) != {"name", "size", "sha256"} or Path(part["name"]).name != part["name"]:
            raise UpgradeError("invalid image part metadata")
        if int(part["size"]) < 1 or not re.fullmatch(r"[0-9a-f]{64}", str(part["sha256"])):
            raise UpgradeError("invalid image part size or digest")
    for field in ("sha256", "uncompressed_sha256"):
        if not re.fullmatch(r"[0-9a-f]{64}", str(image.get(field, ""))):
            raise UpgradeError(f"invalid image {field}")
    if int(image.get("size", 0)) < 1 or int(image.get("uncompressed_size", 0)) < 1:
        raise UpgradeError("invalid image size")
    target = manifest.get("os")
    if target is not None and (not isinstance(target, dict) or set(target) != {"id", "version_id"}):
        raise UpgradeError("image release contains an invalid operating system")
    origin = manifest.get("from")
    if origin is not None:
        if not isinstance(origin, dict) or set(origin) - {"os_version_ids", "minimum_version"}:
            raise UpgradeError("image release contains invalid starting requirements")
        versions = origin.get("os_version_ids")
        if not isinstance(versions, list) or not versions or not all(
                isinstance(item, str) and re.fullmatch(r"[0-9.]{2,16}", item) for item in versions):
            raise UpgradeError("image release contains invalid starting OS releases")
        minimum = origin.get("minimum_version")
        if minimum is not None and not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z.+:~_-]{0,63}", str(minimum)):
            raise UpgradeError("image release contains an invalid minimum version")


def version_at_least(installed, minimum):
    """Debian version comparison (installed >= minimum)."""
    if installed is None:
        return False
    result = run(["dpkg", "--compare-versions", str(installed), "ge", str(minimum)], check=False)
    return result.returncode == 0


def replication_drained():
    """(ok, detail): replication is held for maintenance and nothing is running."""
    if not PEER_COMMAND.exists():
        return True, "replication is not installed"
    result = run([PEER_COMMAND, "maintenance", "status"], check=False, capture=True)
    try:
        status = json.loads(result.stdout.decode("utf-8", "replace"))
    except json.JSONDecodeError:
        return False, "could not read the replication maintenance status"
    if not status.get("maintenance"):
        return False, ("replication is not paused; run `sudo recovera-peer maintenance on "
                       "--reason \"OS transition\" --wait 21600` first")
    if status.get("busy"):
        return False, "replication is still running: " + "; ".join(map(str, status["busy"]))
    return True, "replication is paused and idle"


def pool_health(pool="homePool"):
    result = run(["zpool", "list", "-H", "-o", "health", pool], check=False, capture=True)
    if result.returncode:
        return None
    return result.stdout.decode("utf-8", "replace").strip()


def active_restores():
    """Virtual machines or iSCSI targets that a restore may be using."""
    found = []
    if shutil.which("virsh"):
        result = run(["virsh", "list", "--all", "--name"], check=False, capture=True)
        found += [f"virtual machine {name}" for name in
                  result.stdout.decode("utf-8", "replace").split() if name]
    targets = Path("/sys/kernel/config/target/iscsi")
    if targets.is_dir():
        found += [f"iSCSI target {item.name}" for item in targets.iterdir() if item.name.startswith("iqn.")]
    return found


def transition_preflight(manifest, host, args):
    """Refuse an operating-system transition unless the appliance is ready for it."""
    origin = manifest.get("from")
    os_info = local_os()
    if origin is None:
        target = manifest.get("os")
        if target and (target["id"], target["version_id"]) != (os_info.get("id"), os_info.get("version_id")):
            raise UpgradeError(
                f"this image runs {target['id']} {target['version_id']}; moving this appliance "
                "to another OS release needs a transition release"
            )
        return
    if os_info.get("version_id") not in origin["os_version_ids"]:
        raise UpgradeError(
            f"this transition starts from Ubuntu {', '.join(origin['os_version_ids'])}; "
            f"this appliance runs {os_info.get('version_id') or 'an unknown release'}"
        )
    minimum = origin.get("minimum_version")
    if minimum and not version_at_least(installed_version("recovera-appliance"), minimum):
        raise UpgradeError(f"install Recovera {minimum} or newer before this transition")
    problems = []
    health = pool_health()
    if health != "ONLINE":
        problems.append(f"homePool is {health or 'not imported'}, not ONLINE")
    drained, detail = replication_drained()
    if not drained and not getattr(args, "allow_busy", False):
        problems.append(detail)
    restores = active_restores()
    if restores and not getattr(args, "allow_busy", False):
        problems.append("restores are active: " + ", ".join(restores))
    image = manifest["image"]
    needed = int(image["size"]) + int(image["uncompressed_size"]) + 1024 * 1024 * 1024
    free = shutil.disk_usage(host).free
    if free < needed:
        problems.append(f"the image host needs {needed // 2**20} MiB free and has {free // 2**20} MiB")
    if problems:
        raise UpgradeError("the appliance is not ready for this transition:\n- " + "\n- ".join(problems))


def safe_asset_name(name):
    return (
        isinstance(name, str)
        and Path(name).name == name
        and re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z.+_~-]{0,191}", name)
    )


def validate_package_manifest(manifest):
    if manifest.get("schema") != 2 or manifest.get("type") != "package":
        raise UpgradeError("unsupported or incomplete package manifest")
    packages = manifest.get("packages")
    if not isinstance(packages, list) or not packages:
        raise UpgradeError("package release contains no packages")
    seen_names = set()
    seen_files = set()
    total = 0
    for package in packages:
        if not isinstance(package, dict):
            raise UpgradeError("invalid package metadata")
        if set(package) != {"name", "version", "architecture", "asset", "size", "sha256"}:
            raise UpgradeError("invalid package metadata")
        name = str(package["name"])
        architecture = str(package["architecture"])
        if not re.fullmatch(r"[a-z0-9][a-z0-9+.-]{0,127}", name) or FORBIDDEN_PACKAGE_RE.match(name):
            raise UpgradeError(f"package is not eligible for an application update: {name}")
        if name in seen_names or package["asset"] in seen_files:
            raise UpgradeError("package release contains duplicate packages or assets")
        if not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z.+:~_-]{0,127}", str(package["version"])):
            raise UpgradeError("invalid package version")
        if architecture not in ("all", "amd64") or not safe_asset_name(package["asset"]):
            raise UpgradeError("invalid package architecture or asset name")
        if int(package["size"]) < 1 or not re.fullmatch(r"[0-9a-f]{64}", str(package["sha256"])):
            raise UpgradeError("invalid package size or digest")
        seen_names.add(name)
        seen_files.add(package["asset"])
        total += int(package["size"])
    if int(manifest.get("download_size", -1)) != total:
        raise UpgradeError("package release download size does not match its assets")
    if not isinstance(manifest.get("reboot_required", False), bool):
        raise UpgradeError("invalid reboot requirement")


def validate_manifest(manifest, pointer, config):
    validate_release_identity(manifest, pointer, config)
    release_type = manifest.get("type", "image" if manifest.get("schema") == 1 else None)
    if release_type == "image":
        validate_image_manifest(manifest)
    elif release_type == "package":
        validate_package_manifest(manifest)
        check_manifest_os(manifest)
    else:
        raise UpgradeError("unknown release type")
    return manifest


def current_release():
    image = read_json(os.environ.get("RECOVERA_RELEASE_FILE", DEFAULT_RELEASE), {})
    installed = read_json(state_path(), {}).get("installed", {})
    try:
        return installed if int(installed.get("sequence", 0)) > int(image.get("sequence", 0)) else image
    except (TypeError, ValueError):
        raise UpgradeError("installed release state contains an invalid sequence")


def status_state(current):
    """Return updater state without advertising an already-installed release."""
    state = read_json(state_path(), {})
    cached = state.get("available")
    if not isinstance(cached, dict) or not cached.get("available"):
        return state
    try:
        installed_sequence = max(
            int(current.get("sequence", 0)), int(state.get("installed_sequence", 0))
        )
        cached_sequence = int(cached.get("sequence", 0))
    except (TypeError, ValueError):
        return state
    if (cached_sequence <= installed_sequence
            or cached.get("version") == current.get("version")):
        state = dict(state)
        state["available"] = dict(cached, available=False,
                                  current_version=current.get("version"))
    return state


def state_path():
    return Path(os.environ.get("RECOVERA_UPGRADE_STATE", DEFAULT_STATE))


def layout_path():
    return Path(os.environ.get("RECOVERA_IMAGE_LAYOUT", DEFAULT_LAYOUT))


def get_release(config, args, directory):
    pointer = fetch_channel(config, args.channel_file)
    assets = release_assets(pointer, config, args.source_dir)
    manifest_name = pointer.get("manifest_asset") or "recovera-image-manifest.json"
    signature_name = pointer.get("signature_asset") or manifest_name + ".sig"
    for name in (manifest_name, signature_name):
        if Path(name).name != name or not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._-]{0,127}", name):
            raise UpgradeError("channel pointer contains an invalid asset name")
    manifest_path = directory / manifest_name
    signature_path = directory / signature_name
    obtain_asset(manifest_name, assets, manifest_path, config)
    obtain_asset(signature_name, assets, signature_path, config)
    verify_signature(manifest_path, signature_path, args.signers)
    manifest = validate_manifest(read_json(manifest_path), pointer, config)
    return pointer, assets, manifest, manifest_path, signature_path


def ensure_newer(manifest):
    current = current_release()
    state = read_json(state_path(), {})
    installed_sequence = max(int(current.get("sequence", 0)), int(state.get("installed_sequence", 0)))
    if int(manifest["sequence"]) < installed_sequence:
        raise UpgradeError("refusing a signed release older than the installed sequence")
    if int(manifest["sequence"]) == installed_sequence or current.get("version") == manifest["version"]:
        raise UpgradeError("this release is already installed")


def command_check(config, args):
    current = current_release()
    try:
        with tempfile.TemporaryDirectory(prefix="recovera-upgrade-check-") as temporary:
            _, _, manifest, _, _ = get_release(config, args, Path(temporary))
    except NoReleaseError:
        result = {
            "available": False,
            "channel": config["CHANNEL"],
            "current_version": current.get("version"),
            "version": None,
            "sequence": None,
        }
        if args.cache:
            cached = read_json(state_path(), {})
            cached["available"] = result
            atomic_json(state_path(), cached)
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    available = int(manifest["sequence"]) > int(current.get("sequence", 0))
    release_type = manifest.get("type", "image")
    if release_type == "package":
        required_download = sum(
            int(package["size"]) for package in manifest["packages"]
            if installed_version(package["name"]) != package["version"]
        )
    else:
        required_download = int(manifest.get("image", {}).get("size", 0))
    result = {
        "available": available,
        "channel": manifest["channel"],
        "current_version": current.get("version"),
        "version": manifest["version"],
        "sequence": manifest["sequence"],
        "type": release_type,
        "download_size": required_download,
        "repository_size": int(manifest.get("download_size", required_download)),
        "reboot_required": bool(manifest.get("reboot_required", True)),
    }
    if args.cache:
        cached = read_json(state_path(), {})
        cached["available"] = result
        atomic_json(state_path(), cached)
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if available else 3


def require_root():
    if os.geteuid() != 0:
        raise UpgradeError("this command must run as root")


def require_layout(config):
    layout = read_json(layout_path(), {})
    if layout.get("schema") != 1 or layout.get("mode") != "loop-image-v1":
        raise UpgradeError(
            "this appliance has not been prepared for Recovera image boot; "
            "activation is intentionally disabled until the final OVA provides that layout"
        )
    host = Path(config["HOST_ROOT"])
    if not host.is_mount():
        raise UpgradeError(f"image host filesystem is not mounted: {host}")
    if not BOOT_HELPER.is_file():
        raise UpgradeError("Recovera image boot helper is missing")
    return layout


def assemble_image(config, manifest, assets, work):
    image = manifest["image"]
    compressed = work / "recovera-image.img.xz"
    with compressed.open("wb") as combined:
        for part in image["parts"]:
            local = work / part["name"]
            obtain_asset(part["name"], assets, local, config)
            if local.stat().st_size != int(part["size"]) or sha256(local) != part["sha256"]:
                raise UpgradeError(f"image part verification failed: {part['name']}")
            with local.open("rb") as source:
                shutil.copyfileobj(source, combined, 1024 * 1024)
            # The combined stream is independently verified below. Reclaim each
            # split part immediately so a 40 GB image host can hold the current
            # image, compressed candidate, and uncompressed candidate together.
            local.unlink()
    if compressed.stat().st_size != int(image["size"]) or sha256(compressed) != image["sha256"]:
        raise UpgradeError("combined compressed image verification failed")
    return compressed


def inspect_image(image_path, manifest):
    if Path(image_path).stat().st_size != int(manifest["image"]["uncompressed_size"]):
        raise UpgradeError("uncompressed image size does not match manifest")
    if sha256(image_path) != manifest["image"]["uncompressed_sha256"]:
        raise UpgradeError("uncompressed image digest does not match manifest")
    result = run(["e2fsck", "-fn", str(image_path)], check=False)
    if result.returncode != 0:
        raise UpgradeError(f"image filesystem check failed with status {result.returncode}")
    with tempfile.TemporaryDirectory(prefix="recovera-image-mount-") as mount:
        run(["mount", "-o", "loop,ro", str(image_path), mount])
        try:
            embedded = read_json(Path(mount) / "etc/recovera-image-release")
            if embedded.get("version") != manifest["version"] or int(embedded.get("sequence", -1)) != int(manifest["sequence"]):
                raise UpgradeError("release identity inside the image does not match its manifest")
            for required in ("boot/vmlinuz", "boot/initrd.img", "usr/local/sbin/recovera-upgrade"):
                if not (Path(mount) / required).exists():
                    raise UpgradeError(f"image is missing required file: /{required}")
        finally:
            run(["umount", mount], check=False)


def migrate_appliance_config(image_path):
    if not MIGRATION_HELPER.is_file():
        raise UpgradeError("Recovera configuration migration helper is missing")
    with tempfile.TemporaryDirectory(prefix="recovera-image-config-") as mount:
        run(["mount", "-o", "loop,rw", str(image_path), mount])
        try:
            run([MIGRATION_HELPER, mount])
        finally:
            run(["umount", mount], check=False)
    if run(["e2fsck", "-fn", str(image_path)], check=False).returncode != 0:
        raise UpgradeError("candidate filesystem is inconsistent after configuration migration")


def command_install_image(config, args, release):
    require_root()
    require_layout(config)
    pointer, assets, manifest, manifest_path, signature_path = release
    host = Path(config["HOST_ROOT"])
    transition_preflight(manifest, host, args)
    images = host / "recovera/images"
    downloads = host / "recovera/downloads"
    images.mkdir(parents=True, exist_ok=True)
    downloads.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="release-", dir=downloads) as temporary:
        work = Path(temporary)
        compressed = assemble_image(config, manifest, assets, work)
        filename = f"{manifest['version']}.img"
        target = images / filename
        pending = images / (filename + ".pending")
        with pending.open("wb") as output:
            process = subprocess.Popen(["xz", "-d", "-c", str(compressed)], stdout=output)
            if process.wait() != 0:
                raise UpgradeError("xz image decompression failed")
        inspect_image(pending, manifest)
        migrate_appliance_config(pending)
        os.replace(pending, target)
        shutil.copyfile(manifest_path, images / f"{manifest['version']}.manifest.json")
        shutil.copyfile(signature_path, images / f"{manifest['version']}.manifest.sig")
        current = current_release()
        state = read_json(state_path(), {})
        state.update({
            "pending": {"version": manifest["version"], "sequence": manifest["sequence"], "image": str(target)},
            "previous": current,
            "release_tag": pointer["release_tag"],
        })
        atomic_json(state_path(), state)
        PENDING_MARKER.touch(mode=0o600, exist_ok=True)
        try:
            run([BOOT_HELPER, "stage", manifest["version"], target])
        except subprocess.SubprocessError:
            PENDING_MARKER.unlink(missing_ok=True)
            state["pending"] = None
            atomic_json(state_path(), state)
            raise
    print(f"Recovera {manifest['version']} is verified and staged for one-time boot.")
    if args.reboot:
        run(["systemctl", "reboot"])
    else:
        print("Reboot when ready: sudo systemctl reboot")


def dpkg_field(path, field):
    result = run(["dpkg-deb", "-f", path, field], capture=True)
    return result.stdout.decode("utf-8", "replace").strip()


def installed_version(package):
    result = run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}\t${Version}", package], check=False, capture=True)
    if result.returncode:
        return None
    status, _, version = result.stdout.decode("utf-8", "replace").partition("\t")
    return version if status.startswith("ii") else None


def verify_deb(path, package):
    path = Path(path)
    if path.stat().st_size != int(package["size"]) or sha256(path) != package["sha256"]:
        raise UpgradeError(f"package verification failed: {package['asset']}")
    values = {field: dpkg_field(path, field) for field in ("Package", "Version", "Architecture")}
    for field, key in (("Package", "name"), ("Version", "version"), ("Architecture", "architecture")):
        if values[field] != str(package[key]):
            raise UpgradeError(f"package control metadata does not match manifest: {package['asset']}")


def find_cached_deb(config, name, version):
    roots = [
        config_path(config, "PACKAGE_CACHE", DEFAULT_PACKAGE_CACHE),
        Path("/opt/recovera/debs"),
        Path("/var/cache/apt/archives"),
    ]
    for root in roots:
        if not root.is_dir():
            continue
        for candidate in root.glob(f"{name}_*.deb"):
            try:
                if dpkg_field(candidate, "Package") == name and dpkg_field(candidate, "Version") == version:
                    return candidate
            except (OSError, subprocess.SubprocessError):
                continue
    return None


def package_apt_command(action, debs):
    return [
        "apt-get", "-y" if action == "install" else "-s",
        "--allow-downgrades", "--allow-change-held-packages",
        "-o", "Dir::Etc::sourcelist=/dev/null",
        "-o", "Dir::Etc::sourceparts=/dev/null",
        "-o", "APT::Get::List-Cleanup=0",
        "-o", "DPkg::Lock::Timeout=900",
        "install", *[str(Path(item).resolve()) for item in debs],
    ]


def verify_package_plan(debs):
    result = run(package_apt_command("simulate", debs), check=False, capture=True)
    output = (result.stdout + result.stderr).decode("utf-8", "replace")
    if result.returncode:
        raise UpgradeError("package dependency preflight failed:\n" + output[-4000:])
    removals = re.findall(r"^Remv\s+(\S+)", output, re.MULTILINE)
    if removals:
        raise UpgradeError("package release would remove installed packages: " + " ".join(removals))
    allowed = {dpkg_field(item, "Package") for item in debs}
    additions = {name.split(":", 1)[0] for name in re.findall(r"^Inst\s+(\S+)", output, re.MULTILINE)}
    unexpected = sorted(additions - allowed)
    if unexpected:
        raise UpgradeError("package plan contains unsigned or unlisted packages: " + " ".join(unexpected))


def installed_php_fpm_services():
    """Installed phpX.Y-fpm units, newest PHP first."""
    result = run(["systemctl", "list-unit-files", "--no-legend", "--plain", "php*-fpm.service"],
                 check=False, capture=True)
    found = re.findall(r"^(php([0-9]+)\.([0-9]+)-fpm\.service)\s",
                       result.stdout.decode("utf-8", "replace"), re.MULTILINE)
    found.sort(key=lambda item: (int(item[1]), int(item[2])), reverse=True)
    return [name for name, _, _ in found]


def required_services(config):
    """REQUIRED_SERVICES with PHP-FPM resolved to the installed version.

    "php-fpm.service" (or a phpX.Y-fpm unit that is no longer installed after
    an OS release upgrade) means whichever PHP-FPM unit this appliance has.
    """
    services = []
    php_units = None
    for name in config.get("REQUIRED_SERVICES", "").split():
        if PHP_FPM_SERVICE_RE.fullmatch(name):
            if php_units is None:
                php_units = installed_php_fpm_services()
            unit = name if name.endswith(".service") else name + ".service"
            if unit not in php_units and php_units:
                name = php_units[0]
        if name not in services:
            services.append(name)
    return services


def validate_services(config):
    run(["systemctl", "daemon-reload"])
    for service in required_services(config):
        if run(["systemctl", "is-active", "--quiet", service], check=False).returncode:
            raise UpgradeError(f"required service is not active: {service}")
    if shutil.which("apache2ctl") and run(["apache2ctl", "configtest"], check=False, capture=True).returncode:
        raise UpgradeError("Apache configuration validation failed")


def rollback_package_transaction(config, transaction):
    rollback_debs = [entry["path"] for entry in transaction.get("rollback", []) if entry.get("path")]
    if rollback_debs:
        result = run(package_apt_command("install", rollback_debs), check=False, capture=True)
        if result.returncode:
            detail = (result.stdout + result.stderr).decode("utf-8", "replace")[-4000:]
            raise UpgradeError("automatic package rollback failed:\n" + detail)
    new_packages = list(reversed(transaction.get("new_packages", [])))
    if new_packages:
        result = run(["dpkg", "--purge", *new_packages], check=False, capture=True)
        if result.returncode:
            detail = (result.stdout + result.stderr).decode("utf-8", "replace")[-4000:]
            raise UpgradeError("automatic removal of newly introduced packages failed:\n" + detail)
    run(["systemctl", "daemon-reload"], check=False)
    for service in required_services(config):
        run(["systemctl", "restart", service], check=False)


def commit_package_transaction(config, state):
    pending = state["pending"]
    cache = config_path(config, "PACKAGE_CACHE", DEFAULT_PACKAGE_CACHE)
    cache.mkdir(parents=True, exist_ok=True)
    for source in pending.get("packages", []):
        source_path = Path(source)
        shutil.copyfile(source_path, cache / source_path.name)
    installed = {
        "schema": 1, "type": "package", "version": pending["version"],
        "sequence": int(pending["sequence"]), "channel": config["CHANNEL"],
    }
    state["installed_sequence"] = int(pending["sequence"])
    state["installed"] = installed
    state["available"] = {
        "available": False,
        "channel": config["CHANNEL"],
        "current_version": installed["version"],
        "version": installed["version"],
        "sequence": installed["sequence"],
    }
    state["last_transaction"] = pending
    state["pending"] = None
    atomic_json(state_path(), state)
    PENDING_MARKER.unlink(missing_ok=True)
    print(f"Recovera {installed['version']} package update passed validation.")


def command_install_packages(config, args, release):
    require_root()
    pointer, assets, manifest, manifest_path, signature_path = release
    root = config_path(config, "TRANSACTION_ROOT", DEFAULT_TRANSACTION_ROOT)
    transaction_dir = root / f"{int(manifest['sequence']):08d}-{manifest['version']}"
    downloads = transaction_dir / "packages"
    rollback_dir = transaction_dir / "rollback"
    if transaction_dir.exists():
        shutil.rmtree(transaction_dir)
    downloads.mkdir(parents=True)
    rollback_dir.mkdir()
    shutil.copyfile(manifest_path, transaction_dir / manifest_path.name)
    shutil.copyfile(signature_path, transaction_dir / signature_path.name)

    package_paths = []
    rollback = []
    new_packages = []
    changes = []
    for package in manifest["packages"]:
        old_version = installed_version(package["name"])
        if old_version != package["version"]:
            changes.append((package, old_version))
    required_bytes = sum(int(package["size"]) for package, _ in changes) * 2 + 128 * 1024 * 1024
    if shutil.disk_usage(transaction_dir).free < required_bytes:
        raise UpgradeError(
            f"insufficient free space for package transaction; need at least {required_bytes} bytes"
        )
    for package, old_version in changes:
        if old_version is None and package["name"] in config.get("REQUIRE_BASELINE_PACKAGES", "").split():
            raise UpgradeError(
                f"{package['name']} has no installed rollback baseline; install the matching "
                "baseline package with setup.sh install-updater before enabling this channel"
            )
        local = downloads / package["asset"]
        obtain_asset(package["asset"], assets, local, config)
        verify_deb(local, package)
        package_paths.append(local)
        if old_version is None:
            new_packages.append(package["name"])
        elif old_version != package["version"]:
            old_deb = find_cached_deb(config, package["name"], old_version)
            if old_deb is None:
                raise UpgradeError(
                    f"cannot safely update {package['name']}: the installed {old_version} package "
                    "is not in the Recovera or installer cache for rollback"
                )
            destination = rollback_dir / old_deb.name
            shutil.copyfile(old_deb, destination)
            rollback.append({"name": package["name"], "version": old_version, "path": str(destination)})

    if package_paths:
        verify_package_plan(package_paths)
    transaction = {
        "type": "package", "version": manifest["version"], "sequence": int(manifest["sequence"]),
        "packages": [str(item) for item in package_paths], "rollback": rollback,
        "new_packages": new_packages, "reboot_required": bool(manifest.get("reboot_required", False)),
    }
    state = read_json(state_path(), {})
    state.update({"pending": transaction, "previous": current_release(), "release_tag": pointer["release_tag"]})
    atomic_json(state_path(), state)
    PENDING_MARKER.parent.mkdir(parents=True, exist_ok=True)
    PENDING_MARKER.touch(mode=0o600, exist_ok=True)
    result = run(package_apt_command("install", package_paths), check=False, capture=True) if package_paths else None
    if result is not None and result.returncode:
        try:
            rollback_package_transaction(config, transaction)
        finally:
            state["last_failure"] = {"version": manifest["version"], "reason": "package installation failed"}
            state["pending"] = None
            atomic_json(state_path(), state)
            PENDING_MARKER.unlink(missing_ok=True)
        detail = (result.stdout + result.stderr).decode("utf-8", "replace")[-4000:]
        raise UpgradeError("package installation failed and was rolled back:\n" + detail)
    try:
        for package in manifest["packages"]:
            if installed_version(package["name"]) != package["version"]:
                raise UpgradeError(f"installed package version does not match the release: {package['name']}")
        validate_services(config)
    except UpgradeError as exc:
        rollback_package_transaction(config, transaction)
        state["last_failure"] = {"version": manifest["version"], "reason": str(exc)}
        state["pending"] = None
        atomic_json(state_path(), state)
        PENDING_MARKER.unlink(missing_ok=True)
        raise
    if manifest.get("reboot_required", False):
        print(f"Recovera {manifest['version']} package update is installed and awaiting reboot validation.")
        if args.reboot:
            run(["systemctl", "reboot"])
        else:
            print("Reboot when ready: sudo systemctl reboot")
    else:
        commit_package_transaction(config, state)


def command_install(config, args):
    require_root()
    with UpgradeLock():
        root = config_path(config, "TRANSACTION_ROOT", DEFAULT_TRANSACTION_ROOT)
        root.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix="metadata-", dir=root) as temporary:
            release = get_release(config, args, Path(temporary))
            manifest = release[2]
            ensure_newer(manifest)
            if manifest.get("type", "image") == "package":
                return command_install_packages(config, args, release)
            return command_install_image(config, args, release)


def command_mark_success(config, args):
    require_root()
    with UpgradeLock():
        state = read_json(state_path(), {})
        pending = state.get("pending")
        if not pending:
            raise UpgradeError("there is no pending upgrade")
        validate_services(config)
        if pending.get("type") == "package":
            for source in pending.get("packages", []):
                name = dpkg_field(source, "Package")
                version = dpkg_field(source, "Version")
                if installed_version(name) != version:
                    raise UpgradeError(f"pending package is not installed at the expected version: {name}")
            commit_package_transaction(config, state)
            return
        current = current_release()
        if pending.get("version") != current.get("version"):
            raise UpgradeError("the running image is not the pending upgrade")
        run([BOOT_HELPER, "commit", current["version"], pending["image"]])
        state["installed_sequence"] = int(current["sequence"])
        state["installed"] = current
        state["pending"] = None
        atomic_json(state_path(), state)
        PENDING_MARKER.unlink(missing_ok=True)
        print(f"Recovera {current['version']} passed validation and is now the default image.")


def previous_image_available(previous, config):
    """True when the previous release is a loop image that is still on disk."""
    version = str(previous.get("version") or "")
    if not version or previous.get("type", "image") != "image":
        return False
    return (Path(config.get("HOST_ROOT", "/host")) / "recovera/images" / f"{version}.img").is_file()


def command_validation_failed(config, args):
    require_root()
    with UpgradeLock():
        state = read_json(state_path(), {})
        pending = state.get("pending") or {}
        if pending.get("type") == "package":
            rollback_package_transaction(config, pending)
            failed_version = pending.get("version")
            state["pending"] = None
        else:
            previous = state.get("previous", {})
            if previous_image_available(previous, config):
                run([BOOT_HELPER, "rollback", previous["version"]])
            else:
                # The previous system was the conventional root (a package
                # release, or nothing), not a loop image: boot that again.
                run([BOOT_HELPER, "fallback"])
            failed_version = current_release().get("version")
        state["last_failure"] = {"version": failed_version, "reason": args.reason}
        atomic_json(state_path(), state)
        PENDING_MARKER.unlink(missing_ok=True)
        if args.reboot:
            run(["systemctl", "reboot"])


def command_rollback(config, args):
    require_root()
    with UpgradeLock():
        state = read_json(state_path(), {})
        transaction = state.get("pending") or state.get("last_transaction") or {}
        previous = state.get("previous", {})
        if transaction.get("type") == "package":
            rollback_package_transaction(config, transaction)
            validate_services(config)
            state["installed"] = previous
            state["installed_sequence"] = int(previous.get("sequence", 0))
            state["pending"] = None
            state["last_transaction"] = None
            state["last_rollback"] = {
                "version": transaction.get("version"), "reason": "operator requested rollback"
            }
            atomic_json(state_path(), state)
            PENDING_MARKER.unlink(missing_ok=True)
            print(f"Rolled back Recovera package release {transaction.get('version')}.")
        elif previous_image_available(previous, config) and BOOT_HELPER.exists():
            run([BOOT_HELPER, "rollback", previous["version"]])
            print(f"Selected Recovera image {previous['version']} for rollback.")
        elif read_json(layout_path(), {}).get("fallback_entry") and BOOT_HELPER.exists():
            run([BOOT_HELPER, "fallback"])
            print("Selected the conventional installation for rollback.")
        else:
            raise UpgradeError("there is no rollback transaction available")
        if args.reboot:
            run(["systemctl", "reboot"])


def command_status(config, args):
    current = current_release()
    value = {
        "updater_version": UPDATER_VERSION,
        "current": current,
        "state": status_state(current),
        "image_layout": read_json(layout_path(), None),
        "activation_supported": layout_path().exists() and BOOT_HELPER.exists(),
        "package_updates_supported": shutil.which("apt-get") is not None and shutil.which("dpkg-deb") is not None,
    }
    print(json.dumps(value, indent=2, sort_keys=True))


def root_filesystem_uuid():
    result = run(["findmnt", "-n", "-o", "UUID,SOURCE,FSTYPE", "/"], capture=True)
    fields = result.stdout.decode("utf-8", "replace").split()
    if len(fields) < 3:
        raise UpgradeError("cannot identify the root filesystem")
    uuid, source, fstype = fields[:3]
    if source.startswith("/dev/loop"):
        raise UpgradeError("this appliance is already running from a Recovera image")
    if fstype != "ext4" or not re.fullmatch(r"[0-9A-Fa-f-]{8,64}", uuid):
        raise UpgradeError(f"unsupported root filesystem for image boot: {fstype} {uuid}")
    return uuid


def conventional_grub_entry(uuid):
    entry = f"gnulinux-simple-{uuid}"
    try:
        config_text = GRUB_CFG.read_text(errors="replace")
    except OSError as exc:
        raise UpgradeError(f"cannot read {GRUB_CFG}: {exc}") from exc
    if f"'{entry}'" not in config_text:
        raise UpgradeError(f"the GRUB menu has no {entry} entry to fall back to")
    return entry


HOST_MOUNTPOINT = "/host"


def host_bind_line(host):
    return f"/ {host} none bind,x-systemd.requires-mounts-for=/ 0 0"


def fstab_lines():
    return FSTAB.read_text().splitlines()


def host_bind_present(lines=None):
    return any(line.split()[:2] == ["/", HOST_MOUNTPOINT] for line in (lines or fstab_lines())
               if line.strip() and not line.lstrip().startswith("#"))


def command_prepare_image_layout(config, args):
    """Let a conventional appliance boot verified loop images, keeping its own root.

    Nothing about the next boot changes: the conventional GRUB entry stays the
    default and is recorded as the fallback for a failed image.
    """
    require_root()
    layout = read_json(layout_path(), {})
    if layout.get("mode") == "loop-image-v1":
        print(json.dumps({"prepared": True, "already": True, "layout": layout}, indent=2))
        return 0
    host = Path(config["HOST_ROOT"])
    if str(host) != HOST_MOUNTPOINT:
        raise UpgradeError(f"image layout conversion expects HOST_ROOT={HOST_MOUNTPOINT}")
    if PENDING_MARKER.exists():
        raise UpgradeError("an update is waiting for reboot validation; finish it first")
    uuid = root_filesystem_uuid()
    entry = conventional_grub_entry(uuid)
    for source in ("07_recovera_images", "99_recovera_images.cfg"):
        if not (SHARE_DIR / source).is_file():
            raise UpgradeError(f"missing {SHARE_DIR / source}; reinstall recovera-appliance")
    plan = {"boot_root_uuid": uuid, "fallback_entry": entry, "host": str(host),
            "state_moved_from": str(host / "recovera") if not host.is_mount() else None}
    if args.dry_run:
        print(json.dumps({"prepared": False, "plan": plan}, indent=2))
        return 0
    with UpgradeLock():
        if not host.is_mount():
            # Updater state lives under /host/recovera. Through the bind mount
            # that is /recovera on the root filesystem, so carry it across.
            legacy = host / "recovera"
            shared = SHARED_STATE
            shared.mkdir(mode=0o755, exist_ok=True)
            if legacy.is_dir():
                for item in legacy.iterdir():
                    destination = shared / item.name
                    if destination.exists():
                        continue
                    if item.is_dir():
                        shutil.copytree(item, destination, symlinks=True)
                    else:
                        shutil.copy2(item, destination)
            host.mkdir(exist_ok=True)
            run(["mount", "--bind", "/", str(host)])
            lines = fstab_lines()
            if not host_bind_present(lines):
                FSTAB.write_text("\n".join(lines + [HOST_BIND_COMMENT, host_bind_line(host)]) + "\n")
        (host / "recovera/images").mkdir(parents=True, exist_ok=True)
        GRUB_DEFAULTS.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(SHARE_DIR / "99_recovera_images.cfg", GRUB_DEFAULTS)
        GRUB_SCRIPT.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(SHARE_DIR / "07_recovera_images", GRUB_SCRIPT)
        GRUB_SCRIPT.chmod(0o755)
        atomic_json(layout_path(), {"schema": 1, "mode": "loop-image-v1",
                                    "boot_root_uuid": uuid, "fallback_entry": entry,
                                    "prepared": int(time.time())}, mode=0o644)
        run(["update-grub"])
        run(["grub-set-default", entry])
    print(json.dumps({"prepared": True, "plan": plan}, indent=2))
    return 0


def command_revert_image_layout(config, args):
    """Undo prepare-image-layout while no image is staged or running."""
    require_root()
    layout = read_json(layout_path(), {})
    host = Path(config["HOST_ROOT"])
    if layout.get("mode") != "loop-image-v1":
        print(json.dumps({"reverted": True, "already": True}, indent=2))
        return 0
    root_filesystem_uuid()  # refuses while running from an image
    if PENDING_MARKER.exists():
        raise UpgradeError("an image is staged; roll it back before reverting the layout")
    images = sorted((host / "recovera/images").glob("*.img")) if host.is_dir() else []
    if images and not args.force:
        raise UpgradeError("images are present in /host/recovera/images; pass --force to keep "
                           "them on disk and revert anyway")
    with UpgradeLock():
        for path in (GRUB_SCRIPT, GRUB_DEFAULTS):
            path.unlink(missing_ok=True)
        layout_path().unlink(missing_ok=True)
        run(["grub-editenv", "/boot/grub/grubenv", "unset", "saved_entry", "next_entry"], check=False)
        run(["update-grub"])
        lines = [line for line in fstab_lines()
                 if line.strip() != HOST_BIND_COMMENT and line.split()[:2] != ["/", HOST_MOUNTPOINT]]
        FSTAB.write_text("\n".join(lines) + "\n")
        if host.is_mount():
            shared = SHARED_STATE
            run(["umount", str(host)])
            (host / "recovera").mkdir(parents=True, exist_ok=True)
            for name in ("state.json",):
                if (shared / name).is_file():
                    shutil.copy2(shared / name, host / "recovera" / name)
    print(json.dumps({"reverted": True}, indent=2))
    return 0


def parser():
    value = argparse.ArgumentParser(prog="recovera-upgrade")
    value.add_argument("--config", type=Path, default=Path(os.environ.get("RECOVERA_UPGRADE_CONFIG", DEFAULT_CONFIG)))
    value.add_argument("--signers", type=Path, default=Path(os.environ.get("RECOVERA_UPGRADE_SIGNERS", DEFAULT_SIGNERS)))
    sub = value.add_subparsers(dest="command", required=True)
    for name in ("check", "install"):
        command = sub.add_parser(name)
        command.add_argument("--channel-file", type=Path)
        command.add_argument("--source-dir", type=Path)
        # Read a different channel once, e.g. an operating-system transition.
        # The automatic update window never passes this.
        command.add_argument("--channel")
        if name == "check":
            command.add_argument("--cache", action="store_true")
        else:
            command.add_argument("--reboot", action="store_true")
            command.add_argument("--allow-busy", action="store_true",
                                 help="skip the replication and restore idle checks of a transition")
    prepare = sub.add_parser("prepare-image-layout")
    prepare.add_argument("--dry-run", action="store_true")
    revert = sub.add_parser("revert-image-layout")
    revert.add_argument("--force", action="store_true")
    sub.add_parser("status")
    sub.add_parser("mark-success")
    rollback = sub.add_parser("rollback")
    rollback.add_argument("--reboot", action="store_true")
    failed = sub.add_parser("validation-failed")
    failed.add_argument("--reason", default="post-boot validation failed")
    failed.add_argument("--reboot", action="store_true")
    return value


def main():
    args = parser().parse_args()
    # Ubuntu's needrestart hook restarts services whose Python scripts apt just
    # replaced, which includes recovera-peer-sync.service while it is in the
    # middle of a long replication. Recovera restarts its own services after an
    # update, so keep needrestart out of package transactions and rollbacks.
    os.environ["NEEDRESTART_SUSPEND"] = "1"
    try:
        config = read_config(args.config)
        if args.command in ("check", "install"):
            if args.channel:
                if not CHANNEL_RE.fullmatch(args.channel):
                    raise UpgradeError("invalid channel name")
                if getattr(args, "cache", False):
                    raise UpgradeError("--channel cannot be combined with --cache")
                config["CHANNEL"] = args.channel
            config["CHANNEL_REQUESTED"] = config["CHANNEL"]
            config["CHANNEL"] = effective_channel(config["CHANNEL"], local_os())
        return {
            "check": command_check,
            "install": command_install,
            "status": command_status,
            "mark-success": command_mark_success,
            "validation-failed": command_validation_failed,
            "rollback": command_rollback,
            "prepare-image-layout": command_prepare_image_layout,
            "revert-image-layout": command_revert_image_layout,
        }[args.command](config, args) or 0
    except (UpgradeError, FileNotFoundError, ValueError, subprocess.SubprocessError) as exc:
        print(f"recovera-upgrade: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
