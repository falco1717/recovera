#!/bin/bash
# Copy appliance identity/configuration into a verified, inactive root image.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "run as root" >&2; exit 1; }
[ "$#" -eq 1 ] || { echo "usage: $0 TARGET_ROOT" >&2; exit 2; }
target=$(readlink -f "$1")
[ -d "$target" ] && mountpoint -q "$target" || { echo "target is not a mountpoint" >&2; exit 1; }
[ -f "$target/etc/recovera-image-release" ] || { echo "target is not a Recovera image" >&2; exit 1; }

copy_path() {
  local path=$1
  [ -e "$path" ] || return 0
  rsync -aHAX --numeric-ids --relative "$path" "$target/"
}

# Explicitly scoped persistent state. Never copy recovery points, transient
# runtime state, logs, caches, package databases, or a complete /etc tree.
for path in \
  /datto/config \
  /etc/recovera \
  /etc/recovera-peer \
  /var/lib/recovera-peer \
  /etc/apache2/ssl \
  /etc/NetworkManager/system-connections \
  /etc/machine-id \
  /etc/hostname \
  /etc/hosts \
  /etc/hostid \
  /etc/zfs/zpool.cache \
  /etc/fstab \
  /etc/firewalld/zones \
  /var/lib/datto \
  /var/lib/recovera \
  /var/lib/samba/private \
  /opt/recovera/setup.conf; do
  copy_path "$path"
done
for path in /etc/ssh/ssh_host_*; do copy_path "$path"; done
# Ubuntu 24.04 NetworkManager keeps connections as netplan files.
for path in /etc/netplan/90-NM-*.yaml; do copy_path "$path"; done

# ZFS refuses to import a pool last used under another host ID without -f.
# Match the source exactly: a candidate must not carry a host ID of its own.
[ -e /etc/hostid ] || rm -f "$target/etc/hostid"

# The candidate's root is the loop image (label recovera-root), not this
# appliance's conventional root, and /host is attached by the initramfs.
python3 - "$target/etc/fstab" <<'PY'
import sys
path = sys.argv[1]
try:
    lines = open(path).read().splitlines()
except FileNotFoundError:
    lines = []
output = []
for line in lines:
    fields = line.split()
    if line.strip() == "# Recovera image host (recovera-upgrade prepare-image-layout)":
        continue
    if line.lstrip().startswith("#") or len(fields) < 2:
        output.append(line)
    elif fields[1] == "/host":
        continue
    elif fields[1] == "/":
        output.append("LABEL=recovera-root\t/\text4\tdefaults,errors=remount-ro\t0 0")
    else:
        output.append(line)
if not any(len(line.split()) > 1 and line.split()[1] == "/" for line in output
           if not line.lstrip().startswith("#")):
    output.append("LABEL=recovera-root\t/\text4\tdefaults,errors=remount-ro\t0 0")
open(path, "w").write("\n".join(output) + "\n")
PY

# Preserve human/login accounts without replacing service accounts introduced
# by the new image. Group memberships for those users are carried forward.
python3 - "$target" <<'PY'
from pathlib import Path
import sys

target = Path(sys.argv[1])
source = Path('/')

def rows(path):
    return [line for line in path.read_text().splitlines() if line]

passwd_rows = rows(source / 'etc/passwd')
selected = {'backup-admin'}
for row in passwd_rows:
    fields = row.split(':')
    if len(fields) >= 4 and fields[0] != 'nobody' and int(fields[2]) >= 1000:
        selected.add(fields[0])

def merge_accounts(name, wanted):
    source_rows = rows(source / 'etc' / name)
    target_path = target / 'etc' / name
    target_rows = rows(target_path)
    replacements = {row.split(':', 1)[0]: row for row in source_rows if row.split(':', 1)[0] in wanted}
    output = []
    seen = set()
    for row in target_rows:
        key = row.split(':', 1)[0]
        output.append(replacements.get(key, row))
        seen.add(key)
    output.extend(row for key, row in replacements.items() if key not in seen)
    target_path.write_text('\n'.join(output) + '\n')

merge_accounts('passwd', selected)
merge_accounts('shadow', selected)

source_groups = rows(source / 'etc/group')
group_names = set()
for row in source_groups:
    fields = row.split(':')
    members = set(fields[3].split(',')) if len(fields) > 3 else set()
    if members & selected or fields[0] in selected or fields[0] in {'sudo', 'remote-users'}:
        group_names.add(fields[0])
merge_accounts('group', group_names)
merge_accounts('gshadow', group_names)
PY

echo "Recovera appliance configuration migrated into candidate image"
