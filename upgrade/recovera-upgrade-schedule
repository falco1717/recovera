#!/usr/bin/env python3
"""Install the latest signed channel release inside the configured window."""
from __future__ import annotations

import datetime
import json
import os
import subprocess
import sys
from pathlib import Path

POLICY = Path(os.environ.get("RECOVERA_UPGRADE_POLICY", "/etc/recovera/update-policy.json"))
UPDATER = os.environ.get("RECOVERA_UPGRADE_COMMAND", "/usr/local/sbin/recovera-upgrade")


def main() -> int:
    value = {"channel": "stable", "window": {"start": 21, "end": 5}}
    try:
        if POLICY.is_file():
            value = json.loads(POLICY.read_text(encoding="utf-8"))
        channel = value["channel"]
        start = int(value["window"]["start"])
        end = int(value["window"]["end"])
    except (KeyError, TypeError, ValueError, json.JSONDecodeError, OSError) as exc:
        print(f"recovera-upgrade-schedule: invalid policy: {exc}", file=sys.stderr)
        return 1
    if channel == "none":
        return 0
    if channel != "stable" or not 0 <= start <= 23 or not 0 <= end <= 23:
        print("recovera-upgrade-schedule: unsupported policy", file=sys.stderr)
        return 1
    hour = datetime.datetime.now().hour
    inside = start <= hour < end if start < end else hour >= start or hour < end
    if not inside:
        return 0
    result = subprocess.run(
        [UPDATER, "check", "--cache"], check=False, capture_output=True, text=True
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode == 3:
        return 0
    if result.returncode != 0:
        return result.returncode
    try:
        available = bool(json.loads(result.stdout).get("available"))
    except (AttributeError, json.JSONDecodeError, TypeError):
        print("recovera-upgrade-schedule: updater returned invalid check output", file=sys.stderr)
        return 1
    if not available:
        return 0
    return subprocess.run([UPDATER, "install", "--reboot"], check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
