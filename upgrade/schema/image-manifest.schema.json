{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/falco1717/recovera/upgrade/schema/image-manifest.schema.json",
  "title": "Recovera image release manifest",
  "description": "Signed (recovera-upgrade namespace) description of a Recovera root image release. Written by tools/build-upgrade-image.sh; enforced by recovera-upgradectl (validate_release_identity, validate_image_manifest). Optional fields marked 'reserved' are accepted now and used by later releases.",
  "type": "object",
  "required": ["schema", "version", "sequence", "channel", "architecture", "minimum_updater", "image"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "version": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"},
    "sequence": {"type": "integer", "minimum": 1,
                 "description": "One monotonic counter across every channel; an appliance never installs a lower one."},
    "channel": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,31}$",
                "description": "Must equal the channel the appliance reads; transitions use a *-transition channel."},
    "architecture": {"enum": ["amd64", "x86_64"]},
    "minimum_updater": {"type": "integer", "minimum": 1},
    "os": {
      "type": "object", "required": ["id", "version_id"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "version_id": {"type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$"}}
    },
    "from": {
      "description": "Present only on an operating-system transition: what the appliance must start from.",
      "type": "object", "required": ["os_version_ids"], "additionalProperties": false,
      "properties": {
        "os_version_ids": {"type": "array", "minItems": 1,
                           "items": {"type": "string", "pattern": "^[0-9.]{2,16}$"}},
        "minimum_version": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+:~_-]{0,63}$"}
      }
    },
    "image": {
      "type": "object",
      "required": ["compression", "size", "sha256", "uncompressed_size", "uncompressed_sha256", "parts"],
      "additionalProperties": false,
      "properties": {
        "compression": {"const": "xz"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "uncompressed_size": {"type": "integer", "minimum": 1},
        "uncompressed_sha256": {"$ref": "#/$defs/sha256"},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}
      }
    },
    "released": {"type": "string", "format": "date-time", "description": "reserved"},
    "notes": {"type": "string", "maxLength": 4000, "description": "reserved"},
    "key_id": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
               "description": "reserved: fingerprint of the signing key, checked against the trusted signer set"},
    "required_space": {"type": "integer", "minimum": 1, "description": "reserved"},
    "rollback_target": {"enum": ["previous-image", "conventional-root"], "description": "reserved"},
    "reboot_required": {"const": true},
    "valid_until": {"type": "string", "format": "date-time",
                    "description": "reserved: lets an appliance notice a gateway serving a stale pointer"},
    "rollout": {"type": "object", "description": "reserved: cohort rules; never overrides appliance safety checks"},
    "deltas": {
      "description": "reserved: source-specific patches; the full image stays the fallback",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_sequence", "from_sha256", "size", "sha256", "parts"],
        "additionalProperties": false,
        "properties": {
          "from_sequence": {"type": "integer", "minimum": 1},
          "from_sha256": {"$ref": "#/$defs/sha256",
                          "description": "uncompressed SHA-256 of the exact source release image"},
          "encoding": {"type": "string"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "part": {
      "type": "object", "required": ["name", "size", "sha256"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_~-]{0,191}$"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
