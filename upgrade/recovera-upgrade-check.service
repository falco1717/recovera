[Unit]
Description=Install signed Recovera updates during the configured window
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/recovera/upgrade.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/recovera-upgrade-schedule
SuccessExitStatus=3
PrivateTmp=yes
ProtectSystem=false
TimeoutStartSec=infinity
