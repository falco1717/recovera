# Large package payloads and appliance images live outside the Git repository.
*.deb
*.ova
Recovera-v*/
scripts/vcenter/ova/SHA256SUMS
debs/
Packages
Packages.gz

# vc-login.ps1 writes the live vCenter session secret here
scripts/vcenter/vc-session.txt
vc-session.txt

# Never commit credentials
*.key
*password*
*creds*
recovera-upgrade-signing-key*
recovera-upgrade-recovery-key*
gateway/config/github-token
gateway/config/access-signers
gateway/config/*.token
gateway/.env
recovera-gateway-access-key*

# built bundles
dist/
.release-work/

# Compatibility reports describe installed appliance internals and stay local.
compatibility/reports/

# Local Python test/runtime caches
__pycache__/
*.pyc
