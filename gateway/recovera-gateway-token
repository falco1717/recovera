#!/usr/bin/env python3
"""Issue a signed Recovera gateway credential for one appliance or recipient."""

import argparse
from pathlib import Path
import sys

from recovera_gateway_auth import AccessError, issue


def parser():
    value = argparse.ArgumentParser(description=__doc__)
    value.add_argument("--signing-key", required=True, type=Path)
    value.add_argument("--subject", required=True)
    value.add_argument("--channel", action="append", default=["stable"])
    value.add_argument("--days", type=int, default=90)
    value.add_argument("--output", type=Path)
    return value


def main(argv=None):
    arguments = parser().parse_args(argv)
    credential = issue(
        arguments.signing_key, arguments.subject, arguments.channel,
        arguments.days * 24 * 3600,
    )
    if arguments.output:
        arguments.output.write_text(credential + "\n", encoding="ascii")
        arguments.output.chmod(0o600)
        print(f"wrote gateway credential to {arguments.output}")
    else:
        print(credential)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except AccessError as exc:
        print(f"recovera-gateway-token: {exc}", file=sys.stderr)
        sys.exit(1)
