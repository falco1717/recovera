{% extends 'commonlookandfeel/Default/layout.main.html.twig' %}
{% set title = 'Off-site Target' %}
{% block scripts %}
    <script src="{{ asset('commonlookandfeel/js/App/Configure/RecoveraTarget.js') }}"></script>
{% endblock %}
{% block content %}
<div id="recovera-target" data-api="{{ path('recovera_target_api', {'operation':'status'})|replace({'status':''}) }}">
    <div id="recovera-csrf" class="d-none">{{ csrfTag() }}</div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="mb-1">Off-site Target</h2><p class="text-secondary mb-0">Replicate recovery points directly between Recovera appliances.</p></div>
        <button id="rt-sync" class="btn btn-primary">Synchronize now</button>
    </div>
    <div id="rt-message" class="alert d-none" role="alert"></div>
    <div class="row g-4">
        <div class="col-xl-6"><div class="card h-100"><div class="card-body">
            <h3>This appliance</h3><dl class="row mb-3"><dt class="col-4">Name</dt><dd id="rt-name" class="col-8">Loading…</dd><dt class="col-4">Fingerprint</dt><dd id="rt-fingerprint" class="col-8 text-break">—</dd></dl>
            <button id="rt-code" class="btn btn-secondary">Generate pairing code</button><pre id="rt-code-output" class="mt-3 p-3 bg-light">Use a one-time code to authorize another appliance.</pre>
        </div></div></div>
        <div class="col-xl-6"><div class="card h-100"><div class="card-body">
            <h3>Add a target</h3><div class="row g-3"><div class="col-8"><label class="form-label" for="rt-host">IP address or hostname</label><input id="rt-host" class="form-control"></div><div class="col-4"><label class="form-label" for="rt-port">Port</label><input id="rt-port" class="form-control" type="number" value="9443"></div></div>
            <button id="rt-discover" class="btn btn-secondary mt-3">Discover target</button><pre id="rt-discovery" class="mt-3 p-3 bg-light">Discover the target and compare its certificate fingerprint.</pre>
            <label class="form-label" for="rt-pair-code">One-time code</label><input id="rt-pair-code" class="form-control"><button id="rt-pair" class="btn btn-primary mt-3">Pair target</button>
        </div></div></div>
        <div class="col-12"><div class="card"><div class="card-body"><h3>Replication policy</h3>
            <div class="row g-3"><div class="col-lg-5"><label class="form-label" for="rt-asset">Protected asset</label><select id="rt-asset" class="form-select"></select></div><div class="col-lg-5"><label class="form-label" for="rt-peer">Target appliance</label><select id="rt-peer" class="form-select"></select></div><div class="col-lg-2"><label class="form-label" for="rt-interval">Interval (minutes)</label><input id="rt-interval" class="form-control" type="number" min="5" value="60"></div></div>
            <button id="rt-save" class="btn btn-primary mt-3">Save policy</button>
        </div></div></div>
        <div class="col-12"><div class="card"><div class="card-body"><h3>Status</h3><div class="table-responsive"><table class="table"><thead><tr><th>Asset</th><th>Target</th><th>Last recovery point</th><th>Result</th></tr></thead><tbody id="rt-status"></tbody></table></div></div></div></div>
        <div class="col-12"><div class="card"><div class="card-body"><h3>Recent events</h3><pre id="rt-events" class="p-3 bg-light mb-0">Loading…</pre></div></div></div>
    </div>
</div>
{% endblock %}
