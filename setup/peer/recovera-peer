            "tls_fingerprint": local_tls_fingerprint()}


def authenticate_local_admin(username: str, password: str) -> bool:
    """Use the appliance's registered local administrator credential store."""
    if (not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]{0,31}", username)
            or not password or len(password.encode("utf-8")) > 4096):
        return False
    try:
        result = run(
            ["php", str(AUTH_HELPER_PATH), username],
            check=False,
            input_data=password.encode("utf-8"),
            timeout=8,
        )
        authorized = result.returncode == 0
        if not authorized:
            time.sleep(0.25)
        return authorized
    except (PeerError, subprocess.TimeoutExpired):
        time.sleep(0.25)
        return False


