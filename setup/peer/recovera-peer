let state=null,discovered=null;async function api(path,method='GET',body=null){let r=await fetch(path,{method,headers:{'Content-Type':'application/json'},body:body?JSON.stringify(body):null});let j=await r.json();if(!r.ok)throw Error(j.error||r.statusText);return j}function msg(text,ok=true){document.getElementById('message').innerHTML=`<p class="${ok?'ok':'error'}">${text}</p>`}async function load(){try{state=await api('/v1/admin/status');local.textContent=JSON.stringify({appliance:state.appliance,tls_fingerprint:state.tls_fingerprint},null,2);asset.innerHTML=state.local_assets.filter(x=>!x.replicated).map(x=>`<option value="${x.key}">${x.key} (${x.snapshots.length} points)</option>`).join('');peer.innerHTML=Object.entries(state.peers).map(([id,x])=>`<option value="${id}">${x.name} — ${x.host}</option>`).join('');status.innerHTML='<table><tr><th>Asset</th><th>Target</th><th>Last point</th><th>Result</th></tr>'+Object.entries(state.rules).map(([a,r])=>{let s=state.state.assets[`${r.peer_id}:${a}`]||{};return `<tr><td>${a}</td><td>${state.peers[r.peer_id]?.name||r.peer_id}</td><td>${s.last_snapshot||'—'}</td><td>${s.error||s.mode||'waiting'}</td></tr>`}).join('')+'</table>';events.textContent=JSON.stringify((state.state.events||[]).slice(-20).reverse(),null,2)}catch(e){msg(e.message,false)}}async function pairCode(){try{let x=await api('/v1/admin/pairing-code','POST',{});paircode.textContent=`Code: ${x.code}\nExpires: ${new Date(x.expires*1000).toLocaleString()}\nTLS fingerprint: ${state.tls_fingerprint}`}catch(e){msg(e.message,false)}}async function discover(){try{discovered=await api('/v1/admin/discover','POST',{host:host.value,port:Number(port.value)});document.getElementById('discover').textContent=JSON.stringify(discovered,null,2);msg('Compare this fingerprint with the target appliance before pairing.')}catch(e){msg(e.message,false)}}async function addPeer(){try{if(!discovered)throw Error('Discover the appliance first');await api('/v1/admin/peer','POST',{host:host.value,port:Number(port.value),code:code.value,fingerprint:discovered.observed_fingerprint,appliance_id:discovered.appliance_id});msg('Target paired.');await load()}catch(e){msg(e.message,false)}}async function saveRule(){try{await api('/v1/admin/rule','POST',{asset:asset.value,peer_id:peer.value,interval_minutes:Number(interval.value)});msg('Replication policy saved.');await load()}catch(e){msg(e.message,false)}}async function syncNow(){try{msg('Replication started…');let x=await api('/v1/admin/sync','POST',{});msg('Replication run complete: '+JSON.stringify(x));await load()}catch(e){msg(e.message,false)}}load();setInterval(load,30000);</script></main></body></html>"""


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "RecoveraPeer/" + VERSION
    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write("peer-http: " + fmt % args + "\n")
    def reply(self, status: int, value: Any, content_type: str = "application/json") -> None:
        raw = value if isinstance(value, bytes) else (value.encode() if isinstance(value, str) else json.dumps(value).encode())
        self.send_response(status)
        for key, val in (("Content-Type", content_type), ("Content-Length", str(len(raw))),
                         ("Cache-Control", "no-store"), ("X-Content-Type-Options", "nosniff"),
                         ("Content-Security-Policy", "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'")):
            self.send_header(key, val)
        self.end_headers(); self.wfile.write(raw)
    def json_body(self) -> dict[str, Any]:
        if self.headers.get_content_type() != "application/json":
            raise PeerError("Content-Type must be application/json")
        size = int(self.headers.get("Content-Length", "0"))
        if size < 0 or size > 1024 * 1024:
            raise PeerError("request body is too large")
        value = json.loads(self.rfile.read(size))
        if not isinstance(value, dict):
            raise PeerError("request must be a JSON object")
        return value
    def admin(self) -> bool:
        supplied = self.headers.get("X-Recovera-Internal", "")
        if self.client_address[0] in ("127.0.0.1", "::1") and WEB_TOKEN_PATH.is_file():
            expected = WEB_TOKEN_PATH.read_text(encoding="ascii").strip()
            if expected and hmac.compare_digest(supplied, expected):
                return True
        header = self.headers.get("Authorization", "")
        try:
            kind, encoded = header.split(" ", 1)
            user, password = base64.b64decode(encoded, validate=True).decode("utf-8").split(":", 1)
        except Exception:
            kind = user = password = ""
        if kind.lower() == "basic" and authenticate_local_admin(user, password):
            return True
        self.send_response(401); self.send_header("WWW-Authenticate", 'Basic realm="Recovera Peer Replication"'); self.send_header("Content-Length", "0"); self.end_headers(); return False
    def do_GET(self) -> None:
        try:
            if self.path == "/v1/info": self.reply(200, public_info())
            elif self.path == "/assets/recovera-logo.png": self.reply(200, LOGO_PATH.read_bytes(), "image/png")
            elif self.path == "/":
                self.reply(404, {"error": "Use /configure/offsite-target on the Recovera WebUI"})
            elif self.path in ("/v1/admin/status", "/v1/admin/queue-status", "/v1/admin/offsite"):
                if not self.admin():
                    return
                if self.path == "/v1/admin/status":
                    self.reply(200, status_document())
                elif self.path == "/v1/admin/queue-status":
                    self.reply(200, queue_document())
                else:
                    self.reply(200, {"schedules": offsite()["schedules"],
                                     "averages": weekly_averages()})
            else: self.reply(404, {"error": "not found"})
        except Exception as exc: self.reply(400, {"error": str(exc)})
    def do_POST(self) -> None:
        try:
            if self.path == "/v1/pair": self.reply(200, pair_accept(self.json_body(), self.client_address[0])); return
            if not self.admin(): return
            body = self.json_body()
            if self.path == "/v1/admin/pairing-code":
                code = pairing_code(15); self.reply(200, {"code": code, "expires": int(time.time()) + 900})
            elif self.path == "/v1/admin/discover":
                info, observed = ssl_json(str(body["host"]), int(body.get("port", 9443)), "/v1/info"); self.reply(200, info | {"observed_fingerprint": observed})
            elif self.path == "/v1/admin/peer":
                self.reply(200, peer_add(str(body["host"]), int(body.get("port", 9443)), str(body["code"]), str(body["fingerprint"]), {"appliance_id": str(body["appliance_id"])}))
            elif self.path == "/v1/admin/rule":
                self.reply(200, configure_asset(str(body["asset"]), str(body["peer_id"]), int(body.get("interval_minutes", 60))))
            elif self.path == "/v1/admin/sync":
                with sync_lock():
                    self.reply(200, {"results": configured_sync()})
            elif self.path == "/v1/admin/queue":
                self.reply(200, queue_snapshot(str(body["assetKey"]), str(body["snapshotEpoch"])))
            elif self.path == "/v1/admin/offsite/schedule-add":
                self.reply(200, schedule_add(int(body["secondsWeekStart"]),
                                             int(body["secondsWeekEnd"]), int(body["speed"])))
            elif self.path == "/v1/admin/offsite/schedule-delete":
                schedule_delete(int(body["scheduleId"])); self.reply(200, {"ok": True})
            elif self.path == "/v1/admin/offsite/speed-set":
                self.reply(200, set_speed(int(body["speed"])))
            elif self.path == "/v1/admin/offsite/speed-test":
                self.reply(200, int(offsite()["speed_kbps"]))
            elif self.path == "/v1/admin/offsite/concurrency-set":
                count = int(body["maxSyncs"])
                if not 1 <= count <= 64: raise PeerError("concurrent sync count must be between 1 and 64")
                settings = offsite(); settings["max_syncs"] = count; save_offsite(settings)
                run(["speedsync", "setMaxSyncs", str(count)], check=False, timeout=10)
                self.reply(200, {"ok": True, "maxSyncs": count})
            else: self.reply(404, {"error": "not found"})
        except Exception as exc: self.reply(400, {"error": str(exc)})


def serve() -> None:
    require_root(); cfg = config()
    server = http.server.ThreadingHTTPServer((cfg["listen"], int(cfg["port"])), Handler)
    server.daemon_threads = True
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(str(TLS_CERT_PATH), str(TLS_KEY_PATH))
    server.socket = context.wrap_socket(server.socket, server_side=True)
    print(f"Recovera peer service listening on https://{cfg['listen']}:{cfg['port']}", flush=True)
    server.serve_forever()


@contextlib.contextmanager
def sync_lock() -> Any:
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w") as handle:
        try: fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc: raise PeerError("another replication run is already active") from exc
        yield


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Offline Recovera appliance replication")
    result.add_argument("--version", action="version", version=VERSION)
    sub = result.add_subparsers(dest="command", required=True)
    sub.add_parser("init"); sub.add_parser("serve"); sub.add_parser("status")
    code = sub.add_parser("pairing-code"); code.add_argument("--minutes", type=int, default=15)
    discover = sub.add_parser("discover"); discover.add_argument("host"); discover.add_argument("--port", type=int, default=9443)
    add = sub.add_parser("peer-add"); add.add_argument("host"); add.add_argument("--port", type=int, default=9443); add.add_argument("--code", required=True); add.add_argument("--fingerprint"); add.add_argument("--yes", action="store_true")
    remove_peer = sub.add_parser("peer-remove"); remove_peer.add_argument("peer_id")
    remove_source = sub.add_parser("source-remove"); remove_source.add_argument("source_id")
    forget = sub.add_parser("received-forget"); forget.add_argument("asset")
    rule = sub.add_parser("asset-configure"); rule.add_argument("asset"); rule.add_argument("--peer", required=True); rule.add_argument("--interval", type=int, default=60)
    rep = sub.add_parser("replicate"); rep.add_argument("asset"); rep.add_argument("--peer", required=True); rep.add_argument("--snapshot")
    sync = sub.add_parser("sync"); sync.add_argument("--all", action="store_true", required=True)
    entry = sub.add_parser("ssh-entry"); entry.add_argument("source_id")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "init": init()
        elif args.command == "serve": serve()
        elif args.command == "status": print(json.dumps(status_document(), indent=2))
        elif args.command == "pairing-code": print(pairing_code(args.minutes)); print(f"TLS fingerprint: {local_tls_fingerprint()}")
        elif args.command == "discover":
            info, observed = ssl_json(args.host, args.port, "/v1/info"); print(json.dumps(info | {"observed_fingerprint": observed}, indent=2))
        elif args.command == "peer-add":
            info, observed = ssl_json(args.host, args.port, "/v1/info"); fingerprint = args.fingerprint or observed
            if not args.fingerprint and not args.yes:
                print(f"Target: {info.get('name')} ({info.get('appliance_id')})\nTLS fingerprint: {observed}")
                if input("Does this match the fingerprint shown on the target? [y/N] ").lower() != "y": raise PeerError("pairing cancelled")
            print(json.dumps(peer_add(args.host, args.port, args.code, fingerprint, info), indent=2))
        elif args.command == "asset-configure": print(json.dumps(configure_asset(args.asset, args.peer, args.interval), indent=2))
        elif args.command == "peer-remove": peer_remove(args.peer_id); print("target removed")
        elif args.command == "source-remove": source_remove(args.source_id); print("source removed")
        elif args.command == "received-forget": received_forget(args.asset); print("received provenance removed")
        elif args.command == "replicate":
            with sync_lock(): print(json.dumps(replicate(args.asset, args.peer, args.snapshot), indent=2))
        elif args.command == "sync":
            with sync_lock(): print(json.dumps({"results": configured_sync()}, indent=2))
        elif args.command == "ssh-entry": ssh_entry(args.source_id)
        return 0
    except Exception as exc:
        if args.command == "ssh-entry": print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")))
        else: print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
