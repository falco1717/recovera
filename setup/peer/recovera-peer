            "peers": cfg.get("peers", {}), "sources": cfg.get("sources", {}),
            "rules": cfg.get("assets", {}), "local_assets": local_assets,
            "received_assets": received_assets, "state": current, "offsite": offsite(),
            "storage": storage_status(cfg), "peer_health": current.get("peers", {}),
            "tls_fingerprint": gateway_tls_fingerprint()}


def upgrade_output(command: str, *, timeout: int) -> subprocess.CompletedProcess[bytes]:
    if command not in ("status", "check", "install"):
        raise PeerError("invalid upgrade operation")
    if not UPGRADE_COMMAND.is_file():
        raise PeerError("Recovera updater is not installed")
    environment = os.environ.copy()
    if command == "install":
        environment["RECOVERA_DEFER_SERVICE_RESTART"] = "1"
    result = run(
        [str(UPGRADE_COMMAND), "--config", str(UPGRADE_CONFIG_PATH), command],
        check=False,
        timeout=timeout,
        env=environment,
    )
    if result.returncode not in ((0, 3) if command == "check" else (0,)):
        detail = result.stderr.decode("utf-8", "replace").strip()
        raise PeerError(detail.removeprefix("recovera-upgrade: ") or "update command failed")
    return result


def default_upgrade_policy() -> dict[str, Any]:
    return {"channel": "stable", "window": {"start": 21, "end": 5}}


def upgrade_policy() -> dict[str, Any]:
    value = load_json(UPGRADE_POLICY_PATH, default_upgrade_policy())
    if not isinstance(value, dict) or value.get("channel") not in ("stable", "none"):
        raise PeerError("Recovera update policy is invalid")
    window = value.get("window")
    if not isinstance(window, dict):
        raise PeerError("Recovera update window is invalid")
    try:
        start, end = int(window["start"]), int(window["end"])
    except (KeyError, TypeError, ValueError) as exc:
        raise PeerError("Recovera update window is invalid") from exc
    duration = (end - start) % 24
    if not 0 <= start <= 23 or not 0 <= end <= 23 or not 4 <= duration <= 23:
        raise PeerError("Recovera update window must be between 4 and 23 hours")
    return {"channel": value["channel"], "window": {"start": start, "end": end}}


def set_upgrade_policy(value: dict[str, Any]) -> dict[str, Any]:
    require_root()
    channel = str(value.get("channel", "")).lower()
    window = value.get("window")
    if not isinstance(window, dict):
        raise PeerError("Recovera update window is required")
    candidate = {"channel": channel, "window": {
        "start": int(window.get("start", -1)), "end": int(window.get("end", -1)),
    }}
    previous = load_json(UPGRADE_POLICY_PATH, None)
    atomic_json(UPGRADE_POLICY_PATH, candidate)
    try:
        result = upgrade_policy()
    except Exception:
        if previous is None:
            UPGRADE_POLICY_PATH.unlink(missing_ok=True)
        else:
            atomic_json(UPGRADE_POLICY_PATH, previous)
        raise
    return {"ok": True, "policy": result}


def upgrade_status(*, check: bool = False) -> dict[str, Any]:
    require_root()
    status_result = upgrade_output("status", timeout=30)
    try:
        status = json.loads(status_result.stdout)
    except json.JSONDecodeError as exc:
        raise PeerError("Recovera updater returned invalid status") from exc
    package = run(
        ["dpkg-query", "-W", "-f=${Version}", "recovera-appliance"],
        check=False,
        timeout=10,
    )
    value: dict[str, Any] = {
        "channel": upgrade_policy()["channel"],
        "policy": upgrade_policy(),
        "credential_configured": UPGRADE_TOKEN_PATH.is_file()
            and UPGRADE_TOKEN_PATH.stat().st_size > 0,
        "installed_version": package.stdout.decode("utf-8", "replace").strip()
            if package.returncode == 0 else status.get("current", {}).get("version"),
        "updater": status,
    }
    if check:
        result = upgrade_output("check", timeout=120)
        try:
            value["release"] = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise PeerError("Recovera updater returned an invalid update check") from exc
    return value


def upgrade_install() -> dict[str, Any]:
    require_root()
    result = upgrade_output("install", timeout=1800)
    # The package post-install hook deliberately defers these restarts when the
    # update originates inside recovera-peer. Schedule them after this HTTP
    # response so the updater can commit its transaction first.
    run([
        "systemd-run", "--quiet", "--collect", "--unit=recovera-post-update-restart",
        "--on-active=5s", "/bin/systemctl", "restart", php_fpm_service(),
        "recovera-peer.service", "recovera-peer-sync.timer",
    ], check=False, timeout=15)
    message = result.stdout.decode("utf-8", "replace").strip()
    return {"ok": True, "message": message or "Recovera update installed",
            "restart_scheduled": True}


def authenticate_local_admin(username: str, password: str) -> bool:
    """Use the appliance's registered local administrator credential store."""
    if (not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_-]{0,31}", username)
            or not password or len(password.encode("utf-8")) > 4096):
        return False
    try:
        result = run(
            ["php", str(AUTH_HELPER_PATH), username],
            check=False,
            input_data=password.encode("utf-8"),
            timeout=8,
        )
        authorized = result.returncode == 0
        if not authorized:
            time.sleep(0.25)
        return authorized
    except (PeerError, subprocess.TimeoutExpired):
        time.sleep(0.25)
        return False


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "RecoveraPeer/" + VERSION
    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write("peer-http: " + fmt % args + "\n")
    def reply(self, status: int, value: Any, content_type: str = "application/json") -> None:
        raw = value if isinstance(value, bytes) else (value.encode() if isinstance(value, str) else json.dumps(value).encode())
        self.send_response(status)
        for key, val in (("Content-Type", content_type), ("Content-Length", str(len(raw))),
                         ("Cache-Control", "no-store"), ("X-Content-Type-Options", "nosniff"),
                         ("Content-Security-Policy", "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'")):
            self.send_header(key, val)
        self.end_headers(); self.wfile.write(raw)
    def json_body(self) -> dict[str, Any]:
        if self.headers.get_content_type() != "application/json":
            raise PeerError("Content-Type must be application/json")
        size = int(self.headers.get("Content-Length", "0"))
        if size < 0 or size > 1024 * 1024:
            raise PeerError("request body is too large")
        value = json.loads(self.rfile.read(size))
        if not isinstance(value, dict):
            raise PeerError("request must be a JSON object")
        return value
    def client_ip(self) -> str:
        address = "127.0.0.1"
        if getattr(self.server, "address_family", None) != socket.AF_UNIX:
            address = self.client_address[0]
        if address in ("127.0.0.1", "::1"):
            forwarded = self.headers.get("X-Forwarded-For", "").split(",", 1)[0].strip()
            if forwarded and HOST_RE.fullmatch(forwarded):
                address = forwarded
        return address
    def admin(self) -> bool:
        supplied = self.headers.get("X-Recovera-Internal", "")
        local = getattr(self.server, "address_family", None) == socket.AF_UNIX
        if local and WEB_TOKEN_PATH.is_file():
            expected = WEB_TOKEN_PATH.read_text(encoding="ascii").strip()
            if expected and hmac.compare_digest(supplied, expected):
                return True
        header = self.headers.get("Authorization", "")
        try:
            kind, encoded = header.split(" ", 1)
            user, password = base64.b64decode(encoded, validate=True).decode("utf-8").split(":", 1)
        except Exception:
            kind = user = password = ""
        if kind.lower() == "basic" and authenticate_local_admin(user, password):
            return True
        self.send_response(401); self.send_header("WWW-Authenticate", 'Basic realm="Recovera Peer Replication"'); self.send_header("Content-Length", "0"); self.end_headers(); return False
    def do_GET(self) -> None:
        try:
            if self.path == "/v1/info": self.reply(200, public_info())
            elif self.path == "/":
                self.reply(404, {"error": "Use /configure/offsite-target on the Recovera WebUI"})
            elif self.path in ("/v1/admin/status", "/v1/admin/queue-status", "/v1/admin/offsite",
                                "/v1/admin/backup-admin-credential", "/v1/admin/update/status",
                                "/v1/admin/update/check", "/v1/admin/update/policy",
                                "/v1/admin/storage/status", "/v1/admin/replication-activity",
                                "/v1/admin/network-check", "/v1/admin/network-check/last"):
                if not self.admin():
                    return
                if self.path == "/v1/admin/status":
                    self.reply(200, status_document())
                elif self.path == "/v1/admin/queue-status":
                    self.reply(200, queue_document())
                elif self.path == "/v1/admin/backup-admin-credential":
                    self.reply(200, backup_admin_credential())
                elif self.path == "/v1/admin/update/status":
                    self.reply(200, upgrade_status())
                elif self.path == "/v1/admin/update/check":
                    self.reply(200, upgrade_status(check=True))
                elif self.path == "/v1/admin/update/policy":
                    self.reply(200, {"policy": upgrade_policy()})
                elif self.path == "/v1/admin/storage/status":
                    self.reply(200, storage_expand_status())
                elif self.path == "/v1/admin/replication-activity":
                    self.reply(200, replication_activity())
                elif self.path == "/v1/admin/network-check":
                    self.reply(200, network_check())
                elif self.path == "/v1/admin/network-check/last":
                    self.reply(200, last_network_check())
                else:
                    self.reply(200, {"schedules": offsite()["schedules"],
                                     "averages": weekly_averages()})
            else: self.reply(404, {"error": "not found"})
        except Exception as exc: self.reply(400, {"error": str(exc)})
    def do_POST(self) -> None:
        try:
            if self.path == "/v1/pair": self.reply(200, pair_accept(self.json_body(), self.client_ip())); return
            if not self.admin(): return
            body = self.json_body()
            if self.path == "/v1/admin/pairing-code":
                code = pairing_code(15); self.reply(200, {"code": code, "expires": int(time.time()) + 900})
            elif self.path == "/v1/admin/discover":
                port = int(body.get("port", 443)); prefix = "/recovera-peer"
                info, observed = ssl_json(str(body["host"]), port, prefix + "/info"); self.reply(200, info | {"observed_fingerprint": observed})
            elif self.path == "/v1/admin/peer":
                self.reply(200, peer_add(str(body["host"]), int(body.get("port", 443)), str(body["code"]), str(body["fingerprint"]), {"appliance_id": str(body["appliance_id"])}))
            elif self.path == "/v1/admin/rule":
                self.reply(200, configure_asset(
                    str(body["asset"]), str(body["peer_id"]),
                    int(body.get("interval_minutes", 60)),
                    enabled=bool(body.get("enabled", True)),
                    retention_hours=int(body.get("retention_hours", MAX_RETENTION_HOURS)),
                    schedule_mode=str(body.get("schedule_mode", "interval")),
                    priority=str(body.get("priority", "normal")),
                    daily_hour=int(body.get("daily_hour", 18)),
                    retention_tiers=body.get("retention_tiers"),
                ))
            elif self.path == "/v1/admin/wizard-rule":
                systems = body.get("systems")
                if not isinstance(systems, list) or not 1 <= len(systems) <= 30:
                    raise PeerError("between 1 and 30 protected systems are required")
                self.reply(200, {"assets": configure_systems(
                    systems, str(body["peer_id"]), int(body["interval_minutes"]),
                    int(body["retention_hours"]), str(body.get("schedule_mode", "interval")),
                    str(body.get("priority", "normal")),
                )})
            elif self.path == "/v1/admin/agent/release":
                self.reply(200, release_agent(str(body["asset"])))
            elif self.path == "/v1/admin/sync":
                self.reply(200, start_background_sync())
            elif self.path == "/v1/admin/queue":
                self.reply(200, queue_snapshot(str(body["assetKey"]), str(body["snapshotEpoch"])))
            elif self.path == "/v1/admin/offsite/schedule-add":
                self.reply(200, schedule_add(int(body["secondsWeekStart"]),
                                             int(body["secondsWeekEnd"]), int(body["speed"])))
            elif self.path == "/v1/admin/offsite/schedule-delete":
                schedule_delete(int(body["scheduleId"])); self.reply(200, {"ok": True})
            elif self.path == "/v1/admin/offsite/speed-set":
                self.reply(200, set_speed(int(body["speed"])))
            elif self.path == "/v1/admin/offsite/speed-test":
                self.reply(200, int(offsite()["speed_kbps"]))
            elif self.path == "/v1/admin/offsite/concurrency-set":
                count = int(body["maxSyncs"])
                if not 1 <= count <= 64: raise PeerError("concurrent sync count must be between 1 and 64")
                settings = offsite(); settings["max_syncs"] = count; save_offsite(settings)
                run(["speedsync", "setMaxSyncs", str(count)], check=False, timeout=10)
                self.reply(200, {"ok": True, "maxSyncs": count})
            elif self.path == "/v1/admin/update/install":
                self.reply(200, upgrade_install())
            elif self.path == "/v1/admin/update/policy":
                self.reply(200, set_upgrade_policy(body))
            elif self.path == "/v1/admin/storage/expand":
                if body.get("confirm") != "expand-to-maximum":
                    raise PeerError("storage expansion confirmation is required")
                self.reply(200, expand_storage())
            else: self.reply(404, {"error": "not found"})
        except Exception as exc: self.reply(400, {"error": str(exc)})


class UnixHTTPServer(socketserver.TCPServer):
    address_family = socket.AF_UNIX


class ThreadingUnixHTTPServer(socketserver.ThreadingMixIn, UnixHTTPServer):
    daemon_threads = True


def serve() -> None:
    require_root(); repair_replication_account_permissions(); config()
    SOCKET_PATH.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    with contextlib.suppress(FileNotFoundError):
        SOCKET_PATH.unlink()
    server = ThreadingUnixHTTPServer(str(SOCKET_PATH), Handler)
    os.chmod(SOCKET_PATH, 0o770)
    with contextlib.suppress(KeyError, PermissionError):
        os.chown(SOCKET_PATH, 0, grp.getgrnam("www-data").gr_gid)
    print(f"Recovera peer service listening on unix:{SOCKET_PATH}", flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()
        with contextlib.suppress(FileNotFoundError):
            SOCKET_PATH.unlink()


@contextlib.contextmanager
def sync_lock() -> Any:
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w") as handle:
        try: fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc: raise PeerError("another replication run is already active") from exc
        yield


@contextlib.contextmanager
def storage_expand_lock() -> Any:
    STORAGE_EXPAND_LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with STORAGE_EXPAND_LOCK_PATH.open("w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise PeerError("another backup-storage expansion is already active") from exc
        yield


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Offline Recovera appliance replication")
    result.add_argument("--version", action="version", version=VERSION)
    sub = result.add_subparsers(dest="command", required=True)
    sub.add_parser("init"); sub.add_parser("serve"); sub.add_parser("status")
    sub.add_parser("storage-status"); sub.add_parser("storage-expand")
    code = sub.add_parser("pairing-code"); code.add_argument("--minutes", type=int, default=15)
    discover = sub.add_parser("discover"); discover.add_argument("host"); discover.add_argument("--port", type=int, default=443)
    add = sub.add_parser("peer-add"); add.add_argument("host"); add.add_argument("--port", type=int, default=443); add.add_argument("--code", required=True); add.add_argument("--fingerprint"); add.add_argument("--yes", action="store_true")
    remove_peer = sub.add_parser("peer-remove"); remove_peer.add_argument("peer_id")
    remove_source = sub.add_parser("source-remove"); remove_source.add_argument("source_id")
    forget = sub.add_parser("received-forget"); forget.add_argument("asset")
    rule = sub.add_parser("asset-configure"); rule.add_argument("asset"); rule.add_argument("--peer", required=True); rule.add_argument("--interval", type=int, default=60)
    rep = sub.add_parser("replicate"); rep.add_argument("asset"); rep.add_argument("--peer", required=True); rep.add_argument("--snapshot")
    sync = sub.add_parser("sync"); sync.add_argument("--all", action="store_true", required=True)
    entry = sub.add_parser("ssh-entry"); entry.add_argument("source_id")
    hold = sub.add_parser("maintenance", help="pause replication and drain running transfers")
    hold.add_argument("action", choices=("on", "off", "status"))
    hold.add_argument("--reason", default="maintenance")
    hold.add_argument("--wait", type=int, default=0, help="seconds to wait for running transfers")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "init": init()
        elif args.command == "serve": serve()
        elif args.command == "status": print(json.dumps(status_document(), indent=2))
        elif args.command == "storage-status": print(json.dumps(storage_expand_status(), indent=2))
        elif args.command == "storage-expand": print(json.dumps(expand_storage(), indent=2))
        elif args.command == "pairing-code": print(pairing_code(args.minutes)); print(f"Pairing HTTPS fingerprint: {gateway_tls_fingerprint()}")
        elif args.command == "discover":
            prefix = "/recovera-peer"
            info, observed = ssl_json(args.host, args.port, prefix + "/info"); print(json.dumps(info | {"observed_fingerprint": observed}, indent=2))
        elif args.command == "peer-add":
            prefix = "/recovera-peer"
            info, observed = ssl_json(args.host, args.port, prefix + "/info"); fingerprint = args.fingerprint or observed
            if not args.fingerprint and not args.yes:
                print(f"Target: {info.get('name')} ({info.get('appliance_id')})\nTLS fingerprint: {observed}")
                if input("Does this match the fingerprint shown on the target? [y/N] ").lower() != "y": raise PeerError("pairing cancelled")
            print(json.dumps(peer_add(args.host, args.port, args.code, fingerprint, info), indent=2))
        elif args.command == "asset-configure": print(json.dumps(configure_asset(args.asset, args.peer, args.interval), indent=2))
        elif args.command == "peer-remove": peer_remove(args.peer_id); print("target removed")
        elif args.command == "source-remove": source_remove(args.source_id); print("source removed")
        elif args.command == "received-forget": received_forget(args.asset); print("received provenance removed")
        elif args.command == "replicate":
            with sync_lock(): print(json.dumps(replicate(args.asset, args.peer, args.snapshot), indent=2))
        elif args.command == "sync":
            with sync_lock(): print(json.dumps({"results": configured_sync()}, indent=2))
        elif args.command == "ssh-entry": ssh_entry(args.source_id)
        elif args.command == "maintenance":
            if args.action == "on":
                answer = maintenance_on(args.reason, args.wait)
                print(json.dumps(answer, indent=2))
                return 0 if answer["idle"] else 4
            if args.action == "off": print(json.dumps(maintenance_off(), indent=2))
            else: print(json.dumps({"maintenance": maintenance_status(), "busy": replication_busy()}, indent=2))
        return 0
    except Exception as exc:
        if args.command == "ssh-entry": print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")))
        else: print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
