class PeerError(RuntimeError):
    pass


def backup_admin_credential() -> dict[str, str]:
    """Return the locally managed appliance-access credential to an authenticated admin."""
    try:
        value = json.loads(BACKUP_ADMIN_CREDENTIAL_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError) as exc:
        raise PeerError("backup-admin credential is not initialized") from exc
    username = str(value.get("username", ""))
    password = str(value.get("password", ""))
    if username != "backup-admin" or not password:
        raise PeerError("backup-admin credential is invalid")
    return {"username": username, "password": password}


def run(argv: list[str], *, check: bool = True, input_data: bytes | None = None,
        timeout: int | None = None,
        env: dict[str, str] | None = None) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(argv, input=input_data, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, check=check, timeout=timeout,
                              env=env)
    except FileNotFoundError as exc:
        raise PeerError(f"required command is missing: {argv[0]}") from exc
    except subprocess.CalledProcessError as exc:
        detail = exc.stderr.decode(errors="replace").strip()
        raise PeerError(f"{' '.join(argv)} failed: {detail or exc.returncode}") from exc


def atomic_json(path: Path, value: Any, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


def load_json(path: Path, default: Any) -> Any:
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default
    except json.JSONDecodeError as exc:
        raise PeerError(f"invalid JSON in {path}: {exc}") from exc


def require_root() -> None:
    if os.geteuid() != 0:
        raise PeerError("run this command with sudo")


def default_config() -> dict[str, Any]:
    appliance_id = str(uuid.uuid4())
    numeric_id = 1_000_000_000 + (int(uuid.UUID(appliance_id)) % 8_000_000_000)
    return {
        "schema": 1, "version": VERSION, "appliance_id": appliance_id,
        "numeric_id": numeric_id, "name": socket.gethostname(), "ssh_port": 22,
        "pool": "homePool", "source_root": "homePool/home/agents",
        "peers": {}, "sources": {}, "assets": {},
    }


def config() -> dict[str, Any]:
    cfg = load_json(CONFIG_PATH, None)
    if not cfg:
        raise PeerError("not initialized; run: sudo recovera-peer init")
    return cfg


def state() -> dict[str, Any]:
    value = load_json(STATE_PATH, {"assets": {}, "events": [], "queue": {}})
    value.setdefault("assets", {})
    value.setdefault("events", [])
    value.setdefault("queue", {})
    return value


def appliance_name(cfg: dict[str, Any] | None = None) -> str:
    """The appliance's current device name.

    "Name the Device" sets the hostname; the configuration only captured the
    hostname at first boot ("recovera" on OVA deployments). Keep the stored
    name in step so pairing, metadata and status show the real name.
    """
    cfg = cfg if cfg is not None else config()
    current = socket.gethostname().split(".")[0].strip()[:128]
    if current and current != cfg.get("name"):
        cfg["name"] = current
        with contextlib.suppress(OSError, PeerError):
            stored = config()
            stored["name"] = current
            save_config(stored)
    return str(cfg.get("name") or current)


def _remember_name(section: str, key: str, name: Any) -> None:
    """Update the stored display name of a paired appliance when it changes."""
    if not isinstance(name, str) or not name.strip() or len(name) > 128:
        return
    with contextlib.suppress(OSError, PeerError):
        cfg = config()
        entry = cfg.get(section, {}).get(key)
        if entry is not None and entry.get("name") != name:
            entry["name"] = name
            save_config(cfg)


def save_config(cfg: dict[str, Any]) -> None:
    atomic_json(CONFIG_PATH, cfg)


def save_state(value: dict[str, Any]) -> None:
    value["events"] = value.get("events", [])[-200:]
    queue = value.setdefault("queue", {})
    if len(queue) > 1000:
        active = [(key, item) for key, item in queue.items()
                  if item.get("status") in ("queued", "syncing")]
        history = [(key, item) for key, item in queue.items()
                   if item.get("status") not in ("queued", "syncing")]
        history.sort(key=lambda entry: int(entry[1].get("updated", 0)), reverse=True)
        value["queue"] = dict(active + history[:max(0, 1000 - len(active))])
    atomic_json(STATE_PATH, value)


@contextlib.contextmanager
def locked_state() -> Any:
    """Serialize state.json read/modify/write operations across service processes."""
    STATE_LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with STATE_LOCK_PATH.open("a+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        value = state()
        yield value
        save_state(value)


def default_offsite() -> dict[str, Any]:
    speed = 0
    with contextlib.suppress(ValueError, OSError):
        # The appliance stores this value in KB/s. Its UI converts between
        # KB/s and Mb/s, so applying another factor here makes 10 Gbps appear
        # as 80 Mbps on the home page.
        speed = max(0, int(float(TX_SPEED_PATH.read_text().strip())))
    return {"schema": 1, "speed_kbps": speed, "max_syncs": 1,
            "next_schedule_id": 1, "schedules": []}


def offsite() -> dict[str, Any]:
    value = load_json(OFFSITE_PATH, default_offsite())
    value.setdefault("speed_kbps", 0)
    value.setdefault("max_syncs", 1)
    value.setdefault("next_schedule_id", 1)
    value.setdefault("schedules", [])
    return value


def save_offsite(value: dict[str, Any]) -> None:
    atomic_json(OFFSITE_PATH, value)


def schedule_speed(now: float | None = None) -> int:
    settings = offsite()
    current = time.localtime(now).tm_wday * 86400 + time.localtime(now).tm_hour * 3600 \
        + time.localtime(now).tm_min * 60 + time.localtime(now).tm_sec
    speed = int(settings.get("speed_kbps", 0))
    for item in settings.get("schedules", []):
        start, end = int(item["start"]), int(item["end"])
        active = start <= current < end if start < end else current >= start or current < end
        if active:
            speed = int(item["speed"])
    return speed


def weekly_averages() -> dict[str, Any]:
    settings = offsite()
    default_speed = int(settings.get("speed_kbps", 0))
    days: list[int] = []
    for day in range(7):
        total = 0
        for minute in range(1440):
            second = day * 86400 + minute * 60
            speed = default_speed
            for item in settings.get("schedules", []):
                start, end = int(item["start"]), int(item["end"])
                active = start <= second < end if start < end else second >= start or second < end
                if active:
                    speed = int(item["speed"])
            if speed > 0:
                total += speed * 60
        days.append(total)
    return {"days": days, "avgWeek": sum(days) // 7, "totalWeek": sum(days)}


def schedule_add(start: int, end: int, speed: int) -> dict[str, Any]:
    if not 0 <= start < 604800 or not 0 <= end < 604800 or start == end:
        raise PeerError("schedule times must be different seconds within a week")
    if speed < -1 or speed > 125_000_000:
        raise PeerError("schedule speed is outside the supported range")
    settings = offsite()
    item = {"schedID": int(settings["next_schedule_id"]), "start": start,
            "end": end, "speed": speed}
    settings["next_schedule_id"] = item["schedID"] + 1
    settings["schedules"].append(item)
    save_offsite(settings)
    return item


def schedule_delete(schedule_id: int) -> None:
    settings = offsite()
    original = len(settings["schedules"])
    settings["schedules"] = [item for item in settings["schedules"]
                             if int(item["schedID"]) != schedule_id]
    if len(settings["schedules"]) == original:
        raise PeerError("schedule does not exist")
    save_offsite(settings)


def set_speed(speed_kbps: int) -> int:
    if not 0 <= speed_kbps <= 125_000_000:
        raise PeerError("upload speed is outside the supported range")
    settings = offsite()
    settings["speed_kbps"] = speed_kbps
    save_offsite(settings)
    TX_SPEED_PATH.parent.mkdir(parents=True, exist_ok=True)
    TX_SPEED_PATH.write_text(f"{speed_kbps}\n", encoding="ascii")
    return speed_kbps


def event(kind: str, message: str, **fields: Any) -> None:
    with locked_state() as value:
        value.setdefault("events", []).append(
            {"time": int(time.time()), "kind": kind, "message": message, **fields}
        )


def fingerprint_der(cert_der: bytes) -> str:
    digest = hashlib.sha256(cert_der).hexdigest().upper()
    return "SHA256:" + ":".join(digest[i:i + 2] for i in range(0, len(digest), 2))


def gateway_tls_fingerprint() -> str:
    """Fingerprint the certificate clients see on the appliance HTTPS site."""
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    try:
        with socket.create_connection(("127.0.0.1", 443), timeout=5) as raw:
            with context.wrap_socket(raw, server_hostname="localhost") as wrapped:
                return fingerprint_der(wrapped.getpeercert(binary_form=True))
    except OSError:
        # Apache may not be running during the first installation pass.
        return local_tls_fingerprint()


def local_tls_fingerprint() -> str:
    pem = APACHE_TLS_CERT_PATH.read_text(encoding="ascii")
    return fingerprint_der(ssl.PEM_cert_to_DER_cert(pem))


def ssh_public_key() -> str:
    return SSH_KEY_PATH.with_suffix(".pub").read_text(encoding="ascii").strip()


def ssh_host_keys() -> list[str]:
    keys: list[str] = []
    for path in sorted(Path("/etc/ssh").glob("ssh_host_*_key.pub")):
        parts = path.read_text(encoding="ascii").strip().split()
        if len(parts) >= 2 and parts[0] in SUPPORTED_SSH_HOST_KEY_TYPES:
            keys.append(f"{parts[0]} {parts[1]}")
    return keys


def init() -> None:
    require_root()
    ETC.mkdir(mode=0o700, parents=True, exist_ok=True)
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    repair_replication_account_permissions()
    if not CONFIG_PATH.exists():
        save_config(default_config())
    if not STATE_PATH.exists():
        save_state({"assets": {}, "events": []})
    if not SSH_KEY_PATH.exists():
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C",
             f"recovera-peer@{socket.gethostname()}", "-f", str(SSH_KEY_PATH)])
    KNOWN_HOSTS_PATH.touch(mode=0o600, exist_ok=True)
    if not OFFSITE_PATH.exists():
        atomic_json(OFFSITE_PATH, default_offsite())
    # Keep the legacy appliance value in the same KB/s unit as Recovera's
    # scheduler so the native off-site and home pages render the same limit.
    set_speed(int(offsite()["speed_kbps"]))
    if not WEB_TOKEN_PATH.exists():
        WEB_TOKEN_PATH.write_text(secrets.token_urlsafe(48) + "\n", encoding="ascii")
    os.chmod(WEB_TOKEN_PATH, 0o640)
    with contextlib.suppress(KeyError, PermissionError):
        os.chown(WEB_TOKEN_PATH, 0, grp.getgrnam("www-data").gr_gid)
    print(f"Recovera peer replication initialized ({config()['appliance_id']})")
    print(f"Pairing HTTPS fingerprint: {gateway_tls_fingerprint()}")


def repair_replication_account_permissions() -> None:
    """Keep the restricted SSH account usable if system UIDs are reassigned."""
    try:
        import pwd
        account = pwd.getpwnam("recovera-repl")
    except (ImportError, KeyError):
        return
    paths = (
        (STATE_DIR, 0o700),
        (authorized_keys_path().parent, 0o700),
        (authorized_keys_path(), 0o600),
    )
    for path, mode in paths:
        if path.exists():
            os.chown(path, account.pw_uid, account.pw_gid)
            os.chmod(path, mode)


def validate_asset(asset: str) -> str:
    if not ASSET_RE.fullmatch(asset):
        raise PeerError("asset key must be exactly 32 hexadecimal characters")
    return asset.lower()


def validate_snapshot(snapshot: str) -> str:
    if not SNAPSHOT_RE.fullmatch(snapshot):
        raise PeerError("snapshot name must be a numeric recovery-point epoch")
    return snapshot


def dataset_for(cfg: dict[str, Any], asset: str) -> str:
    return f"{cfg['source_root'].rstrip('/')}/{validate_asset(asset)}"


def zfs_exists(name: str) -> bool:
    return run(["zfs", "list", "-H", "-o", "name", name], check=False).returncode == 0


def zfs_snapshots(dataset: str) -> list[str]:
    result = run(["zfs", "list", "-H", "-t", "snapshot", "-o", "name",
                  "-s", "creation", "-r", dataset], check=False)
    if result.returncode != 0:
        return []
    values, prefix = [], dataset + "@"
    for line in result.stdout.decode().splitlines():
        if line.startswith(prefix) and SNAPSHOT_RE.fullmatch(line[len(prefix):]):
            values.append(line[len(prefix):])
    return values


