    return load_json(KEYS_DIR / f"{asset}.originDevice", {})


def serialized_string(data: bytes, key: str) -> str | None:
    """Read one string field from the appliance's PHP-serialized metadata."""
    marker = f's:{len(key.encode("utf-8"))}:"{key}";s:'.encode()
    start = data.find(marker)
    if start < 0:
        return None
    length_start = start + len(marker)
    length_end = data.find(b':"', length_start)
    if length_end < 0 or not data[length_start:length_end].isdigit():
        return None
    size = int(data[length_start:length_end])
    value_start = length_end + 2
    value = data[value_start:value_start + size]
    if data[value_start + size:value_start + size + 2] != b'";':
        return None
    return value.decode("utf-8", errors="replace")


def asset_identifiers(asset: str) -> set[str]:
    path = KEYS_DIR / f"{validate_asset(asset)}.agentInfo"
    try:
        raw = path.read_bytes()
    except OSError:
        return set()
    values: list[Any] = []
    with contextlib.suppress(json.JSONDecodeError, UnicodeDecodeError):
        document = json.loads(raw.decode("utf-8"))
        if isinstance(document, dict):
            values.extend(document.get(key) for key in ("name", "hostname", "uuid", "keyName"))
    values.extend(serialized_string(raw, key) for key in ("name", "hostname", "uuid", "keyName"))
    return {str(value).strip().casefold() for value in values if value}


def agent_info_display_name(raw: bytes) -> str | None:
    with contextlib.suppress(json.JSONDecodeError, UnicodeDecodeError):
        document = json.loads(raw.decode("utf-8"))
        if isinstance(document, dict):
            for key in ("name", "hostname"):
                if document.get(key):
                    return str(document[key])
    return serialized_string(raw, "name") or serialized_string(raw, "hostname")


def asset_display_name(asset: str) -> str:
    path = KEYS_DIR / f"{validate_asset(asset)}.agentInfo"
    try:
        raw = path.read_bytes()
    except OSError:
        return asset
    return agent_info_display_name(raw) or asset


def metadata_display_name(metadata: dict[str, Any]) -> str | None:
    """Name a replicated asset from its incoming agentInfo before installation."""
    encoded = (metadata.get("files") or {}).get("agentInfo")
    if not isinstance(encoded, str):
        return None
    with contextlib.suppress(ValueError):
        return agent_info_display_name(base64.b64decode(encoded))
    return None


def agent_address(asset: str) -> str:
    """Resolve an active agent address without trusting a display name."""
    asset = validate_asset(asset)
    path = KEYS_DIR / f"{asset}.agentInfo"
    try:
        raw = path.read_bytes()
    except OSError:
        raw = b""
    with contextlib.suppress(json.JSONDecodeError, UnicodeDecodeError):
        document = json.loads(raw.decode("utf-8"))
        if isinstance(document, dict):
            for key in ("ipv4Address", "ipAddress", "ip", "pairedBy"):
                candidate = str(document.get(key, "")).strip()
                if candidate and HOST_RE.fullmatch(candidate):
                    return candidate
    for key in ("ipv4Address", "ipAddress", "ip", "pairedBy"):
        candidate = serialized_string(raw, key)
        if candidate and HOST_RE.fullmatch(candidate):
            return candidate
    result = run(["snapctl", "agent:list"], check=False, timeout=15)
    for line in result.stdout.decode("utf-8", "replace").splitlines():
        columns = [column.strip() for column in line.strip().strip("|").split("|")]
        if len(columns) >= 2 and columns[0].casefold() == asset.casefold():
            candidate = columns[1]
            if HOST_RE.fullmatch(candidate):
                return candidate
    raise PeerError("could not determine the protected agent's network address")


def release_agent(asset: str) -> dict[str, Any]:
    """Ask the currently owned agent to forget this appliance before removal."""
    require_root()
    address = agent_address(asset)
    certs = AGENT_CERT_DIR
    certificates = sorted(certs.glob("*_device.pem"))
    keys = sorted(certs.glob("*_device.key"))
    authorities = sorted(certs.glob("*_dattoAgentCaCert.crt"))
    if not certificates or not keys or not authorities:
        raise PeerError("Recovera agent pairing certificates are not installed")
    try:
        device_id = int(DEVICE_ID_PATH.read_text(encoding="ascii").strip())
        context = ssl.create_default_context(ssl.Purpose.SERVER_AUTH, cafile=str(authorities[-1]))
        context.check_hostname = False
        context.load_cert_chain(str(certificates[-1]), str(keys[-1]))
        connection = http.client.HTTPSConnection(
            address, AGENT_TRANSFER_PORT, context=context, timeout=15
        )
        payload = json.dumps({"device_id": device_id}).encode("utf-8")
        connection.request("POST", "/v1/release", body=payload,
                           headers={"Content-Type": "application/json"})
        response = connection.getresponse()
        raw = response.read(65536)
        connection.close()
        value = json.loads(raw.decode("utf-8"))
    except (OSError, ssl.SSLError, http.client.HTTPException, json.JSONDecodeError) as exc:
        raise PeerError(
            "the agent could not be released automatically; update its Recovera agent tools "
            "or run 'sudo recovera-agent-transfer release' on the protected system before removing it"
        ) from exc
    if response.status != 200:
        raise PeerError(str(value.get("error") or "the agent refused its ownership release"))
    event("agent-released", f"Released protected agent {asset}", asset=asset, address=address)
    return value | {"asset": asset, "address": address}


def _command_text(argv: list[str], *, timeout: int = 15) -> str:
    return run(argv, timeout=timeout).stdout.decode("utf-8", "replace").strip()


def _pool_leaf(pool: str) -> Path:
    output = _command_text(["zpool", "status", "-P", "-L", pool])
    devices = []
    for line in output.splitlines():
        fields = line.split()
        if fields and fields[0].startswith("/dev/"):
            devices.append(Path(os.path.realpath(fields[0])))
    if len(devices) != 1:
        raise PeerError(
            f"automatic expansion requires {pool} to contain exactly one data device"
        )
    if not devices[0].is_block_device():
        raise PeerError(f"{pool} has an invalid backing device: {devices[0]}")
    return devices[0]


def _disk_partitions(disk: Path) -> list[dict[str, Any]]:
    output = _command_text(["lsblk", "-n", "-r", "-p", "-o", "PATH,TYPE", str(disk)])
    partitions = []
    for line in output.splitlines():
        fields = line.split()
        if len(fields) != 2 or fields[1] != "part":
            continue
        path = Path(fields[0])
        number = _partition_number(path)
        type_result = run(
            ["blkid", "-p", "-s", "PART_ENTRY_TYPE", "-o", "value", str(path)],
            check=False, timeout=15,
        )
        partitions.append({
            "path": str(path), "number": number,
            "type": type_result.stdout.decode("ascii", "replace").strip().casefold(),
            "size": int(_command_text(["blockdev", "--getsize64", str(path)])),
        })
    return partitions


def _disk_partition_table(disk: Path) -> list[dict[str, Any]]:
    """Read the on-disk GPT, which can be newer than the live kernel view."""
    try:
        table = json.loads(_command_text(["sfdisk", "--json", str(disk)]))["partitiontable"]
        sector_size = int(table["sectorsize"])
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
        raise PeerError(f"could not read the partition table on {disk}") from exc
    result = []
    prefix = disk.name
    for item in table.get("partitions", []):
        path = Path(str(item.get("node", "")))
        name = path.name
        suffix = name[len(prefix):] if name.startswith(prefix) else ""
        if suffix.startswith("p"):
            suffix = suffix[1:]
        if not suffix.isdigit():
            raise PeerError(f"could not identify partition number for {path}")
        result.append({
            "path": str(path), "number": int(suffix),
            "type": str(item.get("type", "")).casefold(),
            "size": int(item["size"]) * sector_size,
        })
    return result


def _partition_number(path: Path) -> int:
    value = Path("/sys/class/block") / path.name / "partition"
    try:
        number = value.read_text(encoding="ascii").strip()
    except OSError as exc:
        raise PeerError(f"could not identify partition number for {path}") from exc
    if not number.isdigit():
        raise PeerError(f"invalid partition number for {path}")
    return int(number)


def _backing_disk(path: Path) -> Path:
    output = _command_text([
        "lsblk", "-s", "-n", "-r", "-p", "-o", "PATH,TYPE", str(path),
    ])
    disks = [Path(fields[0]) for line in output.splitlines()
             if len(fields := line.split()) == 2 and fields[1] == "disk"]
    if len(disks) != 1:
        raise PeerError(f"could not resolve one physical disk behind {path}")
    return disks[0]


def storage_expand_status() -> dict[str, Any]:
    """Describe the supported Recovera backup pool without changing storage."""
    require_root()
    pool = str(config().get("pool") or "homePool")
    fields = _command_text(["zpool", "list", "-H", "-p", "-o",
                            "size,alloc,free,health", pool]).split()
    if len(fields) != 4:
        raise PeerError(f"could not read {pool} capacity")
    base = {
        "pool": pool,
        "pool_size": int(fields[0]), "allocated": int(fields[1]),
        "free": int(fields[2]), "health": fields[3],
        "device": None, "disk": None, "disk_size": 0, "partition_size": 0,
        "partition_table_size": 0, "partition_number": None,
        "expandable": False, "supported": False,
        "unsupported_partitions": [], "reserved_partition": None,
    }
    try:
        leaf = _pool_leaf(pool)
        if _command_text(["lsblk", "-d", "-n", "-r", "-o", "TYPE", str(leaf)]) != "part":
            raise PeerError(f"automatic expansion requires {pool} to use a disk partition")
        part_number = _partition_number(leaf)
        disk = _backing_disk(leaf)
        root_source = _command_text(["findmnt", "-n", "-o", "SOURCE", "/"])
        root_disk = _backing_disk(Path(root_source))
        if disk == root_disk:
            raise PeerError("refusing to expand the operating-system disk")
        table = _disk_partition_table(disk)
        selected = next((item for item in table if item["number"] == part_number), None)
        if not selected:
            raise PeerError(f"could not inspect {leaf}")
        other = [item for item in table if item["number"] != part_number]
        supported_reserved = [item for item in other if
                              item["number"] == 9 and
                              item["type"] == ZFS_RESERVED_PARTITION_TYPE and
                              item["size"] <= 32 * 1024 * 1024]
        unsupported = [item for item in other if item not in supported_reserved]
        disk_size = int(_command_text(["blockdev", "--getsize64", str(disk)]))
        partition_size = int(_command_text(["blockdev", "--getsize64", str(leaf)]))
    except PeerError as exc:
        return base | {"reason": str(exc)}
    return base | {
        "device": str(leaf), "disk": str(disk),
        "disk_size": disk_size, "partition_size": partition_size,
        "partition_table_size": selected["size"],
        "partition_number": part_number,
        "expandable": disk_size - partition_size >= MIN_STORAGE_GROWTH,
        "supported": fields[3] == "ONLINE" and part_number == 1
            and not unsupported,
        "unsupported_partitions": [item["path"] for item in unsupported],
        "reserved_partition": supported_reserved[0]["path"] if supported_reserved else None,
        "reason": None if fields[3] == "ONLINE" and part_number == 1 and not unsupported
            else "Automatic expansion is available only for an ONLINE, single-disk Recovera backup pool.",
    }


def _rescan_storage_disk(disk: Path) -> None:
    rescan = Path("/sys/class/block") / disk.name / "device" / "rescan"
    if not rescan.is_file():
        raise PeerError(f"the storage controller does not support rescanning {disk}")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", disk.name):
        raise PeerError("invalid storage device name")
    # recovera-peer deliberately runs with ProtectKernelTunables=true, which
    # makes sysfs read-only. Ask PID 1 to run a tightly sandboxed one-shot unit
    # with only this already validated rescan control writable; do not weaken
    # the long-running HTTP service's mount namespace.
    run([
        "systemd-run", "--quiet", "--wait", "--pipe", "--collect",
        f"--unit=recovera-storage-rescan-{disk.name}",
        "--property=ProtectSystem=strict",
        "--property=ProtectKernelTunables=true",
        f"--property=ReadWritePaths={rescan}",
        "--property=PrivateTmp=true",
        "--property=RestrictAddressFamilies=AF_UNIX",
        "/usr/bin/tee", str(rescan),
    ], input_data=b"1\n", timeout=30)
    run(["udevadm", "settle"], timeout=30)


def expand_storage() -> dict[str, Any]:
    """Grow the single-disk Recovera ZFS pool into newly provisioned space."""
    require_root()
    with storage_expand_lock():
        before = storage_expand_status()
        if before["health"] != "ONLINE":
            raise PeerError("backup storage must be ONLINE before it can be expanded")
        if not before["supported"]:
            raise PeerError(before.get("reason") or
                            "this backup-storage layout cannot be expanded automatically")
        disk = Path(before["disk"])
        _rescan_storage_disk(disk)
        detected = storage_expand_status()
        if not detected["expandable"]:
            return detected | {
                "changed": False,
                "message": "No additional disk capacity was detected. Increase the backup disk in the hypervisor, then try again.",
            }

        if detected["disk_size"] - detected["partition_table_size"] >= MIN_STORAGE_GROWTH:
            backup_dir = STATE_DIR / "storage-gpt-backups"
            backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
            backup = backup_dir / (time.strftime("%Y%m%d-%H%M%S", time.gmtime()) +
                                   f"-{disk.name}.gpt")
            run(["sgdisk", f"--backup={backup}", str(disk)], timeout=30)
            os.chmod(backup, 0o600)
            run(["sgdisk", "--move-second-header", str(disk)], timeout=30)
            if detected["reserved_partition"]:
                run(["sgdisk", "--delete=9", str(disk)], timeout=30)
            growth = run(["growpart", str(disk), str(detected["partition_number"])],
                         check=False, timeout=120)
            refreshed = _disk_partition_table(disk)
            table_partition = next((item for item in refreshed
                                    if item["number"] == detected["partition_number"]), None)
            if (not table_partition or
                    table_partition["size"] <= detected["partition_table_size"]):
                detail = growth.stderr.decode("utf-8", "replace").strip()
                raise PeerError(f"could not expand the backup partition: {detail or growth.returncode}")

        # growpart may have updated the GPT successfully but failed to refresh
        # an in-use partition in the kernel. Reconcile that state explicitly.
        run(["partx", "--update", "--nr", str(detected["partition_number"]), str(disk)],
            timeout=30)
        run(["partprobe", str(disk)], check=False, timeout=30)
        run(["udevadm", "settle"], timeout=30)
        kernel_ready = storage_expand_status()
        if (kernel_ready["partition_table_size"] - kernel_ready["partition_size"] >=
                MIN_STORAGE_GROWTH):
            raise PeerError("the partition table was expanded, but the running kernel still reports the old size; reboot the appliance and try again")
        run(["zpool", "online", "-e", detected["pool"], detected["device"]],
            timeout=120)
        run(["zpool", "set", "autoexpand=on", detected["pool"]], timeout=30)
        after = storage_expand_status()
        if after["pool_size"] <= before["pool_size"]:
            raise PeerError(
                "the disk partition was expanded, but ZFS did not report additional capacity"
            )
        event("storage-expanded", f"Expanded {detected['pool']} to {after['pool_size']} bytes",
              pool=detected["pool"], before=before["pool_size"], after=after["pool_size"])
        return after | {
            "changed": True, "previous_pool_size": before["pool_size"],
            "message": "Backup storage expanded successfully.",
        }


def protected_asset_keys() -> list[str]:
    found: list[str] = []
    for path in KEYS_DIR.glob("*.agentInfo"):
        asset = path.name[:-len(".agentInfo")].lower()
        if ASSET_RE.fullmatch(asset) and not load_origin(asset).get("isReplicated"):
            found.append(asset)
    return sorted(set(found))


def assets_local(cfg: dict[str, Any]) -> list[dict[str, Any]]:
    root = cfg["source_root"].rstrip("/")
    result = run(["zfs", "list", "-H", "-t", "filesystem", "-o", "name", "-r", root], check=False)
    datasets: dict[str, str] = {}
    if result.returncode == 0:
        for line in result.stdout.decode().splitlines()[1:]:
            key = line.rsplit("/", 1)[-1].lower()
            if ASSET_RE.fullmatch(key):
                datasets[key] = line
    found: list[dict[str, Any]] = []
    for key in sorted(set(datasets) | set(protected_asset_keys())):
        origin = load_origin(key)
        dataset = datasets.get(key, f"{root}/{key}")
        found.append({"key": key, "name": asset_display_name(key), "dataset": dataset,
                      "snapshots": zfs_snapshots(dataset) if key in datasets else [],
                      "replicated": bool(origin.get("isReplicated")), "origin": origin})
    return found


def collect_metadata(asset: str, cfg: dict[str, Any]) -> dict[str, Any]:
    files: dict[str, str] = {}
    total = 0
    for suffix in METADATA_SUFFIXES:
        path = KEYS_DIR / f"{asset}.{suffix}"
        if not path.is_file():
            continue
        data = path.read_bytes()
        total += len(data)
        if total > MAX_METADATA_BYTES:
            raise PeerError(f"metadata for {asset} exceeds {MAX_METADATA_BYTES} bytes")
        files[suffix] = base64.b64encode(data).decode("ascii")
    rule = cfg.get("assets", {}).get(asset, {})
    retention_hours = int(rule.get("retention_hours", MAX_RETENTION_HOURS))
    retention_tiers = rule.get("retention_tiers") or default_retention_tiers(retention_hours)
    return {"schema": 1, "asset": asset, "source_id": cfg["appliance_id"],
            "source_numeric_id": cfg["numeric_id"], "source_name": appliance_name(cfg),
            "source_public_key": ssh_public_key(), "files": files,
            "retention_hours": retention_hours, "retention_tiers": retention_tiers}


def default_retention_tiers(retention_hours: int) -> dict[str, int]:
    """SIRIS-style thinning boundaries expressed as cumulative hours."""
    return {
        "intra_daily": min(retention_hours, 7 * 24),
        "daily": min(retention_hours, 14 * 24),
        "weekly": min(retention_hours, 6 * 7 * 24),
    }


def validate_retention_tiers(retention_hours: int, tiers: Any) -> dict[str, int]:
    if not isinstance(tiers, dict):
        tiers = default_retention_tiers(retention_hours)
    result = {key: int(tiers.get(key, value)) for key, value in
              default_retention_tiers(retention_hours).items()}
    if not (0 <= result["intra_daily"] <= result["daily"] <=
            result["weekly"] <= retention_hours):
        raise PeerError("target retention tiers are invalid")
    return result


def prune_received_snapshots(dataset: str, retention_hours: int,
                             retention_tiers: dict[str, int] | None = None,
                             now: int | None = None) -> list[str]:
    if not MIN_RETENTION_HOURS <= retention_hours <= MAX_RETENTION_HOURS:
        raise PeerError("target retention is outside the supported range")
    tiers = validate_retention_tiers(retention_hours, retention_tiers)
    snapshots = zfs_snapshots(dataset)
    if len(snapshots) < 2:
        return []
    current = int(now if now is not None else time.time())
    cutoff = current - retention_hours * 3600
    keep = {snapshots[-1]}
    buckets: dict[tuple[Any, ...], str] = {}
    for snapshot in snapshots[:-1]:
        epoch = int(snapshot)
        age_hours = max(0, (current - epoch) // 3600)
        stamp = time.gmtime(epoch)
        if epoch < cutoff:
            continue
        if age_hours <= tiers["intra_daily"]:
            keep.add(snapshot)
            continue
        if age_hours <= tiers["daily"]:
            bucket: tuple[Any, ...] = ("day", stamp.tm_year, stamp.tm_yday)
        elif age_hours <= tiers["weekly"]:
            iso = time.strftime("%G-%V", stamp)
            bucket = ("week", iso)
        else:
            bucket = ("month", stamp.tm_year, stamp.tm_mon)
        if int(buckets.get(bucket, "0")) < epoch:
            buckets[bucket] = snapshot
    keep.update(buckets.values())
    expired = [snapshot for snapshot in snapshots[:-1] if snapshot not in keep]
    for snapshot in expired:
        asset = dataset.rsplit("/", 1)[-1]
        run(["snapctl", "asset:recoverypoints:local:destroy", asset, snapshot])
    return expired


def install_metadata(asset: str, metadata: dict[str, Any]) -> None:
    if metadata.get("asset") != asset:
        raise PeerError("metadata asset does not match the receive request")
    files = metadata.get("files")
    if not isinstance(files, dict):
        raise PeerError("metadata files are missing")
    KEYS_DIR.mkdir(parents=True, exist_ok=True)
    for suffix, encoded in files.items():
        if suffix not in METADATA_SUFFIXES or not isinstance(encoded, str):
            raise PeerError(f"unapproved metadata key: {suffix}")
        data = base64.b64decode(encoded, validate=True)
        if len(data) > MAX_METADATA_BYTES:
            raise PeerError("individual metadata file is too large")
        target = KEYS_DIR / f"{asset}.{suffix}"
        fd, tmp = tempfile.mkstemp(prefix=f".{target.name}.", dir=str(KEYS_DIR))
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(tmp, 0o640)
            os.replace(tmp, target)
        finally:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(tmp)
    origin = {"deviceId": int(metadata["source_numeric_id"]), "resellerId": None,
              "isReplicated": True, "isOrphaned": False,
              "sourceApplianceId": metadata["source_id"],
              "sourceApplianceName": metadata["source_name"]}
    atomic_json(KEYS_DIR / f"{asset}.originDevice", origin, 0o640)


def pairing_code(minutes: int) -> str:
    require_root()
    if minutes < 1 or minutes > 60:
        raise PeerError("pairing-code lifetime must be between 1 and 60 minutes")
    raw = base64.b32encode(secrets.token_bytes(10)).decode("ascii").rstrip("=")
    code = "-".join(raw[i:i + 4] for i in range(0, len(raw), 4))
    salt = secrets.token_bytes(16)
    digest = hashlib.scrypt(code.encode(), salt=salt, n=2**14, r=8, p=1)
    atomic_json(PAIRING_PATH, {"salt": base64.b64encode(salt).decode(),
                               "digest": base64.b64encode(digest).decode(),
                               "expires": int(time.time()) + minutes * 60})
    return code


def consume_pairing_code(code: str) -> None:
    record = load_json(PAIRING_PATH, None)
    if not record or int(record.get("expires", 0)) < time.time():
        raise PeerError("pairing code is missing or expired")
    salt, expected = base64.b64decode(record["salt"]), base64.b64decode(record["digest"])
    actual = hashlib.scrypt(code.upper().encode(), salt=salt, n=2**14, r=8, p=1)
    if not hmac.compare_digest(actual, expected):
        raise PeerError("pairing code is invalid")
    PAIRING_PATH.unlink(missing_ok=True)


def ssl_json(host: str, port: int, path: str, payload: dict[str, Any] | None = None,
             expected_fingerprint: str | None = None) -> tuple[dict[str, Any], str]:
    if not HOST_RE.fullmatch(host):
        raise PeerError("peer host contains invalid characters")
    if not 1 <= port <= 65535:
        raise PeerError("peer port must be between 1 and 65535")
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    data = None if payload is None else json.dumps(payload).encode()
    connection = http.client.HTTPSConnection(host, port, timeout=15, context=context)
    try:
        connection.connect()
        if connection.sock is None:
            raise PeerError("peer closed the TLS connection before identification")
        cert = connection.sock.getpeercert(binary_form=True)
        fingerprint = fingerprint_der(cert)
        if expected_fingerprint and fingerprint != expected_fingerprint.upper():
            raise PeerError(
                f"peer TLS fingerprint changed: expected {expected_fingerprint}, got {fingerprint}"
            )
        connection.request("GET" if data is None else "POST", path, body=data,
                           headers={"Content-Type": "application/json", "Accept": "application/json"})
        response = connection.getresponse()
        raw = response.read()
        body = json.loads(raw.decode())
        if not isinstance(body, dict):
            raise PeerError("peer response is not a JSON object")
        if response.status >= 400:
            raise PeerError(str(body.get("error", f"HTTP {response.status}")))
    except (TimeoutError, OSError, http.client.HTTPException, json.JSONDecodeError) as exc:
        raise PeerError(f"could not contact peer {host}:{port}: {exc}") from exc
    finally:
        connection.close()
    if body.get("error"):
        raise PeerError(str(body["error"]))
    return body, fingerprint


def public_info() -> dict[str, Any]:
    cfg = config()
    result = run(["zpool", "list", "-Hp", "-o", "size,alloc,free,health", cfg["pool"]], check=False)
    storage: dict[str, Any] = {"available": False}
    if result.returncode == 0:
        size, allocated, free, health = result.stdout.decode().strip().split("\t")
        storage = {"available": True, "size": int(size), "allocated": int(allocated),
                   "free": int(free), "health": health}
    return {"service": "recovera-peer", "version": VERSION,
            "appliance_id": cfg["appliance_id"], "numeric_id": cfg["numeric_id"],
            "name": appliance_name(cfg), "ssh_port": cfg["ssh_port"],
            "tls_fingerprint": gateway_tls_fingerprint(), "ssh_host_keys": ssh_host_keys(),
            "gateway": "/recovera-peer", "gateway_port": 443,
            "storage": storage}


def authorized_keys_path() -> Path:
    return AUTHORIZED_KEYS_PATH


def authorize_source(source_id: str, name: str, public_key: str, address: str) -> None:
    if not ID_RE.fullmatch(source_id):
        raise PeerError("source appliance ID is invalid")
    parts = public_key.strip().split()
    if len(parts) < 2 or parts[0] != "ssh-ed25519" or not re.fullmatch(r"[A-Za-z0-9+/=]+", parts[1]):
        raise PeerError("source replication key is not a valid Ed25519 public key")
    path = authorized_keys_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    existing = path.read_text(encoding="ascii").splitlines() if path.exists() else []
    marker = f"recovera-source={source_id}"
    legacy_marker = f"backops-source={source_id}"
    existing = [line for line in existing if marker not in line and legacy_marker not in line]
    forced = f"/usr/bin/sudo -n /usr/local/sbin/recovera-peer ssh-entry {source_id}"
    existing.append(f'restrict,command="{forced}" {parts[0]} {parts[1]} {marker}')
    path.write_text("\n".join(existing) + "\n", encoding="ascii")
    os.chmod(path, 0o600)
    with contextlib.suppress(KeyError):
        import pwd
        account = pwd.getpwnam("recovera-repl")
        os.chown(path.parent, account.pw_uid, account.pw_gid)
        os.chown(path, account.pw_uid, account.pw_gid)
    cfg = config()
    cfg.setdefault("sources", {})[source_id] = {
        "name": name[:128], "address": address, "paired_at": int(time.time()),
        "public_key_fingerprint": hashlib.sha256(parts[1].encode()).hexdigest()}
    save_config(cfg)
    event("paired-source", f"Paired source {name}", source_id=source_id, address=address)


def pair_accept(payload: dict[str, Any], address: str) -> dict[str, Any]:
    required = ("code", "source_id", "source_name", "source_public_key")
    if any(not isinstance(payload.get(key), str) for key in required):
        raise PeerError("pairing request is incomplete")
    if not ID_RE.fullmatch(payload["source_id"]):
        raise PeerError("source appliance ID is invalid")
    if payload["source_id"] == config()["appliance_id"]:
        raise PeerError("an appliance cannot replicate to itself")
    consume_pairing_code(payload["code"])
    authorize_source(payload["source_id"], payload["source_name"], payload["source_public_key"], address)
    return public_info()


def known_host_lines(host: str, port: int, keys: list[str]) -> list[str]:
    prefix = host if port == 22 else f"[{host}]:{port}"
    lines = []
    for key in keys:
        parts = key.split()
        if "\n" in key or "\r" in key or len(parts) < 2:
            raise PeerError("target returned an invalid SSH host key")
        # Older Recovera images may still advertise an ssh-dss host key beside
        # their modern keys. OpenSSH no longer accepts DSS, so ignore unsupported
        # algorithms without discarding the valid ED25519/ECDSA/RSA keys.
        if parts[0] not in SUPPORTED_SSH_HOST_KEY_TYPES:
            continue
        if not re.fullmatch(r"[A-Za-z0-9+/=]+", parts[1]):
            raise PeerError("target returned an invalid SSH host key")
        lines.append(f"{prefix} {parts[0]} {parts[1]}")
    if not lines:
        raise PeerError("target did not provide a supported SSH host key")
    return lines


def peer_add(host: str, port: int, code: str, fingerprint: str,
             discovered: dict[str, Any] | None = None) -> dict[str, Any]:
    cfg = config()
    prefix = "/recovera-peer"
    info, actual = ssl_json(host, port, prefix + "/info", expected_fingerprint=fingerprint)
    if discovered and info.get("appliance_id") != discovered.get("appliance_id"):
        raise PeerError("peer identity changed between discovery and pairing")
    response, _ = ssl_json(host, port, prefix + "/pair", {
        "code": code.upper(), "source_id": cfg["appliance_id"],
        "source_name": appliance_name(cfg), "source_public_key": ssh_public_key(),
    }, expected_fingerprint=actual)
    if response.get("appliance_id") != info.get("appliance_id"):
        raise PeerError("pairing response came from a different appliance")
    peer_id = str(response["appliance_id"])
    if not ID_RE.fullmatch(peer_id):
        raise PeerError("target appliance ID is invalid")
    if peer_id == cfg["appliance_id"]:
        raise PeerError("an appliance cannot replicate to itself")
    keys = response.get("ssh_host_keys") or []
    if not keys:
        raise PeerError("target did not provide SSH host keys")
    ssh_port = int(response.get("ssh_port", 22))
    if not 1 <= ssh_port <= 65535:
        raise PeerError("target SSH port is invalid")
    old = KNOWN_HOSTS_PATH.read_text(encoding="ascii").splitlines() if KNOWN_HOSTS_PATH.exists() else []
    prefixes = {host, f"[{host}]:{ssh_port}"}
    old = [line for line in old if not any(line.startswith(p + " ") for p in prefixes)]
    old.extend(known_host_lines(host, ssh_port, keys))
    KNOWN_HOSTS_PATH.write_text("\n".join(old) + "\n", encoding="ascii")
    os.chmod(KNOWN_HOSTS_PATH, 0o600)
    cfg.setdefault("peers", {})[peer_id] = {
        "name": response.get("name", host), "host": host, "port": port,
        "ssh_port": ssh_port, "tls_fingerprint": actual,
        "paired_at": int(time.time()), "enabled": True}
    save_config(cfg)
    event("paired-target", f"Paired target {response.get('name', host)}", peer_id=peer_id)
    return cfg["peers"][peer_id] | {"id": peer_id}


def ssh_base(peer: dict[str, Any]) -> list[str]:
    return ["ssh", "-T", "-i", str(SSH_KEY_PATH), "-p", str(peer["ssh_port"]),
            "-o", "BatchMode=yes", "-o", "IdentitiesOnly=yes",
            "-o", "StrictHostKeyChecking=yes", "-o", f"UserKnownHostsFile={KNOWN_HOSTS_PATH}",
            "-o", "ConnectTimeout=15", f"recovera-repl@{peer['host']}"]


def remote_json(peer: dict[str, Any], command: list[str]) -> dict[str, Any]:
    result = run(ssh_base(peer) + [shlex.join(command)], timeout=30)
    try:
        return json.loads(result.stdout.decode())
    except json.JSONDecodeError as exc:
        raise PeerError(f"target returned an invalid response: {result.stdout.decode(errors='replace')}") from exc


def encode_metadata(metadata: dict[str, Any]) -> str:
    raw = json.dumps(metadata, separators=(",", ":")).encode()
    if len(raw) > MAX_METADATA_BYTES * 2:
        raise PeerError("encoded metadata is too large")
    return base64.urlsafe_b64encode(raw).decode()


def local_stream_codecs() -> list[str]:
    """Transport codecs this appliance can both compress and decompress."""
    return [name for name, (compress, decompress) in STREAM_CODECS.items()
            if shutil.which(compress[0]) and shutil.which(decompress[0])]


def transfer_stream(send_command: list[str], peer: dict[str, Any], remote_command: list[str],
                    speed_kbps: int = 0,
                    on_start: Callable[[int], None] | None = None,
                    codec: str | None = None) -> None:
    sender = subprocess.Popen(send_command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    assert sender.stdout is not None
    if on_start:
        # Progress reporting must never interrupt the replication stream.
        with contextlib.suppress(Exception):
            on_start(sender.pid)
    stages = [sender]
    stream = sender.stdout

    def chain(argv: list[str]) -> None:
        nonlocal stream
        stage = subprocess.Popen(argv, stdin=stream, stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE)
        stream.close()
        assert stage.stdout is not None
        stages.append(stage)
        stream = stage.stdout

    if codec:
        # Compress before the limiter so an upload limit caps bytes on the wire.
        chain(STREAM_CODECS[codec][0])
    if speed_kbps > 0:
        chain(["pv", "-q", "-L", str(speed_kbps * 1024)])
    receiver = subprocess.Popen(ssh_base(peer) + [shlex.join(remote_command)], stdin=stream,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    stream.close()
    recv_out, recv_err = receiver.communicate()
    failed = receiver.returncode != 0
    stage_errors = []
    for stage in stages:
        stage_errors.append(stage.stderr.read() if stage.stderr else b"")
        failed = stage.wait() != 0 or failed
    if failed:
        details = (b"\n".join(stage_errors) + b"\n" + recv_err + b"\n" + recv_out).decode(errors="replace").strip()
        raise PeerError(f"snapshot transfer failed: {details}")
    try:
        answer = json.loads(recv_out.decode())
    except json.JSONDecodeError as exc:
        raise PeerError(f"target did not confirm the transfer: {recv_out.decode(errors='replace')}") from exc
    if not answer.get("ok"):
        raise PeerError(str(answer.get("error", "target rejected the transfer")))


def replicate(asset: str, peer_id: str, snapshot: str | None = None,
              speed_kbps: int = 0) -> dict[str, Any]:
    require_root()
    cfg = config()
    asset = validate_asset(asset)
    peer = cfg.get("peers", {}).get(peer_id)
    if not peer or not peer.get("enabled"):
        raise PeerError(f"peer is missing or disabled: {peer_id}")
    dataset = dataset_for(cfg, asset)
    if not zfs_exists(dataset):
        raise PeerError(f"source dataset does not exist: {dataset}")
    if load_origin(asset).get("isReplicated"):
        raise PeerError("a received replica cannot be used as a replication source")
    local = zfs_snapshots(dataset)
    if not local:
        raise PeerError(f"asset {asset} has no completed snapshots")
    snapshot = validate_snapshot(snapshot) if snapshot else local[-1]
    if snapshot not in local:
        raise PeerError(f"snapshot {snapshot} does not exist for {asset}")
    remote = remote_json(peer, ["asset-info", asset])
    _remember_name("peers", peer_id, remote.get("appliance_name"))
    offered = remote.get("stream_codecs") if isinstance(remote.get("stream_codecs"), list) else []
    codec = next((name for name in local_stream_codecs() if name in offered), None)
    if isinstance(remote.get("appliance_name"), str) and remote["appliance_name"].strip():
        peer = peer | {"name": remote["appliance_name"]}
    remote_snaps = [str(value) for value in remote.get("snapshots", [])]
    if snapshot in remote_snaps:
        now = int(time.time())
        with locked_state() as value:
            value.setdefault("assets", {})[f"{peer_id}:{asset}"] = {
                "last_success": now, "last_snapshot": snapshot,
                "mode": "already-present", "error": None,
                "consecutive_failures": 0, "next_retry": 0,
                "integrity": "target-confirmed"}
            value.setdefault("peers", {}).setdefault(peer_id, {}).update(
                {"last_contact": now, "status": "online",
                 "storage": remote.get("storage", {})}
            )
        return {"ok": True, "asset": asset, "snapshot": snapshot, "status": "already-present"}
    estimate = zfs_send_estimate(dataset, snapshot, local, remote.get("snapshots", []))
    free = int(remote.get("storage", {}).get("free", 0))
    reserve = max(5 * 1024**3, int(remote.get("storage", {}).get("size", 0)) // 20)
    if free and estimate + reserve > free:
        raise PeerError(
            f"target capacity preflight failed: need {estimate} bytes plus "
            f"{reserve} bytes reserve, only {free} bytes free"
        )
    resume_token = remote.get("resume_token")
    base: str | None = None
    bytes_before = 0
    stream_total = estimate
    if resume_token:
        # A resumed stream keeps the format it started with (compressed or
        # not), so measure it from the token itself rather than the estimate.
        remaining = zfs_send_resume_estimate(str(resume_token))
        bytes_before = resume_token_bytes(str(resume_token))
        if not bytes_before and estimate and 0 < remaining < estimate:
            bytes_before = estimate - remaining
        if remaining:
            stream_total = bytes_before + remaining
    payload = collect_metadata(asset, cfg)
    # Receivers ignore unknown keys; newer ones use this to show total progress.
    payload["transfer"] = {"bytes_total": int(stream_total)}
    metadata = encode_metadata(payload)
    if resume_token:
        send_command = ["zfs", "send", "-t", str(resume_token)]
        remote_command = ["receive-resume", asset, snapshot, metadata]
        mode = "resumed"
    else:
        common = [value for value in local if value in remote_snaps]
        if remote_snaps and not common:
            raise PeerError("target has no common base snapshot; a controlled reseed is required")
        if common:
            base = common[-1]
            send_command = ["zfs", "send", "-c", "-I", f"{dataset}@{base}", f"{dataset}@{snapshot}"]
            remote_command = ["receive", asset, snapshot, base, metadata]
            mode = f"incremental-from-{base}"
        else:
            # -c sends blocks as already compressed on disk: fewer bytes on the WAN.
            send_command = ["zfs", "send", "-c", f"{dataset}@{snapshot}"]
            remote_command = ["receive", asset, snapshot, "-", metadata]
            mode = "full"
    key = f"{peer_id}:{asset}"
    record = {
        "direction": "outbound", "asset": asset, "name": asset_display_name(asset),
        "peer_id": peer_id, "peer_name": str(peer.get("name") or peer.get("host") or peer_id),
        "snapshot": snapshot, "base": base, "mode": mode, "bytes_total": stream_total,
        "bytes_before": bytes_before, "started": int(time.time()), "pid": None,
    }

    def started(pid: int) -> None:
        record["pid"] = pid
        write_transfer_record("outbound", key, record)

    if codec:
        remote_command = remote_command + [codec]
        record["codec"] = codec
    try:
        transfer_stream(send_command, peer, remote_command, speed_kbps, on_start=started,
                        codec=codec)
    finally:
        clear_transfer_record("outbound", key)
    with locked_state() as value:
        value.setdefault("assets", {})[key] = {"last_success": int(time.time()),
            "last_snapshot": snapshot, "mode": mode, "error": None,
            "consecutive_failures": 0, "next_retry": 0,
            "bytes_estimated": estimate, "integrity": "zfs-stream-verified"}
        value.setdefault("peers", {}).setdefault(peer_id, {}).update(
            {"last_contact": int(time.time()), "status": "online",
             "storage": remote.get("storage", {})}
        )
    event("replication-success", f"Replicated {asset}@{snapshot}", asset=asset, peer_id=peer_id, mode=mode)
    return {"ok": True, "asset": asset, "snapshot": snapshot, "status": mode}


def zfs_send_estimate(dataset: str, snapshot: str, local: list[str],
                      remote_snapshots: list[Any]) -> int:
    """Ask ZFS for a conservative stream-size estimate before transfer."""
    common = [value for value in local if value in {str(item) for item in remote_snapshots}]
    command = ["zfs", "send", "-nP", "-c"]
    if common:
        command += ["-I", f"{dataset}@{common[-1]}"]
    command.append(f"{dataset}@{snapshot}")
    result = run(command, check=False, timeout=60)
    text = (result.stdout + result.stderr).decode(errors="replace")
    matches = re.findall(r"(?:size|total estimated size is)\s+([0-9]+)", text)
    return int(matches[-1]) if result.returncode == 0 and matches else 0


def zfs_send_resume_estimate(token: str) -> int:
    """Estimate the bytes still to send for a resumable stream (0 if unknown)."""
    result = run(["zfs", "send", "-nP", "-t", token], check=False, timeout=60)
    text = (result.stdout + result.stderr).decode(errors="replace")
    matches = re.findall(r"(?:size|total estimated size is)\s+([0-9]+)", text)
    return int(matches[-1]) if result.returncode == 0 and matches else 0


def receive_dataset(source_id: str, asset: str, snapshot: str, base: str,
                    encoded_metadata: str, resume: bool, stream: BinaryIO,
                    codec: str | None = None) -> dict[str, Any]:
    require_root()
    cfg = config()
    if source_id not in cfg.get("sources", {}):
        raise PeerError("source is not paired")
    asset, snapshot = validate_asset(asset), validate_snapshot(snapshot)
    if base != "-":
        validate_snapshot(base)
    try:
        metadata = json.loads(base64.urlsafe_b64decode(encoded_metadata.encode()))
    except Exception as exc:
        raise PeerError("replication metadata is invalid") from exc
    if metadata.get("source_id") != source_id:
        raise PeerError("metadata source does not match the paired SSH identity")
    if not isinstance(metadata.get("source_numeric_id"), int) or not 1 <= metadata["source_numeric_id"] <= 9_999_999_999:
        raise PeerError("metadata source numeric ID is invalid")
    if not isinstance(metadata.get("source_name"), str) or len(metadata["source_name"]) > 128:
        raise PeerError("metadata source name is invalid")
    _remember_name("sources", source_id, metadata["source_name"])
    retention_hours = int(metadata.get("retention_hours", MAX_RETENTION_HOURS))
    if not MIN_RETENTION_HOURS <= retention_hours <= MAX_RETENTION_HOURS:
        raise PeerError("replication metadata retention is invalid")
    retention_tiers = validate_retention_tiers(
        retention_hours, metadata.get("retention_tiers")
    )
    dataset = dataset_for(cfg, asset)
    origin = load_origin(asset)
    exists = zfs_exists(dataset)
    received_record = state().get("received", {}).get(asset, {})
    trusted_source = received_record.get("source_id") or origin.get("sourceApplianceId")
    if exists and trusted_source != source_id:
        raise PeerError("asset key already belongs to another local or replicated asset")
    existing = zfs_snapshots(dataset)
    if not resume:
        if base == "-" and existing:
            raise PeerError("refusing a full stream over an existing backup chain")
        if base != "-" and base not in existing:
            raise PeerError(f"incremental base {base} is not present on the target")
    with locked_state() as value:
        value.setdefault("received", {})[asset] = {
            "source_id": source_id, "snapshot": snapshot,
            "status": "receiving", "updated": int(time.time()),
        }
    transfer = metadata.get("transfer") if isinstance(metadata.get("transfer"), dict) else {}
    bytes_total = 0
    with contextlib.suppress(TypeError, ValueError):
        bytes_total = max(0, int(transfer.get("bytes_total") or 0))
    record = {
        "direction": "inbound", "asset": asset,
        "name": metadata_display_name(metadata) or asset_display_name(asset),
        "source_id": source_id, "source_name": metadata["source_name"],
        "snapshot": snapshot, "base": None if base == "-" else base,
        "mode": "resumed" if resume else ("full" if base == "-" else f"incremental-from-{base}"),
        "bytes_before": received_bytes_before(dataset) if resume else 0,
        "bytes_total": bytes_total,
        "started": int(time.time()), "pid": None,
    }
    decompressor = None
    if codec:
        # zfs receive (and its progress counter) sees the original stream bytes.
        decompressor = subprocess.Popen(STREAM_CODECS[codec][1], stdin=stream,
                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        stream = decompressor.stdout
        record["codec"] = codec
    proc = subprocess.Popen(["zfs", "receive", "-u", "-s", dataset], stdin=stream,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if decompressor and decompressor.stdout:
        decompressor.stdout.close()
    record["pid"] = proc.pid
    with contextlib.suppress(Exception):
        write_transfer_record("inbound", asset, record)
    try:
        _, receive_err = proc.communicate()
    finally:
        clear_transfer_record("inbound", asset)
    decompress_err = b""
    if decompressor:
        decompress_err = decompressor.stderr.read() if decompressor.stderr else b""
        if decompressor.wait() != 0 and proc.returncode == 0:
            raise PeerError("stream decompression failed: " +
                            decompress_err.decode(errors="replace").strip())
    if proc.returncode != 0:
        raise PeerError(f"zfs receive failed: {receive_err.decode(errors='replace').strip()}")
    run(["zfs", "set", "canmount=on", dataset])
    run(["zfs", "set", f"mountpoint=/home/agents/{asset}", dataset])
    run(["zfs", "set", "readonly=on", dataset])
    run(["zfs", "mount", dataset], check=False)
    install_metadata(asset, metadata)
    universal = f"{int(metadata['source_numeric_id'])}+{asset}+agent"
    hook_errors = []
    received = [point for point in zfs_snapshots(dataset) if point not in existing]
    for point in received or [snapshot]:
        hook = run(["snapctl", "asset:replication:received", universal, point, point], check=False)
        if hook.returncode != 0:
            hook_errors.append(hook.stderr.decode(errors="replace").strip())
    # snapctl may rewrite originDevice using its legacy schema. Restore the
    # source identity used by collision and replication-loop protections.
    install_metadata(asset, metadata)
    pruned = prune_received_snapshots(dataset, retention_hours, retention_tiers)
    with locked_state() as value:
        value.setdefault("received", {})[asset] = {
            "source_id": source_id, "snapshot": snapshot,
            "status": "ready", "updated": int(time.time()),
        }
    hook_error = "; ".join(error for error in hook_errors if error) or None
    event("receive-success", f"Received {asset}@{snapshot}", source_id=source_id,
          native_hook_error=hook_error, pruned_snapshots=pruned)
    return {"ok": True, "asset": asset, "snapshot": snapshot,
            "native_hook": "ok" if hook_error is None else "deferred", "pruned": pruned}


def asset_info_received(source_id: str, asset: str) -> dict[str, Any]:
    cfg = config()
    if source_id not in cfg.get("sources", {}):
        raise PeerError("source is not paired")
    dataset = dataset_for(cfg, validate_asset(asset))
    token = ""
    if zfs_exists(dataset):
        result = run(["zfs", "get", "-H", "-o", "value", "receive_resume_token", dataset], check=False)
        if result.returncode == 0 and result.stdout.decode().strip() != "-":
            token = result.stdout.decode().strip()
    return {"ok": True, "exists": zfs_exists(dataset), "snapshots": zfs_snapshots(dataset),
            "resume_token": token or None, "storage": storage_status(cfg),
            "appliance_name": appliance_name(cfg), "stream_codecs": local_stream_codecs(),
            "os_version_id": os_version_id(), "zfs_version": zfs_versions()}


def os_version_id() -> str | None:
    """VERSION_ID from os-release, e.g. 22.04."""
    with contextlib.suppress(OSError):
        for line in OS_RELEASE_PATH.read_text().splitlines():
            if line.startswith("VERSION_ID="):
                return line.split("=", 1)[1].strip().strip('"') or None
    return None


def zfs_versions() -> dict[str, str | None]:
    """ZFS userland and kernel-module versions (they can differ, e.g. HWE kernels)."""
    versions: dict[str, str | None] = {"userland": None, "kmod": None}
    with contextlib.suppress(Exception):
        result = run(["zfs", "version"], check=False, timeout=10)
        for line in result.stdout.decode("utf-8", "replace").split():
            if line.startswith("zfs-kmod-"):
                versions["kmod"] = line.removeprefix("zfs-kmod-")
            elif line.startswith("zfs-"):
                versions["userland"] = line.removeprefix("zfs-")
    return versions


def maintenance_status() -> dict[str, Any] | None:
    """The active maintenance hold, or None."""
    if not MAINTENANCE_PATH.exists():
        return None
    value = load_json(MAINTENANCE_PATH, {})
    if not isinstance(value, dict):
        value = {}
    return {"reason": str(value.get("reason") or "maintenance"), "since": value.get("since")}


def require_not_in_maintenance() -> None:
    hold = maintenance_status()
    if hold:
        raise PeerError(f"this appliance is in maintenance ({hold['reason']}); "
                        "replication resumes automatically when it ends")


def replication_busy() -> list[str]:
    """Describe replication work still running on this appliance."""
    busy = []
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            busy.append("an outbound replication run is active")
    try:
        pids = sorted(int(entry.name) for entry in PROC_ROOT.iterdir() if entry.name.isdigit())
    except OSError:
        pids = []
    for pid in pids:
        found = _zfs_transfer_process(_proc_cmdline(pid))
        if found and found[0] == "inbound":
            busy.append(f"receiving {found[1]} (pid {pid})")
    return busy


def maintenance_on(reason: str, wait_seconds: int = 0, poll: float = 10.0) -> dict[str, Any]:
    """Stop new replication, then wait for running transfers to finish.

    New outbound runs and inbound receives are refused at once. Transfers that
    are already running are left alone: they finish, or an operator stops
    recovera-peer-sync.service and the transfer resumes from its token later.
    """
    require_root()
    reason = " ".join(str(reason or "maintenance").split())[:200] or "maintenance"
    current = maintenance_status()
    MAINTENANCE_PATH.parent.mkdir(parents=True, exist_ok=True)
    atomic_json(MAINTENANCE_PATH, {"reason": reason,
                                   "since": (current or {}).get("since") or int(time.time())},
                mode=0o644)
    if not current:
        event("maintenance-started", f"Replication paused for maintenance: {reason}")
    deadline = time.monotonic() + max(0, wait_seconds)
    busy = replication_busy()
    while busy and time.monotonic() < deadline:
        time.sleep(min(poll, max(0.0, deadline - time.monotonic())))
        busy = replication_busy()
    return {"maintenance": maintenance_status(), "idle": not busy, "busy": busy}


def maintenance_off() -> dict[str, Any]:
    require_root()
    was = maintenance_status()
    MAINTENANCE_PATH.unlink(missing_ok=True)
    if was:
        event("maintenance-ended", "Replication resumed after maintenance")
    return {"maintenance": None, "was": was}


def php_fpm_service() -> str:
    """The installed PHP-FPM unit (php8.1-fpm on 22.04, php8.3-fpm on 24.04)."""
    with contextlib.suppress(Exception):
        result = run(["systemctl", "list-unit-files", "--no-legend", "--plain", "php*-fpm.service"],
                     check=False, timeout=15)
        found = re.findall(r"^php([0-9]+)\.([0-9]+)-fpm\.service\s",
                           result.stdout.decode("utf-8", "replace"), re.MULTILINE)
        if found:
            major, minor = max(found, key=lambda item: (int(item[0]), int(item[1])))
            return f"php{major}.{minor}-fpm.service"
    return "php8.1-fpm.service"


def storage_status(cfg: dict[str, Any] | None = None) -> dict[str, Any]:
    cfg = cfg or config()
    result = run(["zpool", "list", "-Hp", "-o", "size,alloc,free,health", cfg["pool"]], check=False)
    if result.returncode != 0:
        return {"available": False}
    size, allocated, free, health = result.stdout.decode().strip().split("\t")
    return {"available": True, "size": int(size), "allocated": int(allocated),
            "free": int(free), "health": health}


def stream_codec_argument(value: str) -> str:
    if value not in STREAM_CODECS or value not in local_stream_codecs():
        raise PeerError(f"unsupported stream codec: {value}")
    return value


def ssh_entry(source_id: str) -> None:
    require_root()
    if not ID_RE.fullmatch(source_id):
        raise PeerError("invalid paired source identity")
    argv = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
    if not argv:
        raise PeerError("a replication command is required")
    command = argv.pop(0)
    if command in ("asset-info", "receive", "receive-resume"):
        # The source keeps its resume token and retries on its next run.
        require_not_in_maintenance()
    if command == "asset-info" and len(argv) == 1:
        answer = asset_info_received(source_id, argv[0])
    elif command == "receive" and len(argv) in (4, 5):
        codec = stream_codec_argument(argv[4]) if len(argv) == 5 else None
        answer = receive_dataset(source_id, argv[0], argv[1], argv[2], argv[3], False,
                                 sys.stdin.buffer, codec)
    elif command == "receive-resume" and len(argv) in (3, 4):
        codec = stream_codec_argument(argv[3]) if len(argv) == 4 else None
        answer = receive_dataset(source_id, argv[0], argv[1], "-", argv[2], True,
                                 sys.stdin.buffer, codec)
    else:
        raise PeerError("unsupported replication command")
    print(json.dumps(answer, separators=(",", ":")))


def target_for_asset(cfg: dict[str, Any], asset: str) -> str:
    """Resolve the target used by a manually queued native recovery point."""
    rule = cfg.get("assets", {}).get(asset, {})
    assigned = str(rule.get("peer_id", ""))
    peer = cfg.get("peers", {}).get(assigned)
    if assigned and peer and peer.get("enabled", True):
        return assigned
    enabled = [peer_id for peer_id, value in cfg.get("peers", {}).items()
               if value.get("enabled", True)]
    if len(enabled) == 1:
        return enabled[0]
    if not enabled:
        raise PeerError("no enabled off-site target is paired")
    raise PeerError("multiple off-site targets are paired; save a replication policy for this asset")


def queue_key(peer_id: str, asset: str, snapshot: str) -> str:
    return f"{peer_id}:{asset}:{snapshot}"


def queue_snapshot(asset: str, snapshot: str) -> dict[str, Any]:
    """Persist a native UI request and wake the background replication worker."""
    require_root()
    cfg = config()
    asset, snapshot = validate_asset(asset), validate_snapshot(snapshot)
    dataset = dataset_for(cfg, asset)
    if not zfs_exists(dataset):
        raise PeerError(f"source dataset does not exist: {dataset}")
    if load_origin(asset).get("isReplicated"):
        raise PeerError("a received replica cannot be queued as a replication source")
    if snapshot not in zfs_snapshots(dataset):
        raise PeerError(f"snapshot {snapshot} does not exist for {asset}")
    peer_id = target_for_asset(cfg, asset)
    now = int(time.time())
    key = queue_key(peer_id, asset, snapshot)
    peer = cfg["peers"][peer_id]
    with locked_state() as value:
        item = {
            "key": key, "asset": asset, "snapshot": snapshot, "peer_id": peer_id,
            "target": peer.get("name", peer_id), "status": "queued", "error": None,
            "queued_at": int(value.get("queue", {}).get(key, {}).get("queued_at", now)),
            "updated": now,
        }
        value.setdefault("queue", {})[key] = item
    event("replication-queued", f"Queued {asset}@{snapshot}", asset=asset,
          peer_id=peer_id, snapshot=snapshot)
    # The timer is still the durable fallback if systemd is temporarily busy.
    with contextlib.suppress(PeerError, subprocess.TimeoutExpired):
        run(["systemctl", "start", "--no-block", "recovera-peer-sync.service"],
            check=False, timeout=10)
    return item


def queue_document() -> dict[str, Any]:
    items = list(state().get("queue", {}).values())
    items.sort(key=lambda item: (int(item.get("snapshot", 0)),
                                 int(item.get("queued_at", 0))), reverse=True)
    return {"items": items}


def queued_sync(speed: int) -> list[dict[str, Any]]:
    """Process explicit recovery-point requests before interval policies."""
    # A "syncing" item is safe to resume here: this function is called while
    # holding the single worker lock, so no other transfer can still own it.
    pending = [dict(item) for item in state().get("queue", {}).values()
               if item.get("status") in ("queued", "syncing")]
    pending.sort(key=lambda item: (int(item.get("snapshot", 0)),
                                   int(item.get("queued_at", 0))))
    results: list[dict[str, Any]] = []
    for requested in pending:
        key = str(requested["key"])
        with locked_state() as value:
            item = value.get("queue", {}).get(key)
            if not item or item.get("status") not in ("queued", "syncing"):
                continue
            item.update({"status": "syncing", "updated": int(time.time()), "error": None})
            transfer = dict(item)
        try:
            answer = replicate(str(transfer["asset"]), str(transfer["peer_id"]),
                               str(transfer["snapshot"]), speed_kbps=speed)
            with locked_state() as value:
                value["queue"][key].update({"status": "completed", "updated": int(time.time()),
                                             "error": None, "result": answer.get("status")})
            results.append(answer)
        except Exception as exc:
            with locked_state() as value:
                if key in value.get("queue", {}):
                    value["queue"][key].update({"status": "error", "updated": int(time.time()),
                                                 "error": str(exc)})
            event("replication-error", str(exc), asset=requested.get("asset"),
                  peer_id=requested.get("peer_id"), snapshot=requested.get("snapshot"))
            results.append({"ok": False, "asset": requested.get("asset"),
                            "snapshot": requested.get("snapshot"), "error": str(exc)})
    return results


def configured_sync() -> list[dict[str, Any]]:
    require_root()
    if maintenance_status():
        return [{"ok": True, "status": "paused-for-maintenance"}]
    cfg, results, now, current = config(), [], int(time.time()), state()
    speed = schedule_speed(now)
    if speed < 0:
        event("replication-paused", "Off-site replication is paused by the active schedule")
        return [{"ok": True, "status": "paused-by-schedule"}]
    queued_results = queued_sync(speed)
    results.extend(queued_results)
    queued_assets = {str(item.get("asset")) for item in queued_results if item.get("asset")}
    current = state()
    priority_order = {"high": 0, "normal": 1, "low": 2}
    rules = sorted(cfg.get("assets", {}).items(),
                   key=lambda item: priority_order.get(str(item[1].get("priority", "normal")), 1))
    for asset, rule in rules:
        if not rule.get("enabled", True) or asset in queued_assets:
            continue
        peer_id = str(rule["peer_id"])
        key = f"{peer_id}:{asset}"
        previous = current.get("assets", {}).get(key, {})
        if now < int(previous.get("next_retry", 0)):
            continue
        dataset = dataset_for(cfg, asset)
        if not zfs_exists(dataset):
            message = "Protected system no longer exists; remove or reassign this replication policy"
            if previous.get("error") != message:
                with locked_state() as value:
                    value.setdefault("assets", {}).setdefault(key, {}).update(
                        {"error": message, "last_attempt": now, "next_retry": now + 86400}
                    )
                event("replication-policy-orphaned", message, asset=asset, peer_id=peer_id)
            continue
        local_points = zfs_snapshots(dataset)
        if not local_points:
            continue
        mode = str(rule.get("schedule_mode", "interval"))
        if mode == "every_backup":
            due = local_points[-1] != previous.get("last_snapshot")
        elif mode == "daily":
            hour = min(23, max(0, int(rule.get("daily_hour", 18))))
            last = int(previous.get("last_success", 0))
            now_day = time.localtime(now).tm_yday
            due = time.localtime(now).tm_hour >= hour and (
                not last or time.localtime(last).tm_yday != now_day
            )
        else:
            interval = max(300, int(rule.get("interval_minutes", 60)) * 60)
            due = now - int(previous.get("last_success", 0)) >= interval
        if not due:
            continue
        try:
            results.append(replicate(asset, peer_id, speed_kbps=speed))
        except Exception as exc:
            with locked_state() as value:
                record = value.setdefault("assets", {}).setdefault(key, {})
                failures = int(record.get("consecutive_failures", 0)) + 1
                record.update({"error": str(exc), "last_attempt": now,
                               "consecutive_failures": failures,
                               "next_retry": now + min(3600, 300 * (2 ** min(failures - 1, 4)))})
                value.setdefault("peers", {}).setdefault(peer_id, {}).update(
                    {"last_contact": now, "status": "error", "error": str(exc)}
                )
            event("replication-error", str(exc), asset=asset, peer_id=peer_id)
            results.append({"ok": False, "asset": asset, "peer_id": peer_id, "error": str(exc)})
    return results


def validate_policy(peer_id: str, interval: int, retention_hours: int,
                    schedule_mode: str = "interval", priority: str = "normal") -> None:
    cfg = config()
    if peer_id not in cfg.get("peers", {}) or not cfg["peers"][peer_id].get("enabled", True):
        raise PeerError("unknown or disabled target peer")
    if schedule_mode not in ("every_backup", "daily", "interval"):
        raise PeerError("replication schedule mode is invalid")
    if priority not in ("high", "normal", "low"):
        raise PeerError("replication priority is invalid")
    if schedule_mode == "interval" and not 5 <= interval <= 525600:
        raise PeerError("replication interval must be between 5 minutes and 1 year")
    if not MIN_RETENTION_HOURS <= retention_hours <= MAX_RETENTION_HOURS:
        raise PeerError("target retention is outside the supported range")


def configure_asset(asset: str, peer_id: str, interval: int, enabled: bool = True,
                    retention_hours: int = MAX_RETENTION_HOURS,
                    schedule_mode: str = "interval", priority: str = "normal",
                    daily_hour: int = 18,
                    retention_tiers: dict[str, int] | None = None) -> dict[str, Any]:
    cfg, asset = config(), validate_asset(asset)
    validate_policy(peer_id, interval, retention_hours, schedule_mode, priority)
    tiers = validate_retention_tiers(retention_hours, retention_tiers)
    cfg.setdefault("assets", {})[asset] = {"peer_id": peer_id,
        "interval_minutes": interval, "retention_hours": retention_hours,
        "retention_tiers": tiers, "schedule_mode": schedule_mode,
        "daily_hour": min(23, max(0, int(daily_hour))),
        "priority": priority, "enabled": enabled}
    save_config(cfg)
    return cfg["assets"][asset] | {"asset": asset}


def configure_systems(systems: list[Any], peer_id: str, interval: int,
                      retention_hours: int, schedule_mode: str = "interval",
                      priority: str = "normal") -> list[dict[str, Any]]:
    """Attach a wizard policy to protected assets using their stored identities."""
    require_root()
    validate_policy(peer_id, interval, retention_hours, schedule_mode, priority)
    requested: list[tuple[set[str], set[str]]] = []
    for system in systems:
        if not isinstance(system, dict):
            raise PeerError("protected-system identity is invalid")
        strong = {str(system.get(key, "")).strip().casefold()
                  for key in ("uuid", "keyName") if system.get(key)}
        weak = {str(system.get(key, "")).strip().casefold()
                for key in ("name", "hostname") if system.get(key)}
        if not strong and not weak:
            raise PeerError("protected-system identity is missing")
        requested.append((strong, weak))

    matches: list[str] = []
    deadline = time.monotonic() + 15
    while True:
        available = {asset: asset_identifiers(asset) for asset in protected_asset_keys()}
        resolved: list[str] = []
        unresolved = False
        for strong, weak in requested:
            found = [asset for asset, candidates in available.items() if strong & candidates]
            if not found:
                found = [asset for asset, candidates in available.items() if weak & candidates]
            if len(found) > 1:
                raise PeerError("more than one protected asset matches a selected system")
            if not found:
                unresolved = True
                break
            resolved.append(found[0])
        if not unresolved:
            matches = resolved
            break
        if time.monotonic() >= deadline:
            raise PeerError("new protected assets were not available for replication policy assignment")
        time.sleep(1)

    if len(set(matches)) != len(matches):
        raise PeerError("selected systems did not resolve to distinct protected assets")
    results = [configure_asset(asset, peer_id, interval, retention_hours=retention_hours,
                               schedule_mode=schedule_mode, priority=priority)
               for asset in matches]
    event("wizard-policy-saved", f"Configured replication for {len(results)} protected system(s)",
          peer_id=peer_id, assets=matches, interval_minutes=interval,
          retention_hours=retention_hours)
    return results


def peer_remove(peer_id: str) -> None:
    require_root()
    cfg = config()
    if peer_id not in cfg.get("peers", {}):
        raise PeerError("unknown target peer")
    used = [asset for asset, rule in cfg.get("assets", {}).items()
            if rule.get("peer_id") == peer_id]
    if used:
        raise PeerError("target is still assigned to: " + ", ".join(used))
    name = cfg["peers"][peer_id].get("name", peer_id)
    del cfg["peers"][peer_id]
    save_config(cfg)
    event("target-removed", f"Removed target {name}", peer_id=peer_id)


def source_remove(source_id: str) -> None:
    require_root()
    if not ID_RE.fullmatch(source_id):
        raise PeerError("source appliance ID is invalid")
    cfg = config()
    if source_id not in cfg.get("sources", {}):
        raise PeerError("unknown source peer")
    name = cfg["sources"][source_id].get("name", source_id)
    del cfg["sources"][source_id]
    save_config(cfg)
    path = authorized_keys_path()
    if path.exists():
        markers = (f"recovera-source={source_id}", f"backops-source={source_id}")
        lines = [line for line in path.read_text(encoding="ascii").splitlines()
                 if not any(marker in line for marker in markers)]
        path.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="ascii")
        os.chmod(path, 0o600)
    event("source-removed", f"Removed source {name}", source_id=source_id)


def received_forget(asset: str) -> None:
    """Remove provenance only after an administrator has removed the dataset."""
    require_root()
    cfg, asset = config(), validate_asset(asset)
    if zfs_exists(dataset_for(cfg, asset)):
        raise PeerError("refusing to forget provenance while the received dataset exists")
    with locked_state() as value:
        value.setdefault("received", {}).pop(asset, None)


def recovery_readiness(cfg: dict[str, Any], item: dict[str, Any]) -> dict[str, Any]:
    """Run non-destructive target checks needed by local recovery workflows."""
    asset, snapshots = str(item["key"]), item.get("snapshots", [])
    dataset = dataset_for(cfg, asset)
    issues: list[str] = []
    if not zfs_exists(dataset): issues.append("Replica dataset is missing")
    if not snapshots: issues.append("No received recovery points")
    if not (KEYS_DIR / f"{asset}.agentInfo").is_file(): issues.append("Agent metadata is missing")
    if not item.get("origin", {}).get("isReplicated"): issues.append("Replication provenance is missing")
    properties = run(["zfs", "get", "-H", "-o", "property,value",
                      "readonly,mountpoint", dataset], check=False)
    values = dict(line.split("\t", 1) for line in properties.stdout.decode().splitlines()
                  if "\t" in line) if properties.returncode == 0 else {}
    if values.get("readonly") != "on": issues.append("Replica dataset is not read-only")
    if values.get("mountpoint") != f"/home/agents/{asset}": issues.append("Replica mountpoint is invalid")
    return {"recovery_ready": not issues, "recovery_issues": issues,
            "latest_snapshot": snapshots[-1] if snapshots else None,
            "validation": {"dataset": dataset, "readonly": values.get("readonly"),
                           "mountpoint": values.get("mountpoint")}}


def resume_token_bytes(token: str) -> int:
    """Read the byte count already received from a ZFS receive_resume_token.

    The token is "<version>-<checksum>-<length>-<hex zlib nvlist>"; its uint64
    "bytes" pair is the stream offset a resumed send starts from. OpenZFS packs
    the nvlist with native encoding (little endian on these appliances); XDR is
    accepted too.
    """
    try:
        payload = token.strip().split("-", 3)[3]
        raw = zlib.decompress(bytes.fromhex(payload))
    except (IndexError, ValueError, zlib.error):
        return 0
    if len(raw) < 12:
        return 0
    native = raw[0] == 0
    order = "little" if native and raw[1] == 1 else "big"

    def number(offset: int, width: int) -> int:
        return int.from_bytes(raw[offset:offset + width], order)

    position = 12  # nvs header (4) + nvlist version (4) + nvflag (4)
    while position + 16 <= len(raw):
        size = number(position, 4)
        if size <= 0:
            break
        if native:
            # nvpair: size, name_sz (2), reserve (2), nelem, type, name, value (8-aligned)
            name_size, kind = number(position + 4, 2), number(position + 12, 4)
            name = raw[position + 16:position + 16 + name_size].rstrip(b"\0")
            value = position + 16 + (name_size + 7) // 8 * 8
        else:
            # XDR: encoded size, decoded size, name length, name (4-aligned), type, nelem, value
            name_size = number(position + 8, 4)
            name = raw[position + 12:position + 12 + name_size].rstrip(b"\0")
            kind_at = position + 12 + (name_size + 3) // 4 * 4
            kind, value = number(kind_at, 4), kind_at + 8
        if name == b"bytes" and kind == 8:  # DATA_TYPE_UINT64
            return number(value, 8)
        position += size
    return 0

def received_bytes_before(dataset: str) -> int:
    """Bytes a resumable partial receive already holds (0 when not resuming)."""
    try:
        result = run(["zfs", "get", "-H", "-o", "value", "receive_resume_token", dataset],
                     check=False, timeout=30)
    except (PeerError, OSError, subprocess.SubprocessError):
        return 0
    token = result.stdout.decode("ascii", "replace").strip() if result.returncode == 0 else ""
    return resume_token_bytes(token) if token and token != "-" else 0


def start_background_sync() -> dict[str, Any]:
    """Run "Synchronize now" in the dedicated sync service, not the WebUI service.

    A replication can take days; running it inside recovera-peer.service tied
    it to the web API, so a routine service restart (such as after an update)
    cut the transfer. recovera-peer-sync.service is never restarted by updates.
    """
    require_not_in_maintenance()
    running = False
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    # Probe the worker lock; closing the file releases the probe immediately.
    with LOCK_PATH.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            running = True
    if not running:
        result = run(["systemctl", "start", "--no-block", "recovera-peer-sync.service"],
                     check=False, timeout=15)
        if result.returncode != 0:
            raise PeerError("could not start the replication service: " +
                            result.stderr.decode("utf-8", "replace").strip())
    return {"started": not running, "running": True,
            "message": ("A replication run is already in progress." if running else
                        "Replication started in the background.")}


def _check_tcp(host: str, port: int, timeout: float = 4.0) -> tuple[bool, str]:
    started = time.monotonic()
    try:
        with socket.create_connection((host, port), timeout=timeout):
            pass
    except OSError as exc:
        return False, str(exc) or exc.__class__.__name__
    return True, f"connected in {int((time.monotonic() - started) * 1000)} ms"


def _check_ping(host: str, size: int | None = None) -> tuple[bool, str]:
    command = ["ping", "-n", "-q", "-c", "2", "-W", "2"]
    if size:
        # -M do forbids fragmentation, so this proves the path MTU.
        command += ["-M", "do", "-s", str(size)]
    try:
        result = run(command + [host], check=False, timeout=12)
    except (PeerError, OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    output = (result.stdout + result.stderr).decode("utf-8", "replace")
    summary = next((line.strip() for line in output.splitlines() if "packets transmitted" in line), "")
    return result.returncode == 0, summary or output.strip()[-200:] or f"exit {result.returncode}"


def _check_dns(name: str) -> tuple[bool, str]:
    try:
        answers = sorted({item[4][0] for item in socket.getaddrinfo(name, None)})
    except OSError as exc:
        return False, str(exc)
    return True, ", ".join(answers[:3])


def _check_time_sync() -> tuple[bool, str]:
    try:
        result = run(["timedatectl", "show", "-p", "NTPSynchronized", "--value"],
                     check=False, timeout=10)
    except (PeerError, OSError, subprocess.SubprocessError) as exc:
        return False, str(exc)
    synchronized = result.stdout.decode("utf-8", "replace").strip() == "yes"
    return synchronized, "clock synchronized" if synchronized else "clock is not synchronized"


def _default_gateway() -> str | None:
    """Read the IPv4 default gateway from the kernel routing table."""
    with contextlib.suppress(OSError, ValueError):
        for line in (PROC_ROOT / "net" / "route").read_text(encoding="ascii").splitlines()[1:]:
            fields = line.split()
            if len(fields) > 2 and fields[1] == "00000000" and fields[2] != "00000000":
                return socket.inet_ntoa(bytes.fromhex(fields[2])[::-1])
    return None


def _update_hosts() -> list[str]:
    """The hosts the signed updater contacts: gateway origins, else GitHub."""
    values: dict[str, str] = {}
    with contextlib.suppress(OSError):
        for raw in UPGRADE_CONFIG_PATH.read_text(encoding="utf-8").splitlines():
            key, _, value = raw.strip().partition("=")
            if key and not key.startswith("#"):
                values[key.strip()] = value.strip()
    hosts = []
    for origin in re.split(r"[,\s]+", values.get("UPDATE_ORIGINS", "")):
        host = urllib.parse.urlsplit(origin.strip()).hostname if origin.strip() else None
        if host and host not in hosts:
            hosts.append(host)
    return hosts or [DEFAULT_UPDATE_HOST]


def network_check() -> dict[str, Any]:
    """Probe the connections a Recovera appliance actually depends on.

    Replaces Datto's outbound check (heartbeat, off-site cloud, speedtest and
    update servers), which targets vendor endpoints an offline appliance must
    not contact. Each result is keyed by a readable label for the WebUI.
    """
    cfg = config()
    checks: list[tuple[str, Any]] = []
    gateway = _default_gateway()
    if gateway:
        checks.append((f"Default gateway ({gateway})", lambda: _check_ping(gateway)))
    else:
        checks.append(("Default gateway", lambda: (False, "no IPv4 default route")))
    targets = [(peer_id, peer) for peer_id, peer in cfg.get("peers", {}).items()
               if peer.get("enabled", True) and peer.get("host")]
    mtu_host = str(targets[0][1]["host"]) if targets else gateway
    if mtu_host:
        checks.append((f"Full-size packets, 1472 bytes ({mtu_host})",
                       lambda: _check_ping(mtu_host, 1472)))
    update_hosts = _update_hosts()
    checks.append((f"DNS resolution ({update_hosts[0]})", lambda: _check_dns(update_hosts[0])))
    checks.append(("Time synchronization", _check_time_sync))
    for host in update_hosts:
        checks.append((f"Update source ({host}:443)", lambda host=host: _check_tcp(host, 443)))
    for _peer_id, peer in targets:
        name, host = str(peer.get("name") or peer["host"]), str(peer["host"])
        ssh_port = int(peer.get("ssh_port") or 22)
        https_port = int(peer.get("port") or 443)
        checks.append((f"Off-site target {name} ({host}) HTTPS {https_port}",
                       lambda host=host, https_port=https_port: _check_tcp(host, https_port)))
        checks.append((f"Off-site target {name} ({host}) SSH {ssh_port}",
                       lambda host=host, ssh_port=ssh_port: _check_tcp(host, ssh_port)))
    for _source_id, source in cfg.get("sources", {}).items():
        address = str(source.get("address") or "")
        if address:
            name = str(source.get("name") or address)
            checks.append((f"Paired source {name} ({address}) HTTPS 443",
                           lambda address=address: _check_tcp(address, 443)))
    results: dict[str, bool] = {}
    details: dict[str, str] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futures = [(label, pool.submit(probe)) for label, probe in checks]
        for label, future in futures:
            try:
                ok, detail = future.result(timeout=20)
            except Exception as exc:  # one failing probe must not hide the others
                ok, detail = False, str(exc) or exc.__class__.__name__
            results[label], details[label] = bool(ok), str(detail)[:300]
    document = {"created": int(time.time()), "data": results, "details": details}
    with contextlib.suppress(OSError):
        atomic_json(NETWORK_CHECK_PATH, document, mode=0o640)
    return document


def last_network_check() -> dict[str, Any]:
    with contextlib.suppress(PeerError):
        value = load_json(NETWORK_CHECK_PATH, None)
        if isinstance(value, dict):
            return value
    return {"created": None, "data": {}, "details": {}}


def _transfer_record_path(direction: str, key: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", key)
    return TRANSFER_DIR / f"{direction}-{safe}.json"


def write_transfer_record(direction: str, key: str, record: dict[str, Any]) -> None:
    atomic_json(_transfer_record_path(direction, key), record | {"updated": int(time.time())})


def clear_transfer_record(direction: str, key: str) -> None:
    with contextlib.suppress(OSError):
        _transfer_record_path(direction, key).unlink()


def _proc_cmdline(pid: int) -> list[str]:
    try:
        raw = (PROC_ROOT / str(pid) / "cmdline").read_bytes()
    except OSError:
        return []
    return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]


def _proc_io(pid: int) -> dict[str, int]:
    values: dict[str, int] = {}
    try:
        text = (PROC_ROOT / str(pid) / "io").read_text(encoding="ascii", errors="replace")
    except OSError:
        return values
    for line in text.splitlines():
        name, _, number = line.partition(":")
        with contextlib.suppress(ValueError):
            values[name.strip()] = int(number)
    return values


def _proc_start(pid: int) -> tuple[str, float | None]:
    """Return a stable start token and the start time (epoch) of a process."""
    try:
        stat = (PROC_ROOT / str(pid) / "stat").read_text(encoding="ascii", errors="replace")
        ticks = stat.rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return "", None
    boot = None
    with contextlib.suppress(OSError, ValueError):
        for line in (PROC_ROOT / "stat").read_text(encoding="ascii").splitlines():
            if line.startswith("btime "):
                boot = int(line.split()[1])
    hertz = 100
    with contextlib.suppress(AttributeError, ValueError, OSError):
        hertz = int(os.sysconf("SC_CLK_TCK"))
    if boot is None or not ticks.isdigit():
        return ticks, None
    return ticks, boot + int(ticks) / hertz


def _zfs_transfer_process(argv: list[str]) -> tuple[str, str, str] | None:
    """Classify a zfs send/receive command line as (direction, dataset, mode)."""
    if len(argv) < 3 or Path(argv[0]).name != "zfs":
        return None
    options = [value for value in argv[2:] if value.startswith("-") and not value.startswith("--")]
    if argv[1] == "send":
        # zfs send -n is a size estimate, not a transfer.
        if any("n" in value[1:] for value in options if value not in ("-I", "-i", "-t")):
            return None
        target = next((value for value in reversed(argv[2:]) if "@" in value), "")
        mode = "resumed" if "-t" in argv else ("incremental" if "-I" in argv or "-i" in argv else "full")
        return "outbound", target.split("@", 1)[0], mode
    if argv[1] in ("receive", "recv"):
        # -s only makes a receive resumable; whether it is a seed, an increment
        # or a resume is known from the transfer record, not the command line.
        return "inbound", argv[-1], ""
    return None


def _transfer_rate(pid: int, token: str, moved: int, started: float | None) -> float:
    """Bytes per second since the previous poll, or the average since start."""
    now = time.time()
    with _RATE_LOCK:
        previous = _RATE_SAMPLES.get((pid, token))
        _RATE_SAMPLES[(pid, token)] = (now, moved)
        if len(_RATE_SAMPLES) > 64:
            for stale in sorted(_RATE_SAMPLES, key=lambda key: _RATE_SAMPLES[key][0])[:-32]:
                _RATE_SAMPLES.pop(stale, None)
    if previous and 1 <= now - previous[0] <= 120 and moved >= previous[1]:
        return (moved - previous[1]) / (now - previous[0])
    if started and now > started:
        return moved / (now - started)
    return 0.0


def _transfer_records() -> list[dict[str, Any]]:
    found: list[dict[str, Any]] = []
    with contextlib.suppress(OSError):
        for path in sorted(TRANSFER_DIR.glob("*.json")):
            with contextlib.suppress(PeerError, OSError):
                value = load_json(path, None)
                if isinstance(value, dict):
                    found.append(value | {"_path": path})
    return found


def replication_activity() -> dict[str, Any]:
    """Describe in-flight and recent appliance replication for the WebUI."""
    cfg = config()
    root = cfg["source_root"].rstrip("/") + "/"
    current = state()
    received = current.get("received", {})
    sources = cfg.get("sources", {})
    peers = cfg.get("peers", {})
    records = _transfer_records()
    by_pid = {int(item["pid"]): item for item in records if str(item.get("pid") or "").isdigit()}
    active: dict[str, list[dict[str, Any]]] = {"outbound": [], "inbound": []}
    live_pids: set[int] = set()
    try:
        pids = sorted(int(entry.name) for entry in PROC_ROOT.iterdir() if entry.name.isdigit())
    except OSError:
        pids = []
    for pid in pids:
        found = _zfs_transfer_process(_proc_cmdline(pid))
        if not found:
            continue
        direction, dataset, discovered_mode = found
        record = by_pid.get(pid, {})
        if record.get("direction") not in (None, direction):
            record = {}
        asset = str(record.get("asset") or (dataset[len(root):] if dataset.startswith(root) else ""))
        if not ASSET_RE.fullmatch(asset):
            continue
        live_pids.add(pid)
        token, process_started = _proc_start(pid)
        counters = _proc_io(pid)
        moved = counters.get("wchar" if direction == "outbound" else "rchar", 0)
        if direction == "inbound" and "bytes_before" not in record:
            # Receives started before 0.6.30 did not record their resume offset;
            # while a resume runs, the token still describes the saved state.
            record = record | {"bytes_before": received_bytes_before(dataset)}
        done = int(record.get("bytes_before") or 0) + moved
        total = int(record.get("bytes_total") or 0)
        rate = _transfer_rate(pid, token, moved, process_started)
        item: dict[str, Any] = {
            "status": "transferring", "asset": asset,
            "name": record.get("name") or asset_display_name(asset),
            "snapshot": record.get("snapshot"), "mode": record.get("mode") or discovered_mode or None,
            "started": record.get("started") or (int(process_started) if process_started else None),
            "bytes_done": done, "bytes_total": total or None,
            "percent": round(min(100.0, done * 100 / total), 1) if total else None,
            "rate_bps": int(rate),
            "eta_seconds": int((total - done) / rate) if total > done and rate > 0 else None,
            "codec": record.get("codec"),
        }
        if direction == "outbound":
            peer_id = str(record.get("peer_id") or "")
            item |= {"peer_id": peer_id or None,
                     "peer_name": record.get("peer_name") or peers.get(peer_id, {}).get("name"),
                     "peer_address": peers.get(peer_id, {}).get("host")}
        else:
            receiving = received.get(asset, {})
            source_id = str(record.get("source_id") or receiving.get("source_id") or "")
            source = sources.get(source_id, {})
            item |= {"source_id": source_id or None,
                     "source_name": record.get("source_name") or source.get("name")
                     or source.get("address"),
                     "source_address": source.get("address"),
                     "snapshot": item["snapshot"] or receiving.get("snapshot")}
        active[direction].append(item)

    now = int(time.time())
    for record in records:
        pid = record.get("pid")
        if str(pid or "").isdigit() and int(pid) in live_pids:
            continue
        if now - int(record.get("updated") or 0) > TRANSFER_RECORD_MAX_AGE:
            with contextlib.suppress(OSError):
                record["_path"].unlink()
            continue
        direction = record.get("direction")
        if direction in active and not any(item["asset"] == record.get("asset")
                                           for item in active[direction]):
            active[direction].append({key: value for key, value in record.items()
                                      if not key.startswith("_") and key != "pid"}
                                     | {"status": "interrupted"})
    for asset, item in received.items():
        if (item.get("status") == "receiving" and ASSET_RE.fullmatch(str(asset))
                and not any(entry["asset"] == asset for entry in active["inbound"])):
            source = sources.get(str(item.get("source_id")), {})
            active["inbound"].append({
                "status": "interrupted", "asset": asset, "name": asset_display_name(asset),
                "snapshot": item.get("snapshot"), "source_id": item.get("source_id"),
                "source_name": source.get("name") or source.get("address"),
                "source_address": source.get("address"), "updated": item.get("updated"),
            })

    recent_outbound = []
    for key, item in current.get("assets", {}).items():
        peer_id, _, asset = str(key).partition(":")
        if not ASSET_RE.fullmatch(asset):
            continue
        recent_outbound.append({
            "asset": asset, "name": asset_display_name(asset), "peer_id": peer_id,
            "peer_name": peers.get(peer_id, {}).get("name") or peer_id,
            "peer_address": peers.get(peer_id, {}).get("host"),
            **{field: item.get(field) for field in (
                "last_success", "last_snapshot", "mode", "error", "consecutive_failures",
                "next_retry")},
        })
    recent_inbound = []
    for asset, item in received.items():
        if item.get("status") != "ready" or not ASSET_RE.fullmatch(str(asset)):
            continue
        source = sources.get(str(item.get("source_id")), {})
        recent_inbound.append({
            "asset": asset, "name": asset_display_name(asset),
            "source_name": source.get("name") or source.get("address"),
            "source_address": source.get("address"),
            "snapshot": item.get("snapshot"), "updated": item.get("updated"),
        })
    return {"generated": now, "appliance": appliance_name(cfg), "active": active,
            "maintenance": maintenance_status(),
            "recent_outbound": recent_outbound, "recent_inbound": recent_inbound,
            "paired": {"targets": len(peers), "sources": len(sources)}}


def status_document() -> dict[str, Any]:
    cfg = config()
    local_assets = assets_local(cfg)
    received_assets = []
    for item in local_assets:
        if item.get("replicated"):
