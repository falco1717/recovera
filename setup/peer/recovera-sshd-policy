#!/bin/sh
# Reapply Recovera's SSH authentication policy after the appliance selects its
# generated sshd_config at boot.
set -eu

active=$(readlink -f /etc/ssh/sshd_config)
[ -n "$active" ] && [ -f "$active" ]

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
{
  printf '%s\n' 'Include /etc/ssh/sshd_config.d/*.conf'
  grep -Ev '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf([[:space:]]|$)' "$active"
} > "$tmp"
cat "$tmp" > "$active"

install -d -m 0755 /etc/ssh/sshd_config.d
rm -f /etc/ssh/sshd_config.d/59-recovera-password-policy.conf \
  /etc/ssh/sshd_config.d/60-cloudimg-settings.conf \
  /etc/ssh/sshd_config.d/92-recovera-backup-admin.conf
cat > /etc/ssh/sshd_config.d/49-recovera-password-policy.conf <<'EOF'
Match User backup-admin
    PasswordAuthentication yes
    KbdInteractiveAuthentication no
Match all
PasswordAuthentication no
KbdInteractiveAuthentication no
EOF

# The boot hook can run before ssh.service has created /run/sshd. Let ssh's own
# ExecStartPre validate at boot; setup invokes --validate once the system is up.
if [ "${1:-}" = --validate ]; then
  /usr/sbin/sshd -t
fi
