class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "BackOpsPeer/" + VERSION
    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write("peer-http: " + fmt % args + "\n")
    def reply(self, status: int, value: Any, content_type: str = "application/json") -> None:
        raw = value.encode() if isinstance(value, str) else json.dumps(value).encode()
        self.send_response(status)
        for key, val in (("Content-Type", content_type), ("Content-Length", str(len(raw))),
                         ("Cache-Control", "no-store"), ("X-Content-Type-Options", "nosniff"),
                         ("Content-Security-Policy", "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'")):
            self.send_header(key, val)
        self.end_headers(); self.wfile.write(raw)
    def json_body(self) -> dict[str, Any]:
        if self.headers.get_content_type() != "application/json":
            raise PeerError("Content-Type must be application/json")
        size = int(self.headers.get("Content-Length", "0"))
        if size < 0 or size > 1024 * 1024:
            raise PeerError("request body is too large")
        value = json.loads(self.rfile.read(size))
        if not isinstance(value, dict):
            raise PeerError("request must be a JSON object")
        return value
    def admin(self) -> bool:
        expected, header = ADMIN_TOKEN_PATH.read_text(encoding="ascii").strip(), self.headers.get("Authorization", "")
        try:
            kind, encoded = header.split(" ", 1); user, password = base64.b64decode(encoded).decode().split(":", 1)
        except Exception:
            kind = user = password = ""
        if kind.lower() == "basic" and user == "backops" and hmac.compare_digest(password, expected):
            return True
        self.send_response(401); self.send_header("WWW-Authenticate", 'Basic realm="BackOps Peer Replication"'); self.send_header("Content-Length", "0"); self.end_headers(); return False
    def do_GET(self) -> None:
        try:
            if self.path == "/v1/info": self.reply(200, public_info())
            elif self.path == "/" and self.admin(): self.reply(200, HTML, "text/html; charset=utf-8")
            elif self.path == "/v1/admin/status" and self.admin(): self.reply(200, status_document())
            elif self.path not in ("/", "/v1/admin/status"): self.reply(404, {"error": "not found"})
        except Exception as exc: self.reply(400, {"error": str(exc)})
    def do_POST(self) -> None:
        try:
            if self.path == "/v1/pair": self.reply(200, pair_accept(self.json_body(), self.client_address[0])); return
            if not self.admin(): return
            body = self.json_body()
            if self.path == "/v1/admin/pairing-code":
                code = pairing_code(15); self.reply(200, {"code": code, "expires": int(time.time()) + 900})
            elif self.path == "/v1/admin/discover":
                info, observed = ssl_json(str(body["host"]), int(body.get("port", 9443)), "/v1/info"); self.reply(200, info | {"observed_fingerprint": observed})
            elif self.path == "/v1/admin/peer":
                self.reply(200, peer_add(str(body["host"]), int(body.get("port", 9443)), str(body["code"]), str(body["fingerprint"]), {"appliance_id": str(body["appliance_id"])}))
            elif self.path == "/v1/admin/rule":
                self.reply(200, configure_asset(str(body["asset"]), str(body["peer_id"]), int(body.get("interval_minutes", 60))))
            elif self.path == "/v1/admin/sync":
                with sync_lock():
                    self.reply(200, {"results": configured_sync()})
            else: self.reply(404, {"error": "not found"})
        except Exception as exc: self.reply(400, {"error": str(exc)})


def serve() -> None:
    require_root(); cfg = config()
    server = http.server.ThreadingHTTPServer((cfg["listen"], int(cfg["port"])), Handler)
    server.daemon_threads = True
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(str(TLS_CERT_PATH), str(TLS_KEY_PATH))
    server.socket = context.wrap_socket(server.socket, server_side=True)
    print(f"BackOps peer service listening on https://{cfg['listen']}:{cfg['port']}", flush=True)
    server.serve_forever()


@contextlib.contextmanager
def sync_lock() -> Any:
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w") as handle:
        try: fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc: raise PeerError("another replication run is already active") from exc
        yield


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="Offline BackOps appliance replication")
    result.add_argument("--version", action="version", version=VERSION)
    sub = result.add_subparsers(dest="command", required=True)
    sub.add_parser("init"); sub.add_parser("serve"); sub.add_parser("status"); sub.add_parser("admin-token")
    code = sub.add_parser("pairing-code"); code.add_argument("--minutes", type=int, default=15)
    discover = sub.add_parser("discover"); discover.add_argument("host"); discover.add_argument("--port", type=int, default=9443)
    add = sub.add_parser("peer-add"); add.add_argument("host"); add.add_argument("--port", type=int, default=9443); add.add_argument("--code", required=True); add.add_argument("--fingerprint"); add.add_argument("--yes", action="store_true")
    remove_peer = sub.add_parser("peer-remove"); remove_peer.add_argument("peer_id")
    remove_source = sub.add_parser("source-remove"); remove_source.add_argument("source_id")
    forget = sub.add_parser("received-forget"); forget.add_argument("asset")
    rule = sub.add_parser("asset-configure"); rule.add_argument("asset"); rule.add_argument("--peer", required=True); rule.add_argument("--interval", type=int, default=60)
    rep = sub.add_parser("replicate"); rep.add_argument("asset"); rep.add_argument("--peer", required=True); rep.add_argument("--snapshot")
    sync = sub.add_parser("sync"); sync.add_argument("--all", action="store_true", required=True)
    entry = sub.add_parser("ssh-entry"); entry.add_argument("source_id")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "init": init()
        elif args.command == "serve": serve()
        elif args.command == "status": print(json.dumps(status_document(), indent=2))
        elif args.command == "admin-token": require_root(); print(ADMIN_TOKEN_PATH.read_text(encoding="ascii").strip())
        elif args.command == "pairing-code": print(pairing_code(args.minutes)); print(f"TLS fingerprint: {local_tls_fingerprint()}")
        elif args.command == "discover":
            info, observed = ssl_json(args.host, args.port, "/v1/info"); print(json.dumps(info | {"observed_fingerprint": observed}, indent=2))
        elif args.command == "peer-add":
            info, observed = ssl_json(args.host, args.port, "/v1/info"); fingerprint = args.fingerprint or observed
            if not args.fingerprint and not args.yes:
                print(f"Target: {info.get('name')} ({info.get('appliance_id')})\nTLS fingerprint: {observed}")
                if input("Does this match the fingerprint shown on the target? [y/N] ").lower() != "y": raise PeerError("pairing cancelled")
            print(json.dumps(peer_add(args.host, args.port, args.code, fingerprint, info), indent=2))
        elif args.command == "asset-configure": print(json.dumps(configure_asset(args.asset, args.peer, args.interval), indent=2))
        elif args.command == "peer-remove": peer_remove(args.peer_id); print("target removed")
        elif args.command == "source-remove": source_remove(args.source_id); print("source removed")
        elif args.command == "received-forget": received_forget(args.asset); print("received provenance removed")
        elif args.command == "replicate":
            with sync_lock(): print(json.dumps(replicate(args.asset, args.peer, args.snapshot), indent=2))
        elif args.command == "sync":
            with sync_lock(): print(json.dumps({"results": configured_sync()}, indent=2))
        elif args.command == "ssh-entry": ssh_entry(args.source_id)
        return 0
    except Exception as exc:
        if args.command == "ssh-entry": print(json.dumps({"ok": False, "error": str(exc)}, separators=(",", ":")))
        else: print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
