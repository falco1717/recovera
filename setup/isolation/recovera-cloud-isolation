#!/usr/bin/python3
"""Disable the retained application's legacy cloud control plane safely."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from typing import Iterable

SHARE = Path(os.environ.get("RECOVERA_ISOLATION_SHARE", "/usr/local/share/recovera/isolation"))
ETC = Path(os.environ.get("RECOVERA_ISOLATION_ETC", "/etc"))
STATE = Path(os.environ.get("RECOVERA_ISOLATION_STATE", "/var/lib/recovera/cloud-isolation.json"))
BEGIN = "# BEGIN RECOVERA CLOUD ISOLATION"
END = "# END RECOVERA CLOUD ISOLATION"
DROPIN = """[Service]\nIPAddressDeny=any\nRestrictAddressFamilies=AF_UNIX\n"""
DATTO_TIMESYNCD = Path("systemd/timesyncd.conf.d/01-datto-timesyncd.conf")
RECOVERA_TIMESYNCD = Path("systemd/timesyncd.conf.d/20-recovera-timesyncd.conf")
RECOVERA_TIME_SERVERS = "time.cloudflare.com ntp.ubuntu.com"
RECOVERA_FALLBACK_TIME_SERVERS = "0.pool.ntp.org 1.pool.ntp.org"


def records(path: Path) -> list[str]:
    return [line.strip() for line in path.read_text().splitlines()
            if line.strip() and not line.lstrip().startswith("#")]


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, check=check, text=True, capture_output=True)


def replace_managed_block(path: Path, lines: Iterable[str]) -> None:
    original = path.read_text() if path.exists() else ""
    pattern = re.compile(rf"(?ms)^\s*{re.escape(BEGIN)}\n.*?^\s*{re.escape(END)}\n?")
    clean = pattern.sub("", original).rstrip()
    block = "\n".join([BEGIN, *lines, END])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text((clean + "\n\n" if clean else "") + block + "\n")


def disable_legacy_sources() -> list[str]:
    changed: list[str] = []
    source_dir = ETC / "apt/sources.list.d"
    if not source_dir.exists():
        return changed
    endpoint = re.compile(r"(?:datto(?:backup)?\.com|dattobackup)", re.I)
    for path in sorted(source_dir.glob("*.list")):
        lines = path.read_text().splitlines()
        output = []
        dirty = False
        for line in lines:
            if not line.lstrip().startswith("#") and endpoint.search(line):
                output.append("# Recovera-disabled: " + line)
                dirty = True
            else:
                output.append(line)
        if dirty:
            path.write_text("\n".join(output) + "\n")
            changed.append(str(path))
    for path in sorted(source_dir.glob("*.sources")):
        if endpoint.search(path.read_text()):
            disabled = path.with_suffix(path.suffix + ".recovera-disabled")
            path.replace(disabled)
            changed.append(str(disabled))
    return changed


def configure_time_sync() -> dict[str, object]:
    """Replace the retained vendor NTP endpoint with neutral public sources."""
    old_path = ETC / DATTO_TIMESYNCD
    new_path = ETC / RECOVERA_TIMESYNCD
    removed = old_path.exists()
    old_path.unlink(missing_ok=True)
    new_path.parent.mkdir(parents=True, exist_ok=True)
    new_path.write_text(
        "[Time]\n"
        f"NTP={RECOVERA_TIME_SERVERS}\n"
        f"FallbackNTP={RECOVERA_FALLBACK_TIME_SERVERS}\n"
    )
    return {"removed_legacy_ntp_config": removed, "config": str(new_path)}


def unit_state(unit: str) -> dict[str, object]:
    enabled = run("systemctl", "is-enabled", unit, check=False)
    active = run("systemctl", "is-active", unit, check=False)
    return {
        "unit": unit,
        "masked": enabled.stdout.strip() == "masked",
        "inactive": active.stdout.strip() in {"inactive", "failed", "unknown"},
        "enabled_state": enabled.stdout.strip() or enabled.stderr.strip(),
        "active_state": active.stdout.strip() or active.stderr.strip(),
    }


def which(command: str) -> str | None:
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(directory) / command
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def apply(enforce_only: bool = False) -> dict[str, object]:
    if os.geteuid() != 0:
        raise PermissionError("recovera-cloud-isolation must run as root")
    units = records(SHARE / "cloud-units.txt")
    hosts = records(SHARE / "cloud-hosts.txt")
    replace_managed_block(ETC / "hosts", [f"0.0.0.0 {host}" for host in hosts])
    nm = ETC / "NetworkManager/conf.d/20-recovera-cloud-isolation.conf"
    nm.parent.mkdir(parents=True, exist_ok=True)
    nm.write_text("[connectivity]\nenabled=false\n")
    changed_sources = [] if enforce_only else disable_legacy_sources()
    time_sync = configure_time_sync()
    if not enforce_only:
        for unit in units:
            if unit.endswith(".service"):
                dropin = ETC / "systemd/system" / f"{unit}.d/90-recovera-cloud-isolation.conf"
                dropin.parent.mkdir(parents=True, exist_ok=True)
                dropin.write_text(DROPIN)
    run("systemctl", "daemon-reload")
    for unit in units:
        run("systemctl", "disable", "--now", unit, check=False)
        run("systemctl", "mask", unit, check=False)
    if not enforce_only and which("nmcli"):
        run("nmcli", "general", "reload", check=False)
    run("systemctl", "try-restart", "systemd-timesyncd.service", check=False)
    report = verify()
    report["legacy_sources_changed"] = changed_sources
    report["time_sync"] = time_sync
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    STATE.chmod(0o600)
    return report


def verify() -> dict[str, object]:
    units = records(SHARE / "cloud-units.txt")
    hosts = records(SHARE / "cloud-hosts.txt")
    states = [unit_state(unit) for unit in units]
    hosts_text = (ETC / "hosts").read_text() if (ETC / "hosts").exists() else ""
    missing_hosts = [host for host in hosts if not re.search(
        rf"(?m)^0\.0\.0\.0\s+{re.escape(host)}(?:\s|$)", hosts_text)]
    nm = ETC / "NetworkManager/conf.d/20-recovera-cloud-isolation.conf"
    nm_disabled = nm.exists() and "enabled=false" in nm.read_text().replace(" ", "")
    old_time = ETC / DATTO_TIMESYNCD
    new_time = ETC / RECOVERA_TIMESYNCD
    time_text = new_time.read_text() if new_time.exists() else ""
    time_sync_ok = (
        not old_time.exists()
        and f"NTP={RECOVERA_TIME_SERVERS}" in time_text
        and f"FallbackNTP={RECOVERA_FALLBACK_TIME_SERVERS}" in time_text
        and "dattobackup.com" not in time_text.lower()
    )
    active_sources: list[str] = []
    source_dir = ETC / "apt/sources.list.d"
    endpoint = re.compile(r"(?:datto(?:backup)?\.com|dattobackup)", re.I)
    if source_dir.exists():
        for path in [*source_dir.glob("*.list"), *source_dir.glob("*.sources")]:
            for line in path.read_text().splitlines():
                if not line.lstrip().startswith("#") and endpoint.search(line):
                    active_sources.append(f"{path}:{line.strip()}")
    failures = [str(s["unit"]) for s in states if not s["masked"] or not s["inactive"]]
    ok = not failures and not missing_hosts and nm_disabled and not active_sources and time_sync_ok
    return {
        "ok": ok,
        "failed_units": failures,
        "missing_hosts": missing_hosts,
        "networkmanager_connectivity_disabled": nm_disabled,
        "neutral_time_sync_configured": time_sync_ok,
        "active_legacy_sources": active_sources,
        "units": states,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("apply", "enforce", "verify", "status"))
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    if args.command == "status" and STATE.exists():
        result = json.loads(STATE.read_text())
    elif args.command == "apply":
        result = apply(False)
    elif args.command == "enforce":
        result = apply(True)
    else:
        result = verify()
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print("Recovera legacy cloud isolation: " + ("PASS" if result.get("ok") else "FAIL"))
        for key in ("failed_units", "missing_hosts", "active_legacy_sources"):
            if result.get(key):
                print(f"  {key}: {', '.join(result[key])}")
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        print(f"recovera-cloud-isolation: {exc}", file=sys.stderr)
        raise SystemExit(1)
